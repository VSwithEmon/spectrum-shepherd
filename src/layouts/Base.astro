---
import '../styles/global.css';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import DesignToggle from '../components/DesignToggle.astro';

interface Props {
  title: string;
  /** Social preview image (absolute URL), e.g. a blog post's cover. */
  image?: string;
  description?: string;
  /** Where the nav's "Book a demo" goes. */
  demoHref?: string;
  /** Hill edge above the footer, and the background behind it (match the last section). */
  footerHills?: boolean;
  footerHillsBg?: string;
  /** Alternative palette: 'lavender' swaps the yellow accents for lavender (Figma Homepage V2). */
  palette?: 'lavender';
  /** Floating V1/V2 switch for comparing the two homepage directions. */
  designToggle?: 'v1' | 'v2' | 'v3';
}
const {
  title,
  image,
  description = 'Spectrum Shepherd is an AI life-skills coach for neurodiverse students aged 14–22, with IEP-ready progress reports for their teachers.',
  demoHref,
  footerHills = true,
  footerHillsBg = '',
  palette,
  designToggle,
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {image && <meta property="og:image" content={image} />}
    {image && <meta name="twitter:card" content="summary_large_image" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body data-palette={palette}>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-lg focus:bg-white focus:px-4 focus:py-3 focus:font-semibold focus:shadow-lg">Skip to main content</a>
    <SiteNav demoHref={demoHref} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter hills={footerHills} hillsBg={footerHillsBg} />
    {designToggle && <DesignToggle active={designToggle} />}
  </body>
</html>
