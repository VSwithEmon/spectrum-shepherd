---
import '../styles/global.css';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { pagesV1 } from '../data/site';

interface Props {
  title: string;
  description?: string;
  /** Where the nav's "Book a demo" goes. */
  demoHref?: string;
  /** Hill edge above the footer, and the background behind it (match the last section). */
  footerHills?: boolean;
  footerHillsBg?: string;
  /** The nav from the Oct 26, 2026 client feedback (Figma "Site / Nav v2"); the default on every page. false = the earlier nav. */
  navUpdated?: boolean;
  /** Standalone page: no nav or footer (the log-in card). */
  bare?: boolean;
}
const {
  title,
  description = 'Spectrum Shepherd is an AI life-skills coach for neurodiverse students aged 14–22, with IEP-ready progress reports for their teachers.',
  demoHref,
  footerHills = true,
  footerHillsBg = '',
  bare = false,
  navUpdated = true,
} = Astro.props;
const pages = pagesV1;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-lg focus:bg-white focus:px-4 focus:py-3 focus:font-semibold focus:shadow-lg">Skip to main content</a>
    {!bare && <SiteNav demoHref={demoHref} pages={pages} v3={navUpdated} />}
    <main id="main">
      <slot />
    </main>
    {!bare && <SiteFooter hills={footerHills} hillsBg={footerHillsBg} pages={pages} />}
  </body>
</html>
