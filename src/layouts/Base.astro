---
import '../styles/global.css';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import DesignToggle from '../components/DesignToggle.astro';

interface Props {
  title: string;
  description?: string;
  /** Where the nav's "Book a demo" goes. */
  demoHref?: string;
  /** Hill edge above the footer, and the background behind it (match the last section). */
  footerHills?: boolean;
  footerHillsBg?: string;
  /** Show the design switch (homepage review only). */
  designToggle?: 'v1' | 'v2' | 'v3' | 'v4';
  /** 'calm' = green-first palette with yellow only as small accents (enables `calm:` utilities).
   *  'lavender' = lavender replaces yellow as the accent (enables `lavender:` utilities). */
  palette?: 'calm' | 'lavender';
  /** Oct 2026 feedback refresh for the nav and footer (V3/V4). */
  refresh?: boolean;
}
const {
  title,
  description = 'Spectrum Shepherd is an AI life-skills coach for neurodiverse students aged 14–22, with IEP-ready progress reports for their teachers.',
  demoHref,
  footerHills = true,
  footerHillsBg = '',
  designToggle,
  palette,
  refresh = false,
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body data-palette={palette}>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-lg focus:bg-white focus:px-4 focus:py-3 focus:font-semibold focus:shadow-lg">Skip to main content</a>
    <SiteNav demoHref={demoHref} refresh={refresh} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter hills={footerHills} hillsBg={footerHillsBg} refresh={refresh} />
    {/* Room for the fixed design switch so it never covers the footer's legal links on phones. */}
    {designToggle && <div aria-hidden="true" class="h-20 bg-brand-800 md:hidden"></div>}
    {designToggle && <DesignToggle active={designToggle} />}
  </body>
</html>
