---
import '../styles/global.css';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import DesignToggle from '../components/DesignToggle.astro';
import { pagesFor } from '../data/site';

interface Props {
  title: string;
  description?: string;
  /** Where the nav's "Book a demo" goes. */
  demoHref?: string;
  /** Hill edge above the footer, and the background behind it (match the last section). */
  footerHills?: boolean;
  footerHillsBg?: string;
  /** Show the design switch (homepage review only). */
  designToggle?: 'v1' | 'v2';
  /** 'lavender' = lavender replaces yellow as the accent (enables `lavender:` utilities) and the nav,
   *  footer and logo link the v2 pages (V2 set). Without it everything links the v1 pages (V1 set). */
  palette?: 'lavender';
  /** Standalone page: no nav or footer (the log-in card). */
  bare?: boolean;
}
const {
  title,
  description = 'Spectrum Shepherd is an AI life-skills coach for neurodiverse students aged 14–22, with IEP-ready progress reports for their teachers.',
  demoHref,
  footerHills = true,
  footerHillsBg = '',
  designToggle,
  palette,
  bare = false,
} = Astro.props;
const pages = pagesFor(palette);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body data-palette={palette}>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-lg focus:bg-white focus:px-4 focus:py-3 focus:font-semibold focus:shadow-lg">Skip to main content</a>
    {!bare && <SiteNav demoHref={demoHref} pages={pages} />}
    <main id="main">
      <slot />
    </main>
    {!bare && <SiteFooter hills={footerHills} hillsBg={footerHillsBg} pages={pages} />}
    {/* Room for the fixed design switch so it never covers the footer's legal links on phones. */}
    {designToggle && <div aria-hidden="true" class="h-20 bg-brand-800 md:hidden"></div>}
    {designToggle && <DesignToggle active={designToggle} />}
  </body>
</html>
