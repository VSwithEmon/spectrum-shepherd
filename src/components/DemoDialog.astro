---
// "Book a Demo" pop-up, available on every page (rendered once in Base). Any link or button with
// `data-demo` opens it; without JavaScript those links go to /book-a-demo instead.
// With site.bookingUrl set it shows the calendar (direct booking); otherwise a short request form.
// Native <dialog>: focus moves inside, Esc closes, focus returns to the button that opened it.
import Button from './Button.astro';
import FormField from './FormField.astro';
import { site } from '../data/site';

const steps = ['Tell us about your school', "We'll find a time that works", 'See the platform and ask questions'];
---
<dialog id="demo-dialog" aria-labelledby="demo-dialog-title" class="demo-dialog m-auto w-[min(640px,calc(100vw-24px))] max-h-[calc(100dvh-24px)] overflow-y-auto rounded-[28px] bg-white p-0 text-ink shadow-2xl backdrop:bg-ink/60 sm:rounded-[32px]">
  <div class="flex flex-col gap-6 p-5 sm:p-8">
    <div class="flex items-start justify-between gap-4">
      <div class="flex flex-col gap-1.5">
        <h2 id="demo-dialog-title" class="text-display-xs font-bold sm:text-display-sm">Book a demo</h2>
        <p class="text-muted">See how Shepherd works for your students, teachers and school.</p>
      </div>
      <button type="button" data-demo-close class="flex size-11 shrink-0 cursor-pointer items-center justify-center rounded-full bg-brand-25 text-brand-800 hover:bg-brand-50" aria-label="Close">
        <svg aria-hidden="true" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </button>
    </div>

    {site.bookingUrl ? (
      <iframe src={site.bookingUrl} title="Choose a time for your demo" loading="lazy" class="h-[640px] w-full rounded-2xl border border-line"></iframe>
    ) : (
      <>
        <ol class="grid gap-2 sm:grid-cols-3" aria-label="How it works">
          {steps.map((s, i) => (
            <li class="flex items-center gap-2.5 rounded-2xl bg-brand-25 px-3 py-2.5 text-sm font-semibold">
              <span aria-hidden="true" class="flex size-7 shrink-0 items-center justify-center rounded-full bg-yellow-300 text-sm font-bold">{i + 1}</span>
              {s}
            </li>
          ))}
        </ol>
        <!-- TODO: replace with the client's booking link (site.bookingUrl) or point action at their form service. -->
        <form method="post" action={site.demoPage} class="flex flex-col gap-4" aria-describedby="demo-dialog-note">
          <FormField id="demo-name" label="Your name" autocomplete="name" required />
          <FormField id="demo-email" label="Work email" type="email" placeholder="you@school.org" autocomplete="email" required />
          <FormField id="demo-org" label="School or district" autocomplete="organization" required />
          <Button type="submit" full>Book a Demo</Button>
          <p id="demo-dialog-note" class="text-sm text-muted">We'll reply to find a time that works. See our <a href="/privacy" class="text-brand-700 underline hover:text-brand-800">privacy policy</a>.</p>
        </form>
      </>
    )}
  </div>
</dialog>


<script>
  const dialog = document.getElementById('demo-dialog') as HTMLDialogElement | null;
  let opener: HTMLElement | null = null;
  document.addEventListener('click', (e) => {
    const trigger = (e.target as HTMLElement).closest<HTMLElement>('[data-demo]');
    if (trigger && dialog?.showModal) {
      e.preventDefault();
      opener = trigger;
      dialog.showModal();
    }
  });
  dialog?.querySelector('[data-demo-close]')?.addEventListener('click', () => dialog.close());
  // Click on the dimmed backdrop closes it.
  dialog?.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
  dialog?.addEventListener('close', () => opener?.focus());
</script>
