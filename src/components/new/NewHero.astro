---
// New direction hero: centered message, then a "sunrise doorway" stage — a green arch
// framing the real product, a rising sun behind, and a dotted trail arcing over it.
// The arch's green continues into the next section.
import Button from '../Button.astro';
import PhotoPlaceholder from '../PhotoPlaceholder.astro';
import StatusChip from '../StatusChip.astro';
import DottedRing from './DottedRing.astro';
---
<section class="relative overflow-hidden bg-linear-to-b from-cream to-yellow-100" aria-labelledby="hero-title">
  <div class="mx-auto flex max-w-[860px] flex-col items-center gap-6 px-4 pt-10 text-center md:px-8 lg:pt-16">
    <p class="flex items-center gap-1.5 rounded-full bg-white px-4 py-1.5 text-sm font-semibold text-brand-800 shadow-md">
      <img src="/images/icons/dot.svg" width="8" height="8" alt="" />
      AI life-skills coach · Ages 14–22
    </p>
    <h1 id="hero-title" class="text-display-md font-bold sm:text-display-lg lg:text-display-xl">
      Real-world skills.<br />
      <span class="relative inline-block text-brand-600">
        Real independence.
        <svg aria-hidden="true" viewBox="0 0 400 20" preserveAspectRatio="none" class="absolute -bottom-2 left-0 h-3 w-full">
          <path d="M4 12C100 4 300 4 396 12" fill="none" class="stroke-yellow-400" stroke-width="5" stroke-linecap="round" stroke-dasharray="0 14" vector-effect="non-scaling-stroke" />
        </svg>
      </span>
    </h1>
    <p class="max-w-[640px] text-lg text-muted sm:text-xl">
      Short, personalized lessons students actually want to do — and IEP-ready progress reports their teachers don't have to write.
    </p>
    <div class="flex flex-wrap justify-center gap-3">
      <Button href="/book-a-demo">Book a demo</Button>
      <Button href="#" variant="secondary">Start free 45-day trial</Button>
    </div>
    <p class="text-sm font-medium text-muted">45 days free · No credit card · No district approval needed</p>
  </div>

  <!-- Stage: all positions are % of a 1100×560 composition -->
  <div class="relative mx-auto mt-10 aspect-[1100/560] w-full max-w-[1100px] px-4 md:px-8 xl:px-0">
    <div class="relative size-full">
      <div aria-hidden="true" class="absolute top-0 left-[26.4%] aspect-square w-[47.3%] rounded-full bg-yellow-300"></div>
      <svg aria-hidden="true" viewBox="0 0 1100 560" class="absolute inset-0 size-full">
        <path class="trail stroke-brand-500" d="M40 560C110 330 260 140 550 66S990 220 1068 560" fill="none" stroke-width="6" stroke-linecap="round" />
      </svg>

      <div class="arch absolute top-[21.4%] bottom-0 left-[15.5%] w-[69%] overflow-hidden bg-brand-700">
        <div class="absolute top-[20%] left-[8%] w-[84%] overflow-hidden rounded-t-2xl border-4 border-b-0 border-white/90 bg-white shadow-2xl">
          <img
            src="/images/teacher-dashboard.png"
            width="1440"
            height="1244"
            alt="Shepherd teacher dashboard for William School, showing Classroom Pulse stats and the classroom roster"
            class="w-full"
            fetchpriority="high"
          />
        </div>
      </div>

      <div class="absolute top-[34%] left-[76%] w-[15.6%] rounded-4xl bg-brand-950 p-[0.6%] shadow-2xl">
        <img
          src="/images/student-app-home.png"
          width="750"
          height="1624"
          alt="Shepherd student app home screen with a message from the coach and options to browse lessons or play games"
          class="w-full rounded-3xl"
        />
      </div>

      <div class="absolute top-[12%] left-[1%] aspect-square w-[19%]">
        <PhotoPlaceholder label="[PHOTO — real student, 16–20, smiling]" tone="orange" size="p-2 text-[10px] sm:p-5 sm:text-sm" class="size-full rounded-full" />
        <DottedRing class="-inset-[9%] size-[118%]" spin />
      </div>

      <StatusChip title="Lesson complete" caption="Budgeting for a concert ticket" class="top-[66%] left-0 hidden sm:flex" />
      <StatusChip title="Progress note saved" caption="Linked to IEP goal" class="top-[6%] right-0 hidden sm:flex" />
    </div>
  </div>
</section>

<style>
  .arch {
    border-top-left-radius: 50% 86%;
    border-top-right-radius: 50% 86%;
  }
  .trail {
    stroke-dasharray: 0 18;
    animation: trail-march 1.8s linear infinite;
  }
  @keyframes trail-march { to { stroke-dashoffset: -18; } }
</style>
