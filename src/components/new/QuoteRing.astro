---
import PhotoPlaceholder from '../PhotoPlaceholder.astro';
import DottedRing from './DottedRing.astro';
---
<section class="px-4 py-16 md:px-8 lg:py-24" aria-labelledby="quote-title">
  <h2 id="quote-title" class="sr-only">What educators say</h2>
  <figure class="mx-auto flex max-w-[860px] flex-col items-center gap-8 text-center">
    <div class="relative size-40">
      <PhotoPlaceholder label="[PHOTO — Dr. Lori Lopez-Lopez]" tone="brand" size="p-4 text-xs" class="size-full rounded-full" />
      <DottedRing class="-inset-[14%] size-[128%]" spin />
    </div>
    <blockquote class="flex flex-col gap-5">
      <p class="text-display-xs font-bold sm:text-display-sm lg:text-display-md">“I see the value both as a teacher and as an administrator.”</p>
      <p class="text-lg text-muted">As a teacher, it gives us a highly effective tool for explicit functional and social skills instruction. As an administrator, it lets us monitor progress that's typically far too subjective.</p>
    </blockquote>
    <figcaption class="flex flex-col">
      <span class="text-lg font-bold">Dr. Lori Lopez-Lopez</span>
      <span class="text-muted">Teacher and Administrator, Special Education</span>
    </figcaption>
  </figure>
</section>
