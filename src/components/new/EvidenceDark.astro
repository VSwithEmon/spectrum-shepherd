---
import CheckItem from '../CheckItem.astro';
import ReportMock from '../ReportMock.astro';
---
<section class="on-dark overflow-hidden bg-brand-950 px-4 py-16 text-white md:px-8 lg:py-24" aria-labelledby="evidence-title">
  <div class="mx-auto flex max-w-[1200px] flex-col items-center gap-14 lg:flex-row lg:gap-20">
    <div class="relative flex w-full max-w-[540px] justify-center lg:shrink-0">
      <span aria-hidden="true" class="absolute -top-10 -right-6 size-48 rounded-full bg-yellow-300"></span>
      <span aria-hidden="true" class="absolute -bottom-8 -left-6 size-32 rounded-full bg-brand-700"></span>
      <div class="relative w-full text-ink lg:-rotate-2"><ReportMock /></div>
    </div>
    <div class="flex flex-col items-start gap-6 lg:flex-1">
      <p class="text-sm font-bold text-yellow-300">A NEW STANDARD FOR SPECIAL EDUCATORS</p>
      <h2 id="evidence-title" class="text-display-sm font-bold md:text-display-md lg:text-display-lg">Bridge the gap between compliance and independence.</h2>
      <p class="text-lg text-brand-50">Shepherd turns daily practice into professional evidence — so students build confidence earlier, and you get your time back.</p>
      <ul class="flex flex-col gap-3">
        <CheckItem>Progress tracked against every IEP goal</CheckItem>
        <CheckItem>Indicator 13 evidence, built automatically</CheckItem>
        <CheckItem>Reports ready for your next IEP meeting</CheckItem>
      </ul>
      <a href="#" class="text-lg font-bold text-yellow-300 underline hover:text-white">Learn more for schools →</a>
    </div>
  </div>
</section>
