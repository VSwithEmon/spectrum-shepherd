---
// Dotted ring echoing the dotted shepherd logo. Decorative; size it via class.
interface Props {
  class?: string;
  color?: string;
  spin?: boolean;
}
const { class: className = '', color = 'stroke-brand-500', spin = false } = Astro.props;
---
<svg aria-hidden="true" viewBox="0 0 100 100" class={`pointer-events-none absolute ${spin ? 'ring-spin' : ''} ${className}`}>
  <circle cx="50" cy="50" r="47" fill="none" class={color} stroke-width="3" stroke-linecap="round" stroke-dasharray="0 7.4" />
</svg>

<style>
  .ring-spin { animation: ring-spin 40s linear infinite; }
  @keyframes ring-spin { to { transform: rotate(360deg); } }
</style>
