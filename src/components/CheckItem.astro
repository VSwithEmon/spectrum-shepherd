---
// "LP / Check Item" — use inside a <ul>. Line check icon from the website icon family (Oct 28, 2026).
import BrandIcon from './v3/BrandIcon.astro';
interface Props { class?: string; v2?: boolean }
const { class: className = '' } = Astro.props;
---
<li class={`flex items-start gap-3 font-medium ${className}`}>
  <BrandIcon name="check" class="mt-0.5 size-6" />
  <span><slot /></span>
</li>
