---
// "Logo Band" in Homepage Design (v2): a compact strip under the hero. Each school is a small
// round logo pin above its name (same pins as the current homepage's route band, scaled down).
// Round seals fill the pin; wide wordmarks get extra `pad`. White logos need a dark pin (`bg`).
const schools = [
  { name: 'Burr & Burton Academy', logo: '/images/logos/burr-burton.png', pad: 'p-1', bg: 'bg-brand-800' },
  { name: 'Cotting School', logo: '/images/logos/cotting-school.png' },
  { name: 'North Hunterdon', logo: '/images/logos/north-hunterdon.png', pad: 'p-1' },
  { name: 'Kinnelon Schools', logo: '/images/logos/kinnelon.png' },
  { name: 'Voorhees HS', logo: '/images/logos/voorhees.png', pad: 'p-1' },
  { name: 'Newmark Education', logo: '/images/logos/newmark.png', pad: 'p-1' },
];
---
<section class="on-dark flex flex-col items-center gap-5 bg-brand-700 px-4 pt-2 pb-8 text-white md:px-8" aria-label="Schools that helped shape Shepherd">
  <p class="text-center font-semibold">Built with educators. Tested with students. Shaped in classrooms.</p>
  <ul class="flex max-w-[1200px] flex-wrap items-start justify-center gap-x-12 gap-y-5 font-bold text-brand-50">
    {schools.map((s, i) => (
      <li class="flex flex-col items-center gap-2 text-center">
        <img
          src={s.logo}
          width="256"
          height="256"
          loading="lazy"
          alt=""
          class={`size-11 rounded-full object-contain shadow-lg ring-[3px] ${s.bg ?? 'bg-white'} ${s.pad ?? 'p-0.5'} ${i % 2 ? 'ring-orange-400' : 'ring-yellow-300 calm:ring-brand-200'}`}
        />
        {s.name}
      </li>
    ))}
  </ul>
</section>
