---
const stats = [
  { value: '91%', caption: 'parent demand confirmed' },
  { value: '8 of 8', caption: 'pilot schools became customers' },
  { value: '77%', caption: "of students say it's more engaging than other school learning" },
];
---
<section class="px-4 pt-16 pb-14 md:px-8 lg:pt-24 lg:pb-20" aria-labelledby="proof-title">
  <div class="mx-auto flex max-w-[1200px] flex-col gap-8">
    <h2 id="proof-title" class="text-sm font-bold text-brand-700">RESULTS FROM OUR SPRING 2026 BETA</h2>
    <dl class="grid gap-10 md:grid-cols-3">
      {stats.map((s) => (
        <div class="flex flex-col gap-3">
          <dt class="text-lg text-muted">{s.caption}</dt>
          <dd class="order-first text-display-xl font-bold text-brand-600 lg:text-display-2xl">{s.value}</dd>
        </div>
      ))}
    </dl>
    <p class="text-sm text-muted">8 schools · 50 learners · public, private and specialty programs in NJ, MA, VT and NYC</p>
  </div>
</section>
