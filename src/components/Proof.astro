---
// "Proof bento" (Figma: Results, node 38613:4462). Dot graphics mirror the numbers
// exactly (8 of 8, 77 of 100) and are decorative; the values are in the text.
import DottedRing from './DottedRing.astro';

const states = ['NJ', 'MA', 'VT', 'NYC'];
const tag = 'self-start rounded-full px-3 py-1 text-xs font-bold';
---
<section class="bg-white px-4 py-16 md:px-8 lg:py-24" aria-labelledby="proof-title">
  <div class="mx-auto flex max-w-[1200px] flex-col gap-10">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div class="flex flex-col gap-3">
        <p class="text-sm font-bold text-brand-700">SPRING 2026 BETA</p>
        <h2 id="proof-title" class="text-display-sm font-bold md:text-display-md lg:text-display-lg">What our first schools saw</h2>
      </div>
      <div class="flex flex-col gap-2 md:items-end">
        <p class="text-sm font-medium text-muted">Public, private and specialty programs in</p>
        <ul class="flex flex-wrap gap-2" aria-label="States">
          {states.map((s) => <li class="rounded-full border border-line bg-cream px-4 py-1.5 text-sm font-bold">{s}</li>)}
        </ul>
      </div>
    </div>

    <ul class="grid gap-4 md:grid-cols-2 lg:grid-cols-[384fr_384fr_400fr] lg:grid-rows-[272px_272px]">
      <!-- 91% — tall yellow card -->
      <li class="relative flex min-h-[340px] flex-col justify-between overflow-hidden rounded-[32px] bg-yellow-300 p-8 md:row-span-2 lg:min-h-0 calm:bg-brand-100">
        <span aria-hidden="true" class="absolute -top-[90px] -right-[76px] size-[260px] rounded-full bg-orange-400/90"></span>
        <DottedRing class="-top-[130px] -right-[116px] size-[340px] opacity-50" color="stroke-yellow-800 calm:stroke-brand-700" />
        <span class={`relative bg-white text-yellow-800 calm:text-brand-700 ${tag}`}>PARENTS</span>
        <p class="relative flex flex-col gap-2">
          <span class="text-display-xl font-bold lg:text-display-2xl">91%</span>
          <span class="text-display-xs font-bold">parent demand confirmed</span>
        </p>
      </li>

      <!-- Real classroom photo -->
      <li class="relative min-h-[260px] overflow-hidden rounded-[32px] bg-brand-50 lg:min-h-0">
        <img
          src="/images/photos/audience-teachers.jpg"
          width="1100"
          height="733"
          loading="lazy"
          alt="A teacher and students working together on laptops in a classroom"
          class="absolute inset-0 size-full object-cover"
        />
        <span class="absolute bottom-5 left-5 flex items-center gap-2 rounded-full bg-white px-4 py-2 text-sm font-bold shadow-lg">
          <span aria-hidden="true" class="size-2 rounded-full bg-brand-600"></span>
          8 schools · 50 learners
        </span>
      </li>

      <!-- 8 of 8 — green card with eight filled dots -->
      <li class="on-dark flex min-h-[260px] flex-col justify-between gap-8 overflow-hidden rounded-[32px] bg-brand-700 p-8 text-white lg:min-h-0">
        <div class="flex flex-wrap items-center justify-between gap-4">
          <span class={`bg-brand-800 text-yellow-300 calm:text-brand-100 ${tag}`}>SCHOOLS</span>
          <span aria-hidden="true" class="flex gap-2">
            {Array.from({ length: 8 }).map(() => <span class="size-5 rounded-full bg-yellow-300"></span>)}
          </span>
        </div>
        <p class="flex flex-col gap-1">
          <span class="text-display-lg font-bold lg:text-display-xl">8 of 8</span>
          <span class="text-lg font-semibold text-brand-50">pilot schools became customers</span>
        </p>
      </li>

      <!-- 77% — wide peach card with a 10×10 grid, 77 filled -->
      <li class="flex flex-col gap-8 overflow-hidden rounded-[32px] bg-orange-100 p-8 md:col-span-2 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex flex-col gap-6">
          <span class={`bg-white text-orange-800 ${tag}`}>STUDENTS</span>
          <p class="flex max-w-[400px] flex-col gap-2">
            <span class="text-display-xl font-bold lg:text-display-2xl">77%</span>
            <span class="text-lg font-semibold">of students say it's more engaging than other school learning</span>
          </p>
        </div>
        <span aria-hidden="true" class="grid shrink-0 grid-cols-10 gap-1.5 self-start sm:gap-2 sm:self-center">
          {Array.from({ length: 100 }).map((_, i) => (
            <span class={`size-2.5 rounded-full sm:size-3.5 ${i < 77 ? 'bg-orange-400' : 'bg-orange-200'}`}></span>
          ))}
        </span>
      </li>
    </ul>
  </div>
</section>
