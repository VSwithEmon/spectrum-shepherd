---
// Audience carousel. Desktop: the section pins while vertical scrolling slides the cards
// sideways. Small screens and reduced motion: a native swipeable row. Pill tabs above
// show the active card and jump to any card.
import AudienceCard from './AudienceCard.astro';

const slides = [
  {
    id: 'audience-schools', tab: 'For schools', tone: 'brand' as const,
    eyebrow: 'FOR SCHOOLS',
    headline: ['Lead with evidence.', 'Meet compliance.', 'Scale with confidence.'],
    benefits: ['Transition Evidence Reports', 'Indicator 13 support', 'IDEA Part B & Title IV-A ready', 'Consistent across classrooms'],
    cta: { label: 'Explore for schools →', href: '#' },
    photo: '[PHOTO — real special education leader with students]',
    image: { src: '/images/photos/audience-schools.jpg', alt: 'A special education teacher reviewing a lesson on a tablet with two students' },
    stat: { value: 'Indicator 13', caption: 'evidence, built automatically' },
  },
  {
    id: 'audience-teachers', tab: 'For teachers', tone: 'yellow' as const,
    eyebrow: 'FOR TEACHERS',
    headline: ['Save planning time.', 'Personalize every lesson.', 'Skip the paperwork.'],
    benefits: ['Ready-made life-skills lessons', 'IEP-linked progress notes', 'Students work independently', 'Free 45-day trial'],
    cta: { label: 'Start your free trial →', href: '#' },
    photo: '[PHOTO — real teacher working with a small group]',
    image: { src: '/images/photos/audience-teachers.jpg', alt: 'A teacher working with a small group of students on laptops' },
    stat: { value: '10 min', caption: 'to a personalized class' },
  },
  {
    id: 'audience-students', tab: 'For students', tone: 'orange' as const,
    eyebrow: 'FOR STUDENTS',
    headline: ['Learn what matters.', 'Practice what they love.', 'Grow real independence.'],
    benefits: ['Lessons under 10 minutes', 'Built on their interests', 'Any device, anywhere', 'Reading-level support'],
    cta: { label: 'See the student app →', href: '#' },
    photo: '[PHOTO — real student, 16–20, practicing a real task]',
    image: { src: '/images/photos/audience-students.jpg', alt: 'A student preparing a salad while following a Shepherd lesson on a tablet' },
    stat: { value: '< 10 min', caption: 'per lesson' },
  },
];
---
<section class="audiences relative" aria-labelledby="audiences-title" aria-roledescription="carousel">
  <div class="pin flex flex-col justify-center gap-6 py-16 lg:py-12">
    <div class="mx-auto flex w-full max-w-[1200px] flex-col items-center gap-3 px-4 text-center md:px-8 xl:px-0">
      <p class="text-sm font-bold text-brand-700">WHO IT'S FOR</p>
      <h2 id="audiences-title" class="text-display-sm font-bold md:text-display-md lg:text-display-lg">One platform for everyone in a student's corner.</h2>
    </div>

    <div class="mx-auto flex w-full max-w-[1200px] gap-2 overflow-x-auto px-4 [scrollbar-width:none] sm:justify-center sm:gap-3 md:px-8 xl:px-0 [&::-webkit-scrollbar]:hidden" role="group" aria-label="Choose an audience">
      {slides.map((s, i) => (
        <button
          type="button"
          data-index={i}
          aria-controls={s.id}
          aria-current={i === 0 ? 'true' : undefined}
          class="tab flex min-h-11 shrink-0 items-center gap-2 rounded-full bg-orange-50 px-4 font-semibold whitespace-nowrap text-ink transition-colors hover:bg-orange-100 sm:min-h-12 sm:gap-2.5 sm:px-6 sm:text-lg"
        >
          <span aria-hidden="true" class="dot hidden size-2.5 rounded-full bg-white"></span>
          {s.tab}
        </button>
      ))}
    </div>

    <div class="viewport overflow-x-auto overscroll-x-contain [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
      <!-- Side padding is set by the script so the active card is always centered. -->
      <div class="track flex w-max snap-x snap-mandatory gap-6 px-4 py-4 lg:gap-8">
        {slides.map((s, i) => (
          <AudienceCard
            id={s.id}
            role="group"
            aria-roledescription="slide"
            aria-label={`${i + 1} of ${slides.length}: ${s.tab}`}
            class="slide w-[min(1120px,calc(100vw-32px))] shrink-0 snap-center md:w-[min(1120px,calc(100vw-96px))]"
            tone={s.tone}
            eyebrow={s.eyebrow}
            headline={s.headline}
            benefits={s.benefits}
            cta={s.cta}
            photo={s.photo}
            image={s.image}
            stat={s.stat}
          />
        ))}
      </div>
    </div>

    <!-- Pagination dots: a mouse shortcut mirroring the tabs, so hidden from assistive tech. -->
    <div class="flex justify-center gap-1" aria-hidden="true">
      {slides.map((_, i) => (
        <button type="button" tabindex="-1" data-index={i} class="pager p-1.5">
          <span class={`block size-2.5 rounded-full transition-colors ${i === 0 ? 'bg-brand-700' : 'bg-line-strong'}`}></span>
        </button>
      ))}
    </div>
  </div>
</section>

<style>
  .tab[aria-current='true'] { background: var(--color-brand-700); color: var(--color-white); }
  .tab[aria-current='true'] .dot { display: block; }
  .pager:hover .bg-line-strong { background: var(--color-field); }

  /* Pinned, scroll-driven mode (set by script on wide screens without reduced motion) */
  /* Pin under the floating nav (--nav-h is set by SiteNav). */
  .audiences.is-pinned .pin { position: sticky; top: 0; min-height: 100vh; padding-top: calc(var(--nav-h, 0px) + 8px); padding-bottom: 24px; }
  .audiences.is-pinned .viewport { overflow: hidden; }
  .audiences.is-pinned .track { will-change: transform; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.audiences').forEach((section) => {
    const viewport = section.querySelector<HTMLElement>('.viewport')!;
    const track = section.querySelector<HTMLElement>('.track')!;
    const tabs = [...section.querySelectorAll<HTMLButtonElement>('.tab')];
    const slides = [...section.querySelectorAll<HTMLElement>('.slide')];
    const wide = window.matchMedia('(min-width: 1024px)');
    const calm = window.matchMedia('(prefers-reduced-motion: reduce)');
    let pinned = false;
    let maxShift = 0;

    const dots = [...section.querySelectorAll<HTMLButtonElement>('.pager span')];
    const tabRow = tabs[0].parentElement!;
    let current = 0;
    const setActive = (i: number) => {
      tabs.forEach((t, k) => (k === i ? t.setAttribute('aria-current', 'true') : t.removeAttribute('aria-current')));
      dots.forEach((d, k) => {
        d.classList.toggle('bg-brand-700', k === i);
        d.classList.toggle('bg-line-strong', k !== i);
      });
      // On narrow screens the tab row scrolls; keep the active pill in view.
      if (i !== current && tabRow.scrollWidth > tabRow.clientWidth) {
        tabRow.scrollTo({ left: tabs[i].offsetLeft - (tabRow.clientWidth - tabs[i].offsetWidth) / 2 });
      }
      current = i;
    };

    // Distance the track moves to bring slide i to the center.
    const slideOffset = (i: number) => slides[i].offsetLeft - slides[0].offsetLeft;

    // Center the cards, then (pinned mode) make the section tall enough that
    // scrolling down by N px moves the track sideways by N px.
    const layout = () => {
      pinned = wide.matches && !calm.matches;
      section.classList.toggle('is-pinned', pinned);
      track.style.transform = '';
      section.style.height = '';
      const pad = Math.max(16, (viewport.clientWidth - slides[0].offsetWidth) / 2);
      track.style.paddingInline = `${pad}px`;
      maxShift = slideOffset(slides.length - 1);
      if (!pinned) return;
      section.style.height = `${window.innerHeight + maxShift}px`;
      onScroll();
    };

    const progress = () => {
      const top = section.getBoundingClientRect().top;
      const run = section.offsetHeight - window.innerHeight;
      return run > 0 ? Math.min(1, Math.max(0, -top / run)) : 0;
    };

    const onScroll = () => {
      if (!pinned) return;
      const shift = progress() * maxShift;
      track.style.transform = `translate3d(${-shift}px,0,0)`;
      // Active = the slide whose offset is nearest the current shift.
      let best = 0;
      slides.forEach((_, i) => { if (Math.abs(slideOffset(i) - shift) < Math.abs(slideOffset(best) - shift)) best = i; });
      setActive(best);
    };

    // Native mode: active = slide nearest the viewport's left edge.
    viewport.addEventListener('scroll', () => {
      if (pinned) return;
      const x = viewport.scrollLeft;
      let best = 0;
      slides.forEach((s, i) => {
        if (Math.abs(s.offsetLeft - slides[0].offsetLeft - x) < Math.abs(slides[best].offsetLeft - slides[0].offsetLeft - x)) best = i;
      });
      setActive(best);
    }, { passive: true });

    tabs.forEach((tab, i) =>
      tab.addEventListener('click', () => {
        const behavior = calm.matches ? 'auto' : 'smooth';
        if (pinned) {
          const run = section.offsetHeight - window.innerHeight;
          const target = maxShift ? slideOffset(i) / maxShift : 0;
          const sectionTop = window.scrollY + section.getBoundingClientRect().top;
          window.scrollTo({ top: sectionTop + target * run, behavior });
        } else {
          viewport.scrollTo({ left: slides[i].offsetLeft - slides[0].offsetLeft, behavior });
        }
        setActive(i);
      }),
    );

    section.querySelectorAll<HTMLButtonElement>('.pager').forEach((dot) =>
      dot.addEventListener('click', () => tabs[Number(dot.dataset.index)].click()),
    );

    // Keyboard users tabbing into an off-screen card: bring it into view.
    slides.forEach((s, i) => s.addEventListener('focusin', () => { if (pinned) tabs[i].click(); }));

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', layout);
    wide.addEventListener('change', layout);
    calm.addEventListener('change', layout);
    layout();
  });
</script>
