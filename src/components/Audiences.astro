---
// "One platform for everyone in a student's corner." (Figma node 38876:4008).
// All three audiences are visible at once — no tabs, rotation or animation. Cards sit in a
// row on desktop and stack in reading order on smaller screens.
import Button from './Button.astro';
import { audienceSlides as audiences } from '../data/audiences';
---
<section class="bg-cream px-4 py-16 md:px-8 lg:py-24" aria-labelledby="audiences-title">
  <div class="mx-auto flex max-w-[1200px] flex-col gap-8">
    <h2 id="audiences-title" class="text-center text-display-sm font-bold md:text-display-md lg:text-display-lg">
      One platform for everyone in a student's corner.
    </h2>

    <ul class="mx-auto grid w-full max-w-[560px] gap-6 lg:max-w-none lg:grid-cols-3">
      {audiences.map((a) => (
        <li id={a.id} class="flex flex-col overflow-hidden rounded-4xl border border-line bg-white">
          <div class="relative h-[240px] shrink-0">
            <img src={a.image.src} width="960" height="640" loading="lazy" alt={a.image.alt} class="size-full object-cover" />
            <p class="absolute bottom-4 left-4 flex flex-col rounded-2xl bg-white px-4 py-3 shadow-lg">
              <span class="text-display-xs font-bold">{a.stat.value}</span>
              <span class="text-sm font-medium text-muted">{a.stat.caption}</span>
            </p>
          </div>
          <div class="flex flex-1 flex-col gap-5 px-7 pt-7 pb-5">
            <h3 class="text-display-xs font-semibold">
              <span class="sr-only">{a.eyebrow.charAt(0) + a.eyebrow.slice(1).toLowerCase()}: </span>
              {a.headline.map((line, i) => <>{line}{i < a.headline.length - 1 && <br />}</>)}
            </h3>
            <ul class="flex flex-col gap-3">
              {a.benefits.map((b) => (
                <li class="flex items-start gap-3 font-medium">
                  <img src="/images/icons/illustrated/check.svg" width="24" height="24" alt="" class="shrink-0" />
                  {b}
                </li>
              ))}
            </ul>
          </div>
          <div class="px-7 pb-7">
            <Button href={a.cta.href} variant="secondary">{a.cta.label}</Button>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
