---
// "One platform for everyone in a student's corner." as big alternating photo rows
// (Figma "Homepage Design (v2), lavender alternative", Audiences). All three are visible,
// static; on phones each row stacks photo-over-copy in reading order.
import Button from './Button.astro';
import { audienceSlides as audiences } from '../data/audiences';

const tones = ['bg-brand-25', 'bg-lavender-25', 'bg-orange-50'];
---
<section class="bg-cream px-4 py-16 md:px-8 lg:py-24" aria-labelledby="audiences-title">
  <div class="mx-auto flex max-w-[1200px] flex-col gap-8">
    <h2 id="audiences-title" class="text-center text-display-sm font-bold md:text-display-md lg:text-display-lg">
      One platform for everyone in a student's corner.
    </h2>

    <ul class="flex flex-col gap-6 lg:gap-8">
      {audiences.map((a, i) => (
        <li id={a.id} class={`flex flex-col gap-6 rounded-[28px] p-4 sm:p-6 lg:items-center lg:gap-14 lg:rounded-[40px] ${tones[i % 3]} ${i % 2 ? 'lg:flex-row-reverse' : 'lg:flex-row'}`}>
          <div class="relative h-[240px] w-full shrink-0 overflow-hidden rounded-[22px] sm:h-[320px] lg:h-[380px] lg:w-[580px] lg:rounded-[28px]">
            <img src={a.image.src} width="960" height="640" loading="lazy" alt={a.image.alt} class="size-full object-cover" />
            <p class="absolute bottom-4 left-4 flex flex-col rounded-2xl bg-white px-4 py-3 shadow-lg lg:bottom-5 lg:left-5">
              <span class="text-display-xs font-bold">{a.stat.value}</span>
              <span class="text-sm font-medium text-muted">{a.stat.caption}</span>
            </p>
          </div>
          <div class="flex flex-1 flex-col items-start gap-[22px] px-2 pb-2 lg:px-0 lg:pb-0 lg:pr-8">
            <h3 class="text-display-xs font-bold sm:text-display-sm">
              <span class="sr-only">{a.eyebrow.charAt(0) + a.eyebrow.slice(1).toLowerCase()}: </span>
              {a.headline.map((line, j) => <>{line}{j < a.headline.length - 1 && <br />}</>)}
            </h3>
            <ul class="flex flex-col gap-3">
              {a.benefits.map((b) => (
                <li class="flex items-center gap-3 text-md font-medium sm:text-lg">
                  <img src="/images/icons/v2/check.svg" width="26" height="26" alt="" class="size-[26px] shrink-0" />
                  {b}
                </li>
              ))}
            </ul>
            <Button href={a.cta.href}>{a.cta.label}</Button>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
