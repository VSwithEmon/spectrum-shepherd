---
// "Free download: [Transition plan]" lead-magnet strip (Figma node 38876:4001).
// Placeholder title in brackets until the client names the resource; the link target is still to come.
import Button from './Button.astro';
---
<section class="bg-white px-5 pb-16 md:px-8 lg:pb-24" aria-labelledby="download-title">
  <div class="mx-auto flex max-w-[1200px] flex-col items-start gap-5 rounded-3xl border border-orange-200 bg-orange-50 px-6 py-6 sm:px-8 sm:py-7 md:flex-row md:items-center md:gap-6">
    <img src="/images/icons/v2/download.svg" width="48" height="48" alt="" class="shrink-0" />
    <div class="flex min-w-0 flex-1 flex-col gap-1">
      <h2 id="download-title" class="text-xl font-semibold">Free download: [Transition plan]</h2>
      <p class="text-muted">A ready-to-use transition plan for your team. Enter your email and we’ll send it straight to your inbox.</p>
    </div>
    <Button href="#" class="w-full shrink-0 md:w-auto">Get the free plan</Button>
  </div>
</section>
