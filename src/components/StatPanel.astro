---
// Green results panel (Figma "Results panel"): equal columns, each with an icon from the
// illustrated icon family, a big value (optional small prefix, e.g. "Up to"), a short yellow accent
// bar and the claim. No supporting sentences. Compact on phones: icon beside value and claim.
// A large Shepherd swirl sits behind as a faint watermark.
interface Props {
  items: { icon: string; prefix?: string; value: string; label: string }[];
}
const { items } = Astro.props;
---
<div class="on-dark relative overflow-hidden rounded-[28px] bg-brand-800 px-5 py-1 text-white sm:rounded-[32px] sm:px-10 sm:py-3 lg:p-14">
  <span aria-hidden="true" class="swirl pointer-events-none absolute -top-[150px] left-[70%] size-[520px] bg-white opacity-[0.07] max-lg:-top-16 max-lg:left-auto max-lg:-right-24 max-lg:size-[320px]"></span>
  <ul class="relative grid lg:grid-cols-3">
    {items.map((r, i) => (
      <li class={`flex items-center gap-4 py-4 lg:flex-col lg:items-start lg:gap-5 lg:py-0 ${i ? 'border-t border-brand-700 lg:border-t-0 lg:border-l lg:pl-10' : ''} ${i < items.length - 1 ? 'lg:pr-10' : ''}`}>
        <img src={`/images/icons/v2/${r.icon}.svg`} width="48" height="48" alt="" class="size-10 shrink-0 sm:size-12" />
        <p class="flex flex-col items-start gap-1 lg:gap-5">
          <span class="flex flex-col font-bold text-white">
            {r.prefix && <span class="text-md text-brand-50 lg:text-xl">{r.prefix}</span>}
            <span class="text-display-sm sm:text-display-md lg:text-display-xl">{r.value}</span>
          </span>
          <span aria-hidden="true" class="hidden h-1 w-12 rounded-sm bg-yellow-300 lg:block"></span>
          <span class="text-md font-medium text-brand-50 sm:text-lg">{r.label}</span>
        </p>
      </li>
    ))}
  </ul>
</div>
