---
// "Two hats" testimonial (Figma node 38876:4108): portrait beside the pull quote, then the
// teacher and administrator halves of the quote as two white cards. No motion.
// One blockquote in the accessibility tree; `display: contents` lets its parts sit in the layout.
---
<section class="relative overflow-hidden bg-brand-50 px-4 py-16 md:px-8 lg:py-24" aria-labelledby="testimonial-title">
  <span aria-hidden="true" class="pointer-events-none absolute -top-8 right-[60px] hidden text-[320px] leading-[320px] font-bold tracking-[-0.02em] text-brand-200 xl:block">”</span>
  <h2 id="testimonial-title" class="sr-only">From the classroom</h2>

  <figure class="relative mx-auto flex max-w-[1200px] flex-col gap-10 lg:gap-16">
    <div class="flex flex-col items-center gap-8 md:flex-row md:items-center md:justify-center md:gap-14">
      <span class="relative block size-[160px] shrink-0 rounded-full bg-white p-[14px] sm:size-[216px] sm:p-[18px]">
        <img
          src="/images/photos/lori-lopez-lopez.jpg"
          width="640"
          height="640"
          loading="lazy"
          alt="Portrait of Dr. Lori Lopez-Lopez"
          class="size-full rounded-full object-cover"
        />
      </span>
      <div class="flex max-w-[760px] flex-col gap-6 text-center md:text-left">
        <blockquote class="contents">
          <p class="text-display-xs font-bold sm:text-display-sm md:text-display-md lg:text-display-lg">“I see the value both as a teacher and as an administrator.”</p>
        </blockquote>
        <figcaption class="flex flex-col">
          <span class="text-lg font-bold">Dr. Lori Lopez-Lopez</span>
          <span class="text-sm text-muted">Teacher and Administrator, Special Education</span>
        </figcaption>
      </div>
    </div>

    <blockquote class="grid gap-6 md:grid-cols-2">
      <p class="flex flex-col gap-5 rounded-[32px] bg-white p-6 text-lg font-medium shadow-lg sm:p-8 sm:text-xl">
        <img src="/images/icons/site/lesson.svg" width="48" height="48" alt="" />
        <span><strong class="font-bold">As a teacher,</strong> it gives us a highly effective tool for explicit functional and social skills instruction.</span>
      </p>
      <p class="flex flex-col gap-5 rounded-[32px] bg-white p-6 text-lg font-medium shadow-lg sm:p-8 sm:text-xl">
        <img src="/images/icons/site/progress.svg" width="48" height="48" alt="" />
        <span><strong class="font-bold">As an administrator,</strong> it lets us monitor progress that's typically far too subjective. Our team can now set the trajectory and manage to it.</span>
      </p>
    </blockquote>
  </figure>
</section>
