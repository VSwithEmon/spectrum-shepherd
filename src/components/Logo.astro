---
// Shepherd logo: dotted mark (PNG used as a mask over brand green) + "shepherd" wordmark.
interface Props { class?: string; href?: string }
const { class: className = '', href = '/' } = Astro.props;
---
<a href={href} aria-label="Spectrum Shepherd home" class={`flex shrink-0 items-center gap-1.5 ${className}`}>
  <span aria-hidden="true" class="logo-mark size-10 bg-brand-500"></span>
  <img src="/images/logo-text.svg" width="117" height="24" alt="" />
</a>

<style>
  .logo-mark {
    mask: url('/images/logo-mark.png') center / 40px 40px no-repeat;
    -webkit-mask: url('/images/logo-mark.png') center / 40px 40px no-repeat;
  }
</style>
