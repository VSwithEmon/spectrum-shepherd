---
// Spectrum Shepherd company logo (wordmark + swirl), per the client's choice over the Shepherd product logo.
// The PNG is the asset from Figma; swap for an SVG when the client supplies one.
interface Props { class?: string }
const { class: className = '' } = Astro.props;
---
<a href="/" class={`flex shrink-0 items-center ${className}`}>
  <img src="/images/brand/spectrum-shepherd.png" width="166" height="60" alt="Spectrum Shepherd home" class="h-11 w-auto sm:h-[52px]" />
</a>
