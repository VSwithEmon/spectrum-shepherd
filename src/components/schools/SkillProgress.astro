---
// "Progress by Skill Area" dashboard (product mock from the client's brochure, in the V2 style):
// progress against end-of-year targets per skill area. Values are readable as text; bars are
// decoration. Illustrative sample data only.
const rows = [
  { skill: 'Daily living', value: 72, target: 80, status: 'on' },
  { skill: 'Communication', value: 65, target: 65, status: 'on' },
  { skill: 'Emotional regulation', value: 58, target: 75, status: 'watch' },
  { skill: 'Self-advocacy', value: 44, target: 60, status: 'watch' },
  { skill: 'Personal safety', value: 26, target: 70, status: 'focus' },
] as const;
const status = {
  on: { label: 'ON TRACK', chip: 'bg-brand-50 text-brand-800', bar: 'bg-brand-700' },
  watch: { label: 'WATCH', chip: 'bg-yellow-100 text-yellow-800', bar: 'bg-yellow-400' },
  focus: { label: 'NEEDS SUPPORT', chip: 'bg-orange-50 text-orange-700', bar: 'bg-orange-700' },
};
---
<figure class="flex flex-col gap-3">
  <div class="flex flex-col gap-4 rounded-3xl bg-white p-5 shadow-2xl sm:p-7">
    <div class="flex items-center gap-3">
      <span class="rounded-md bg-yellow-100 px-2 py-0.5 text-xs font-bold text-yellow-800">SAMPLE</span>
      <p class="flex-1">
        <span class="block font-semibold">Progress by Skill Area</span>
        <span class="block text-xs text-muted">Classroom 104 · Progress against end-of-year targets</span>
      </p>
    </div>
    {rows.map((r) => (
      <div class="grid grid-cols-[1fr_44px] items-center gap-x-3 gap-y-1.5 sm:grid-cols-[150px_1fr_44px_112px] sm:gap-x-4">
        <p class="text-sm font-semibold sm:col-span-1">{r.skill}<span class="block text-xs font-normal text-muted">Target {r.target}%</span></p>
        <span class="text-right text-sm font-bold sm:order-3">{r.value}%</span>
        <span aria-hidden="true" class="relative col-span-2 h-2 rounded-full bg-line sm:order-2 sm:col-span-1">
          <span class={`absolute inset-y-0 left-0 rounded-full ${status[r.status].bar}`} style={`width:${r.value}%`}></span>
          <span class="absolute -top-1 h-4 w-0.5 bg-ink" style={`left:${r.target}%`}></span>
        </span>
        <span class={`col-span-2 justify-self-start rounded-md px-2 py-0.5 text-center text-xs font-bold sm:order-4 sm:col-span-1 sm:justify-self-stretch ${status[r.status].chip}`}>{status[r.status].label}</span>
      </div>
    ))}
    <p class="flex flex-wrap gap-x-4 gap-y-1 text-xs text-muted">
      <span class="flex items-center gap-1.5"><span aria-hidden="true" class="h-2 w-5 rounded-full bg-brand-700"></span>Current progress</span>
      <span class="flex items-center gap-1.5"><span aria-hidden="true" class="h-3.5 w-0.5 bg-ink"></span>End-of-year target</span>
    </p>
  </div>
  <figcaption class="text-xs text-muted">Example. Sample dashboard: student data is illustrative and does not represent a real individual.</figcaption>
</figure>
