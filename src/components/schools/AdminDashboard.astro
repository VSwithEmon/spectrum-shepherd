---
// Administrator progress dashboard (product mock for the Schools hero), adapted from the client's
// brochure to the V2 style: program summary tiles, progress by classroom and students needing
// attention. Illustrative sample data only; not every feature shown is implied to be available.
interface Props { class?: string }
const { class: className = '' } = Astro.props;
const tiles = [
  { label: 'Students on track', value: '18 / 24', tone: 'bg-brand-50 text-brand-800' },
  { label: 'Lessons this week', value: '126', tone: 'bg-yellow-100 text-yellow-800' },
  { label: 'Goals progressing', value: '9 of 12', tone: 'bg-periwinkle-100 text-periwinkle-800' },
];
const rooms = [
  { name: 'Room 104 · Transition', pct: 78 },
  { name: 'Room 112 · Life skills', pct: 64 },
  { name: 'Room 207 · Post-secondary', pct: 52 },
];
const attention = [
  { initials: 'JM', name: 'Jordan M.', note: 'Personal safety below target' },
  { initials: 'AR', name: 'Ava R.', note: 'No lessons in 5 days' },
];
---
<div class={`overflow-hidden rounded-[20px] border-2 border-brand-500 bg-white text-left text-ink shadow-2xl ${className}`}>
  <div class="flex items-center justify-between bg-brand-500 px-4 py-2.5 text-white">
    <span class="text-sm font-bold">shepherd</span>
    <span class="flex gap-1.5 text-xs font-semibold">
      <span class="rounded-full bg-white px-2.5 py-0.5 text-brand-800">Program</span>
      <span class="rounded-full px-2.5 py-0.5">Classrooms</span>
      <span class="hidden rounded-full px-2.5 py-0.5 sm:inline">Reports</span>
    </span>
  </div>
  <div class="flex flex-col gap-4 p-4 sm:p-5">
    <div class="flex items-center justify-between gap-3">
      <div>
        <p class="text-lg font-semibold">Transition program overview</p>
        <p class="text-xs text-muted">All classrooms · This term</p>
      </div>
      <span class="rounded-md bg-yellow-100 px-2 py-0.5 text-xs font-bold text-yellow-800">SAMPLE</span>
    </div>
    <ul class="grid grid-cols-3 gap-2.5">
      {tiles.map((t) => (
        <li class={`flex flex-col gap-1 rounded-xl px-3 py-2.5 ${t.tone}`}>
          <span class="text-lg font-bold sm:text-xl">{t.value}</span>
          <span class="text-[11px] font-semibold leading-tight sm:text-xs">{t.label}</span>
        </li>
      ))}
    </ul>
    <div class="grid gap-3 sm:grid-cols-[1fr_190px]">
      <div class="flex flex-col gap-2.5 rounded-xl border border-line p-3">
        <p class="text-xs font-bold text-muted">Progress by classroom</p>
        {rooms.map((r) => (
          <div class="flex flex-col gap-1">
            <p class="flex justify-between text-xs font-semibold"><span>{r.name}</span><span>{r.pct}%</span></p>
            <span aria-hidden="true" class="relative h-2 rounded-full bg-line">
              <span class="absolute inset-y-0 left-0 rounded-full bg-brand-600" style={`width:${r.pct}%`}></span>
            </span>
          </div>
        ))}
      </div>
      <div class="flex flex-col gap-2 rounded-xl border border-line p-3">
        <p class="text-xs font-bold text-muted">Needs attention</p>
        {attention.map((a) => (
          <p class="flex items-center gap-2">
            <span aria-hidden="true" class="flex size-7 shrink-0 items-center justify-center rounded-full bg-orange-100 text-[11px] font-bold text-orange-800">{a.initials}</span>
            <span class="flex flex-col">
              <span class="text-xs font-semibold">{a.name}</span>
              <span class="text-[11px] text-muted">{a.note}</span>
            </span>
          </p>
        ))}
      </div>
    </div>
  </div>
</div>
