---
// "One curriculum. Personalized for every student." product illustration: one shared life skills
// curriculum at the top feeding three students' individualized learning plans (goal, interest,
// level). Fictional students; decorative connectors. The plans are a readable list.
const plans = [
  { initials: 'M', name: 'Maya', goal: 'Budgeting', interest: 'Music', level: 'Level 2', tint: 'bg-yellow-100', dot: 'bg-yellow-400' },
  { initials: 'D', name: 'Devon', goal: 'Self-advocacy', interest: 'Basketball', level: 'Level 1', tint: 'bg-orange-100', dot: 'bg-orange-400' },
  { initials: 'S', name: 'Sam', goal: 'Personal safety', interest: 'Cooking', level: 'Level 3', tint: 'bg-periwinkle-100', dot: 'bg-violet-500' },
];
const suites = ['Daily living', 'Home management', 'Safety & independence', 'Civic & community', 'Social & digital'];
---
<figure class="relative flex flex-col items-center gap-0" aria-label="One shared curriculum personalized into three students' learning plans">
  <div class="relative z-10 w-full max-w-[420px] rounded-3xl border-2 border-brand-500 bg-white p-5 shadow-xl">
    <p class="flex items-center gap-2 text-sm font-bold text-brand-800">
      <img src="/images/icons/v2/lesson.svg" width="32" height="32" alt="" class="size-8" />Life skills curriculum
    </p>
    <ul class="mt-3 flex flex-wrap gap-1.5">
      {suites.map((s) => <li class="rounded-full bg-brand-50 px-2.5 py-1 text-xs font-semibold text-brand-800">{s}</li>)}
    </ul>
  </div>
  <svg aria-hidden="true" class="hidden h-14 w-full max-w-[560px] sm:block" viewBox="0 0 560 56" fill="none" preserveAspectRatio="none">
    <path d="M280 0V20M280 20C280 36 93 28 93 56M280 20V56M280 20C280 36 467 28 467 56" class="stroke-brand-300" stroke-width="2.5" stroke-dasharray="2 8" stroke-linecap="round" />
  </svg>
  <ul class="mt-4 grid w-full gap-3 sm:mt-0 sm:grid-cols-3">
    {plans.map((p) => (
      <li class={`flex flex-col gap-2.5 rounded-2xl p-4 shadow-md ${p.tint}`}>
        <p class="flex items-center gap-2">
          <span aria-hidden="true" class="flex size-8 items-center justify-center rounded-full bg-white text-sm font-bold">{p.initials}</span>
          <span class="font-bold">{p.name}’s plan</span>
        </p>
        <dl class="grid grid-cols-[auto_1fr] gap-x-2 gap-y-1 text-xs">
          <dt class="font-semibold text-muted">Goal</dt><dd class="font-semibold">{p.goal}</dd>
          <dt class="font-semibold text-muted">Interest</dt><dd class="flex items-center gap-1.5 font-semibold"><span aria-hidden="true" class={`size-2 rounded-full ${p.dot}`}></span>{p.interest}</dd>
          <dt class="font-semibold text-muted">Level</dt><dd class="font-semibold">{p.level}</dd>
        </dl>
      </li>
    ))}
  </ul>
</figure>
