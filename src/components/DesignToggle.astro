---
// Review aid: switch between the two homepage designs from Figma's "Homepage Design( update here)"
// section — V1 = Figma V1 (main direction, yellow accents), V2 = Figma V2 (lavender alternative),
// V3 = Figma "Homepage Design (v3) — client feedback Oct 26".
interface Props { active: 'v1' | 'v2' | 'v3' }
const { active } = Astro.props;
const options = [
  { id: 'v1', label: 'V1', href: '/v1' },
  { id: 'v2', label: 'V2', href: '/v2' },
  { id: 'v3', label: 'V3', href: '/v3' },
];
---
<nav
  aria-label="Compare homepage designs"
  class="fixed right-3 bottom-4 z-50 flex items-center gap-1 rounded-full bg-ink p-1.5 text-white shadow-2xl md:top-1/2 md:right-4 md:bottom-auto md:-translate-y-1/2 md:flex-col md:rounded-3xl"
>
  <span class="px-2 text-xs font-bold tracking-wide text-brand-100 md:px-0 md:pt-1 md:pb-1">DESIGN</span>
  {options.map((o) => (
    <a
      href={o.href}
      aria-current={o.id === active ? 'page' : undefined}
      class={`flex min-h-11 min-w-16 items-center justify-center rounded-full px-4 text-sm font-semibold transition-colors ${
        o.id === active ? 'bg-yellow-300 text-ink' : 'text-white hover:bg-white/15'
      }`}
    >{o.label}</a>
  ))}
</nav>
