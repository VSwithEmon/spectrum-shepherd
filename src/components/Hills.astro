---
// Decorative section edge: layered green hills with a dotted trail (echoing the
// dotted logo) climbing toward a rising sun — the path to independence.
// The front hill's color must match the section that follows.
interface Props {
  front?: 'brand-700' | 'brand-800';
  trail?: boolean;
  /** Dotted path only (keeps the sun). V1 hero (Oct 2026 Figma) has no path. */
  path?: boolean;
  /** Trees on the back-hill crest so the shapes read as a landscape (Oct 2026 feedback). */
  trees?: boolean;
  /** Setting sun sinking behind the back hill (yellow → peach; lavender → blush on data-palette="lavender"). */
  sunset?: boolean;
  class?: string;
}
const { front = 'brand-700', trail = true, path = true, trees = false, sunset = false, class: className = '' } = Astro.props;
const frontFill = front === 'brand-700' ? 'fill-brand-700' : 'fill-brand-800';
const sunId = `sunset-${Math.random().toString(36).slice(2, 8)}`;
// [x of trunk base, y on the back-hill crest, kind, scale]
const treeSpots: [number, number, 'round' | 'pine', number][] = [
  [104, 96, 'pine', 1], [128, 94, 'round', 0.85], [1190, 84, 'pine', 0.8], [1214, 81, 'round', 1], [1240, 78, 'pine', 0.9],
];
---
<svg
  aria-hidden="true"
  focusable="false"
  viewBox="0 0 1440 180"
  preserveAspectRatio="xMidYMax slice"
  class={`block h-[90px] w-full sm:h-[140px] lg:h-auto ${className}`}
>
  {trail && <circle cx="1250" cy="72" r="34" class="fill-yellow-300" />}
  {sunset && (
    <Fragment>
      <defs>
        <linearGradient id={sunId} x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" class="[stop-color:var(--color-yellow-300)] lavender:[stop-color:var(--color-lavender-200)]" />
          <stop offset="1" class="[stop-color:var(--color-orange-200)] lavender:[stop-color:var(--color-blush-200)]" />
        </linearGradient>
      </defs>
      <circle cx="1010" cy="138" r="96" fill={`url(#${sunId})`} />
    </Fragment>
  )}
  <path class="fill-brand-200" d="M0 120C240 60 420 70 620 110S1000 150 1200 80S1400 60 1440 70V180H0Z" />
  {trees && treeSpots.map(([x, y, kind, s]) => (
    <g transform={`translate(${x} ${y + 4}) scale(${s})`}>
      <rect x="-2" y="-20" width="4" height="20" rx="2" class="fill-brand-900" />
      {kind === 'round'
        ? <ellipse cx="0" cy="-34" rx="15" ry="17" class="fill-brand-600" />
        : <path d="M0 -58L14 -14H-14Z" class="fill-brand-700" />}
    </g>
  ))}
  <path class="fill-brand-500" d="M0 150C200 110 380 100 560 130S900 170 1100 120S1380 100 1440 115V180H0Z" />
  {trail && path && (
    <path
      class="hills-trail"
      d="M60 158C220 136 380 128 560 142S880 152 1100 128S1220 110 1250 106"
      fill="none"
      stroke="#ffffff"
      stroke-width="6"
      stroke-linecap="round"
    />
  )}
  <path class={frontFill} d="M0 170C300 150 500 142 760 160S1200 176 1440 150V181H0Z" />
</svg>

<style>
  .hills-trail {
    stroke-dasharray: 0 16;
    animation: hills-march 1.6s linear infinite;
  }
  @keyframes hills-march {
    to { stroke-dashoffset: -16; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hills-trail { animation: none; }
  }
</style>
