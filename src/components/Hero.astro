---
// Homepage hero (Figma "Homepage Design (v1)" / "(v2)" hero, 1440×784, Oct 2026): copy left,
// product composition right, cream → mist sky with clouds and birds, layered hills with tree
// silhouettes along the bottom. The V4 lavender look comes from the `lavender:` utilities.
import Button from './Button.astro';
import StatusChip from './StatusChip.astro';
import HeroHills from './v3/HeroHills.astro';
import SkyDecor from './v3/SkyDecor.astro';
import { site } from '../data/site';
---
<section class="relative overflow-hidden bg-linear-to-b from-cream via-haze via-10% to-mist" aria-labelledby="hero-title">
  <SkyDecor mobile />
  <div class="relative z-10 mx-auto flex max-w-[1200px] flex-col items-center gap-5 px-4 pt-6 pb-16 sm:gap-12 md:px-8 lg:flex-row lg:pb-0 xl:px-0">
    <div class="flex w-full flex-col items-start gap-6 lg:flex-1">
      <h1 id="hero-title" class="text-[34px]/[42px] font-bold min-[380px]:text-[38px]/[46px] sm:text-display-lg">
        Real-world skills.<br />
        <span class="text-brand-600">Real independence.</span>
      </h1>
      <p class="text-[17px]/[27px] font-medium text-muted sm:text-xl">Short, personalized lessons students actually want to do and IEP-ready progress reports their teachers don't have to write.</p>
      <div class="flex w-full flex-col gap-3">
        <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <Button href={site.trial}>Start your 45-day free trial</Button>
          <Button href="#demo" variant="secondary">Book a demo</Button>
        </div>
        <p class="text-center text-sm font-medium text-muted sm:text-left">First lesson in under five minutes · Built for FERPA compliance</p>
      </div>
      <ul class="grid w-full gap-4 pt-2 sm:grid-cols-2">
        <li class="flex flex-col gap-1 border-l-3 border-yellow-400 pl-4 lavender:border-lavender-300">
          <span class="font-bold">For schools &amp; teachers</span>
          <span class="text-sm text-muted">Ready-made curriculum and reports that prove impact.</span>
        </li>
        <li class="flex flex-col gap-1 border-l-3 border-yellow-400 pl-4 lavender:border-lavender-300">
          <span class="font-bold">For students</span>
          <span class="text-sm text-muted">Short lessons that build skills for everyday life.</span>
        </li>
      </ul>
    </div>

    <!-- Product composition: positions are % of the 600×600 Figma frame -->
    <div class="relative aspect-square w-full max-w-[330px] shrink-0 sm:max-w-[600px] lg:w-[600px]">
      <div aria-hidden="true" class="absolute top-[5%] left-[20%] aspect-square w-[76.67%] rounded-full bg-yellow-200 lavender:bg-lavender-200"></div>
      <img
        src="/images/photos/hero-student.jpg"
        width="600"
        height="538"
        alt="A teenage student wearing headphones, smiling while working through a lesson on a tablet"
        class="absolute top-0 left-[56.67%] aspect-square w-[41.67%] rounded-full object-cover object-[40%_center]"
      />
      <!-- Product shots: cropped to the device frame with transparent corners; drop-shadow follows the shape. -->
      <img
        src="/images/teacher-dashboard.webp"
        width="2080"
        height="1320"
        alt="Shepherd teacher dashboard for William School, showing Classroom Pulse stats and the classroom roster"
        class="device-shot absolute top-[33.33%] left-0 w-[86.67%]"
        fetchpriority="high"
      />
      <img
        src="/images/student-app-home.webp"
        width="688"
        height="1432"
        alt="Shepherd student app home screen with a message from the coach and options to browse lessons or play games"
        class="device-shot absolute top-[38.33%] left-[70%] w-[28.67%]"
      />
      <StatusChip title="Lesson complete" caption="Budgeting for a concert ticket" class="top-[19.67%] left-[-4%] origin-top-left max-sm:scale-[0.55]" />
      <StatusChip title="Progress note saved" caption="Linked to IEP goal" class="top-[91.33%] left-[25%] origin-top-left max-sm:scale-[0.55]" />
    </div>
  </div>

  <HeroHills class="relative -mt-[81px] sm:-mt-24 lg:-mt-[18px]" />
</section>

<style>
  .device-shot { filter: drop-shadow(0 24px 24px rgb(10 13 18 / 0.16)) drop-shadow(0 4px 4px rgb(10 13 18 / 0.04)); }
</style>
