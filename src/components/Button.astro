---
// Button from the Figma "Button" set (Primary / Secondary), plus light variants for dark panels.
// Colors are one step darker than the Figma gradient so label text meets 4.5:1.
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'light' | 'outline-light';
  size?: 'md' | 'lg';
  /** md buttons are rounded-lg by default; 'pill' makes them fully round. */
  shape?: 'default' | 'pill';
  type?: 'button' | 'submit';
  full?: boolean;
  class?: string;
}
const { href, variant = 'primary', size = 'md', shape = 'default', type = 'button', full = false, class: className = '' } = Astro.props;

const variants = {
  primary: 'bg-linear-to-b from-brand-700 to-brand-800 text-white shadow-button hover:from-brand-800',
  secondary: 'border border-brand-50 bg-brand-25 text-brand-700 hover:bg-brand-50 hover:text-brand-800',
  light: 'bg-white text-brand-800 hover:bg-brand-25',
  'outline-light': 'border-2 border-white text-white hover:bg-white/10',
};
const sizes = {
  md: `min-h-12 px-5 py-3 text-md ${shape === 'pill' ? 'rounded-full' : 'rounded-lg'}`,
  lg: 'min-h-16 rounded-full px-10 py-4 text-xl sm:text-display-xs',
};
const classes = [
  'inline-flex items-center justify-center gap-2 text-center font-semibold transition-colors',
  sizes[size],
  variants[variant],
  full && 'w-full',
  className,
].filter(Boolean).join(' ');
---
{href ? <a href={href} class={classes}><slot /></a> : <button type={type} class={classes}><slot /></button>}
