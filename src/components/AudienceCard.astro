---
// "HP2 / Audience Card" — photo + stat chip, 4 benefits, one secondary CTA.
import Button from './Button.astro';
import CheckItem from './CheckItem.astro';
import FloatingStat from './FloatingStat.astro';
import PhotoPlaceholder from './PhotoPlaceholder.astro';

interface Props {
  eyebrow: string;
  headline: string[];
  benefits: string[];
  cta: { label: string; href: string };
  photo: string;
  stat: { value: string; caption: string };
  tone: 'brand' | 'yellow' | 'orange';
  photoSide?: 'left' | 'right';
}
const { eyebrow, headline, benefits, cta, photo, stat, tone, photoSide = 'right' } = Astro.props;
const border = { brand: 'border-brand-200', yellow: 'border-yellow-300', orange: 'border-orange-200' }[tone];
const eyebrowColor = { brand: 'text-brand-700', yellow: 'text-yellow-800', orange: 'text-orange-700' }[tone];
---
<article class={`flex flex-col gap-8 rounded-4xl border-2 bg-white p-4 shadow-lg lg:items-center lg:gap-12 ${photoSide === 'left' ? 'lg:flex-row-reverse' : 'lg:flex-row'} ${border}`}>
  <div class={`flex flex-col items-start gap-6 px-2 pb-4 sm:px-4 lg:flex-1 lg:pb-0 ${photoSide === 'left' ? 'lg:pr-8 lg:pl-0' : 'lg:pl-8'}`}>
    <p class={`text-sm font-bold ${eyebrowColor}`}>{eyebrow}</p>
    <h3 class="text-display-xs font-bold sm:text-display-sm">
      {headline.map((line, i) => <Fragment>{line}{i < headline.length - 1 && <br />}</Fragment>)}
    </h3>
    <ul class="grid gap-3 sm:grid-cols-2">
      {benefits.map((b) => <CheckItem>{b}</CheckItem>)}
    </ul>
    <Button href={cta.href} variant="secondary">{cta.label}</Button>
  </div>
  <div class="relative h-[280px] w-full sm:h-[400px] lg:w-[540px] lg:shrink-0">
    <PhotoPlaceholder label={photo} tone={tone} class="absolute inset-0 rounded-4xl" />
    <FloatingStat value={stat.value} caption={stat.caption} class="bottom-5 left-5" />
  </div>
</article>
