---
import BrandIcon from './v3/BrandIcon.astro';
// "HP2 / Status Chip" — floating status over hero product imagery.
interface Props {
  title: string;
  caption: string;
  class?: string;
  /** In normal flow instead of floating over an image. */
  inline?: boolean;
}
const { title, caption, class: className = '', inline = false } = Astro.props;
---
<div class={`${inline ? 'relative' : 'absolute'} flex items-center gap-3 rounded-3xl bg-white px-4 py-3 shadow-lg ${className}`}>
  <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-brand-50">
    <BrandIcon name="check" class="size-6" />
  </span>
  <span class="flex flex-col whitespace-nowrap">
    <span class="font-bold">{title}</span>
    <span class="text-sm text-muted">{caption}</span>
  </span>
</div>
