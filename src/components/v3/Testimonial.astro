---
// Testimonial (Oct 2026 feedback): one clear reading order — photo → quote → name, then two
// matching cards. No eyebrow, no spinning ring; website icon family instead of the app's
// book/tools. One blockquote (display:contents) so the parts can sit in the grid.
import BrandIcon from './BrandIcon.astro';

/** Client-approved wording (Oct 26, 2026): "monitor transition progress". */
interface Props { v3?: boolean }
const { v3 = false } = Astro.props;
---
<section class="relative overflow-hidden bg-brand-50 px-4 py-16 md:px-8 lg:py-24" aria-labelledby="testimonial-title">
  <h2 id="testimonial-title" class="sr-only">What educators say</h2>
  <span aria-hidden="true" class="pointer-events-none absolute -top-8 right-14 hidden text-[320px] leading-none font-bold text-brand-200 xl:block">”</span>

  <figure class="relative mx-auto grid max-w-[1200px] items-center gap-x-14 gap-y-6 lg:grid-cols-[216px_1fr] lg:px-20">
    <span class="order-1 mx-auto block size-32 rounded-full bg-white p-3 sm:size-[216px] sm:p-[18px] lg:row-span-2">
      <img
        src="/images/photos/lori-lopez-lopez.jpg"
        width="640"
        height="640"
        loading="lazy"
        alt="Portrait of Dr. Lori Lopez-Lopez"
        class="size-full rounded-full object-cover"
      />
    </span>
    <blockquote class="contents">
      <p class="order-2 text-center text-display-xs font-bold sm:text-display-sm md:text-display-md lg:col-start-2 lg:row-start-1 lg:self-end lg:text-left lg:text-display-lg">
        “I see the value both as a teacher and as an administrator.”
      </p>
      <div class="order-4 mt-4 grid gap-6 md:grid-cols-2 lg:col-span-2 lg:mt-10 lg:-mx-20">
        <p class="flex flex-col gap-5 rounded-3xl bg-white p-5 text-md font-medium shadow-lg sm:rounded-[32px] sm:p-8 sm:text-xl">
          <BrandIcon name="lesson" />
          <span><strong class="font-bold">As a teacher,</strong> it gives us a highly effective tool for explicit functional and social skills instruction.</span>
        </p>
        <p class="flex flex-col gap-5 rounded-3xl bg-white p-5 text-md font-medium shadow-lg sm:rounded-[32px] sm:p-8 sm:text-xl">
          <BrandIcon name="progress" />
          <span><strong class="font-bold">As an administrator,</strong> it lets us monitor {v3 && 'transition '}progress that's typically far too subjective. Our team can now set the trajectory and manage to it.</span>
        </p>
      </div>
    </blockquote>
    <figcaption class="order-3 flex flex-col text-center lg:col-start-2 lg:row-start-2 lg:self-start lg:text-left">
      <span class="text-lg font-bold">Dr. Lori Lopez-Lopez</span>
      <span class="text-sm text-muted">Teacher and Administrator, Special Education</span>
    </figcaption>
  </figure>
</section>
