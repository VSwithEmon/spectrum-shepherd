---
// Free transition-plan download (Oct 2026 feedback): an email-capture offer for admins.
// The title is a placeholder until the client confirms the resource name and form service.
import Button from '../Button.astro';
import BrandIcon from './BrandIcon.astro';

interface Props {
  /** Placeholder wording differs between the two Figma homepages. */
  title?: string;
}
const { title = 'Free download: [Transition plan template]' } = Astro.props;
---
<section class="bg-white px-4 pb-16 md:px-8 lg:pb-24" aria-labelledby="download-title">
  <div class="mx-auto flex max-w-[1200px] flex-col items-start gap-4 rounded-3xl border border-orange-200 bg-orange-50 p-6 sm:flex-row sm:items-center sm:gap-6 sm:px-8 sm:py-7">
    <BrandIcon name="download" />
    <div class="flex flex-1 flex-col gap-1">
      <h2 id="download-title" class="text-xl font-semibold">{title}</h2>
      <p class="text-muted">A ready-to-use transition plan for your team. Enter your email and we'll send it straight to your inbox.</p>
    </div>
    <Button href="#" class="w-full sm:w-auto">Get the free plan</Button>
  </div>
</section>
