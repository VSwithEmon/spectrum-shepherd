---
// Green panel with equal result columns (used by Results and the Teachers page).
// The Shepherd swirl is a faint watermark; yellow is only the small accent bar.
import BrandIcon, { type IconName } from './BrandIcon.astro';

interface Props {
  items: { icon: IconName; value: string; label: string }[];
  /** Phones: no icons or accent bars and smaller values, so the panel stays short (client feedback, Oct 26, 2026). */
  compactMobile?: boolean;
}
const { items, compactMobile = false } = Astro.props;
---
<div class="on-dark relative overflow-hidden rounded-3xl bg-brand-800 px-6 py-2 text-white md:rounded-[32px] md:p-14">
  <span aria-hidden="true" class="swirl pointer-events-none absolute -top-16 -right-16 size-[300px] bg-white opacity-[0.07] md:-top-[150px] md:-right-[160px] md:size-[520px]"></span>
  <ul class="relative grid md:grid-cols-3">
    {items.map((r, i) => (
      <li class={`flex flex-col gap-3 md:gap-5 md:py-0 ${compactMobile ? 'py-5' : 'py-6'} ${i ? 'border-t border-brand-700 md:border-t-0 md:border-l md:pl-10' : ''} ${i < items.length - 1 ? 'md:pr-10' : ''}`}>
        <BrandIcon name={r.icon} class={compactMobile ? 'size-12 max-md:hidden' : 'size-12'} />
        <p class={`flex flex-col md:gap-5 ${compactMobile ? 'gap-1' : 'gap-3'}`}>
          <span class={`font-bold md:text-display-xl ${compactMobile ? 'text-display-md' : 'text-display-lg'}`}>{r.value}</span>
          <span aria-hidden="true" class={`h-1 w-12 rounded-full bg-yellow-300 lavender:bg-lavender-200 ${compactMobile ? 'max-md:hidden' : ''}`}></span>
          <span class={`text-md font-medium text-brand-50 md:text-lg ${r.label.length <= 30 ? "xl:whitespace-nowrap" : ""}`}>{r.label}</span>
        </p>
      </li>
    ))}
  </ul>
</div>

<style>
  .swirl {
    mask: url('/images/logo-mark.png') center / contain no-repeat;
    -webkit-mask: url('/images/logo-mark.png') center / contain no-repeat;
  }
</style>
