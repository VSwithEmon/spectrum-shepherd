---
// Website icon family — check-in-a-circle (client choice, Oct 28, 2026; Figma "Icon v3 (check-circle)" in the
// icon kit `38713:74964`, same look as "Icon / lesson"): pale brand-50 disc, brand-600 ring, bold brand-700
// line glyph. Every icon on the site uses this one style, on light and dark backgrounds alike; the `class`
// prop only sets size and spacing: use 16/20/24/28/32/36/40/48px (size-4…size-12), the Figma icon sizes. Decorative.
export type IconName = 'check' | 'lesson' | 'progress' | 'people' | 'download' | 'shield' | 'spark' | 'report' | 'growth' | 'milestone' | 'route' | 'heart' | 'briefcase' | 'target' | 'prompt' | 'steps';
interface Props { name: IconName; class?: string }
const { name, class: className = 'size-12' } = Astro.props;
// Glyphs on a 24-unit grid, drawn at 26/48 of the icon (as in Figma). `check` is a plain tick: the ring is its circle.
const paths: Record<Exclude<IconName, 'check'>, string> = {
  lesson: '<path d="M12 6.5C10.2 5 7.6 4.5 4 4.5v13c3.6 0 6.2.5 8 2 1.8-1.5 4.4-2 8-2v-13c-3.6 0-6.2.5-8 2z"/><path d="M12 6.5v13"/>',
  progress: '<path d="M3 17l6-6 4 4 8-8"/><path d="M15 7h6v6"/>',
  people: '<circle cx="9" cy="8" r="3.2"/><path d="M3 19.5c.6-3.3 3-5.2 6-5.2s5.4 1.9 6 5.2"/><path d="M15.5 4.9a3.2 3.2 0 0 1 0 6.2M17.6 14.6c1.8.7 3 2.4 3.4 4.9"/>',
  download: '<path d="M12 4v11"/><path d="M7.5 10.5L12 15l4.5-4.5"/><path d="M4.5 16.5v2a1.5 1.5 0 0 0 1.5 1.5h12a1.5 1.5 0 0 0 1.5-1.5v-2"/>',
  shield: '<path d="M12 3l7.5 3v5.5c0 4.6-3.2 8.2-7.5 9.5-4.3-1.3-7.5-4.9-7.5-9.5V6z"/><path d="M8.8 12.2l2.2 2.2 4.2-4.4"/>',
  spark: '<path d="M12 3l2.6 5.6 6 .7-4.5 4.1 1.2 6L12 16.4 6.7 19.4l1.2-6L3.4 9.3l6-.7z"/>',
  report: '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/><path d="M9 17v-3M12 17v-5M15 17v-2"/>',
  growth: '<path d="M12 20v-8"/><path d="M12 12c0-3.9 2.7-6.5 7-6.5 0 4.1-2.8 6.5-7 6.5z"/><path d="M12 14.5c0-3.1-2.2-5.2-6-5.2 0 3.3 2.4 5.2 6 5.2z"/><path d="M7 20h10"/>',
  milestone: '<path d="M6 21V4"/><path d="M6 4.5h11l-2.5 3.5L17 11.5H6"/>',
  route: '<circle cx="6" cy="18" r="2.3"/><circle cx="18" cy="6" r="2.3"/><path d="M8.3 18H15a3.5 3.5 0 0 0 0-7H9a3.5 3.5 0 0 1 0-7h6.7"/>',
  heart: '<path d="M12 20s-7.5-4.6-9.3-9.2C1.4 7.5 3.4 4 7 4c2.1 0 3.6 1.2 5 3 1.4-1.8 2.9-3 5-3 3.6 0 5.6 3.5 4.3 6.8C19.5 15.4 12 20 12 20z"/>',
  briefcase: '<rect x="3" y="7.5" width="18" height="12.5" rx="2"/><path d="M9 7.5V5.5A1.5 1.5 0 0 1 10.5 4h3A1.5 1.5 0 0 1 15 5.5v2"/><path d="M3 12.5h18"/>',
  target: '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.2"/>',
  prompt: '<path d="M4 5h16v11H9l-5 4V5z"/><path d="M8.5 10.5h7"/>',
  steps: '<path d="M3 20h5v-5h5v-5h5V5h3"/>',
};
const glyph = name === 'check'
  ? '<path d="M15.6 24.6l5.4 5.4 11-11.4" stroke-width="3.2"/>'
  : `<g transform="translate(11 11) scale(1.0833)" stroke-width="2.77">${paths[name]}</g>`;
---
<svg aria-hidden="true" class={`shrink-0 ${className}`} viewBox="0 0 48 48" fill="none" stroke-linecap="round" stroke-linejoin="round">
  <circle cx="24" cy="24" r="22.4" class="fill-brand-50 stroke-brand-600" stroke-width="1.6" />
  <g class="stroke-brand-700" set:html={glyph} />
</svg>
