---
// "One platform for everyone in a student's corner" — V4 layout (Figma "Homepage Design (v2) —
// lavender alternative"): three full-width rows, photo alternating left/right, each audience on
// its own soft tint. All visible at once — no tabs, carousel, rotation or labels (Oct 2026 feedback).
import Button from '../Button.astro';
import CheckItem from '../CheckItem.astro';
import FloatingStat from '../FloatingStat.astro';
import { audienceSlides } from '../../data/audiences';
import { site } from '../../data/site';

const hrefs: Record<string, string> = {
  'audience-schools': site.schools,
  'audience-teachers': site.teachersV2,
  'audience-students': site.app,
};
const tints: Record<string, string> = {
  'audience-schools': 'bg-brand-25',
  'audience-teachers': 'bg-lavender-50',
  'audience-students': 'bg-orange-50',
};
---
<section class="px-4 py-16 md:px-8 lg:py-24" aria-labelledby="audiences-title">
  <div class="mx-auto flex max-w-[1200px] flex-col gap-10">
    <h2 id="audiences-title" class="text-center text-display-sm font-bold md:text-display-md lg:text-display-lg">One platform for everyone in a student's corner.</h2>
    <ul class="flex flex-col gap-8">
      {audienceSlides.map((s, i) => (
        <li class={`flex flex-col items-center gap-8 rounded-[32px] p-4 sm:p-6 lg:gap-14 lg:rounded-[40px] ${tints[s.id]} ${i % 2 ? 'lg:flex-row-reverse' : 'lg:flex-row'}`}>
          <div class="relative h-[240px] w-full shrink-0 overflow-hidden rounded-[28px] sm:h-[320px] lg:h-[380px] lg:w-[580px]">
            <img src={s.image.src} alt={s.image.alt} width="1100" height="825" loading="lazy" class="size-full object-cover" />
            <FloatingStat value={s.stat.value} caption={s.stat.caption} class="bottom-5 left-5" />
          </div>
          <div class={`flex w-full flex-col items-start gap-5 px-2 pb-4 sm:px-4 lg:pb-0 ${i % 2 ? 'lg:pl-8' : 'lg:pr-8'}`}>
            <h3 class="text-display-xs font-bold sm:text-display-sm">
              {s.headline.map((line, k) => <Fragment>{line}{k < s.headline.length - 1 && <br />}</Fragment>)}
            </h3>
            <ul class="flex flex-col gap-3 text-lg">
              {s.benefits.map((b) => <CheckItem v2>{b}</CheckItem>)}
            </ul>
            <Button href={hrefs[s.id] ?? s.cta.href}>{s.cta.label}</Button>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
