---
// Closing demo section for homepage V3 (Figma "Book a Demo (#demo) — v3 redesign", client feedback
// Oct 26, 2026): light green → yellow panel, the three approved steps on a numbered path, the demo
// photo on the yellow sun with two product chips, and one dark "Book a Demo" button.
// The form opens on click in a native <dialog> (the client asked for it not to sit on the page).
// Every [data-demo-open] control and every link to #demo on the page opens it; without JavaScript
// the button is an ordinary link to /book-a-demo.
import Button from '../Button.astro';
import FormField from '../FormField.astro';
import StatusChip from '../StatusChip.astro';
import { site } from '../../data/site';

interface Props {
  heading?: string;
  /** Part of the heading shown in brand green (must be the end of `heading`). */
  accent?: string;
  lede?: string;
  /** "Just one teacher?" trial link under the button. */
  trial?: boolean;
  /** Photo on the sun; defaults to the two-teachers photo. */
  image?: string;
}
const {
  heading = 'Be the reason',
  accent = 'they’re ready.',
  lede = 'See how Shepherd works for your students, teachers and school.',
  trial = true,
  image = '/images/photos/demo-teachers.jpg',
} = Astro.props;
const steps = ['Tell us about your school', 'We’ll find a time that works', 'See the platform and ask questions'];
---
<section id="demo" class="scroll-mt-4 px-4 py-16 md:px-8 lg:py-[104px]" aria-labelledby="demo-title">
  <div class="mx-auto grid max-w-[1200px] items-center gap-8 rounded-[32px] border border-brand-100 bg-linear-to-br from-brand-25 to-yellow-50 px-5 py-9 sm:p-10 lg:grid-cols-[1fr_500px] lg:gap-x-14 lg:gap-y-9 lg:rounded-[40px] lg:py-[72px] lg:pr-14 lg:pl-[72px]">
    <div class="flex flex-col gap-4 lg:col-start-1">
      <h2 id="demo-title" class="text-[36px]/[44px] font-bold sm:text-display-lg lg:text-[56px]/[64px]">
        {heading} <span class="text-brand-600">{accent}</span>
      </h2>
      <p class="text-lg text-muted sm:text-xl">{lede}</p>
    </div>

    <div aria-hidden="true" class="relative mx-auto h-[250px] w-full max-w-[340px] sm:h-[420px] sm:max-w-[500px] lg:col-start-2 lg:row-span-3 lg:row-start-1 lg:h-[500px]">
      <span class="absolute top-0 right-0 aspect-square w-[66%] rounded-full bg-yellow-300 sm:top-[2%] sm:right-[4%] sm:w-[80%]"></span>
      <svg class="absolute -top-[5%] right-[-1%] hidden aspect-square w-[94%] sm:block" viewBox="0 0 470 470" fill="none">
        <circle cx="235" cy="235" r="232" class="stroke-brand-600/50" stroke-width="3" stroke-dasharray="1 12" stroke-linecap="round" />
      </svg>
      <img
        src={image}
        width="1100"
        height="733"
        loading="lazy"
        alt=""
        class="absolute top-[12%] left-[3%] aspect-[43/32] w-[86%] rounded-3xl border-[6px] border-white object-cover object-[center_35%] shadow-2xl sm:top-[22%] sm:rounded-[32px] sm:border-8"
      />
      <StatusChip title="Lesson complete" caption="Budgeting for a concert ticket" class="top-[8%] left-[-2%] hidden origin-top-left sm:flex" />
      <StatusChip title="Progress note saved" caption="Linked to IEP goal" class="right-[-2%] bottom-[-2%] origin-bottom-right max-sm:scale-[0.8] sm:bottom-[8%]" />
    </div>

    <ol class="flex flex-col gap-6 lg:col-start-1" aria-label="How booking a demo works">
      {steps.map((s, i) => (
        <li class="relative flex items-center gap-3 sm:gap-4">
          <span aria-hidden="true" class="flex size-10 shrink-0 items-center justify-center rounded-full border-[3px] border-white bg-yellow-300 font-bold sm:size-12 sm:border-4 sm:text-lg">{i + 1}</span>
          <span class="flex-1 rounded-2xl bg-white px-4 py-3 font-semibold shadow-sm sm:rounded-[18px] sm:px-5 sm:py-3.5 sm:text-lg">{s}</span>
          {i < steps.length - 1 && (
            <span aria-hidden="true" class="absolute top-full left-[18px] flex flex-col gap-[3px] py-[3px] sm:left-[22px]">
              <span class="size-1 rounded-full bg-brand-600"></span><span class="size-1 rounded-full bg-brand-600"></span><span class="size-1 rounded-full bg-brand-600"></span>
            </span>
          )}
        </li>
      ))}
    </ol>

    <div class="flex flex-col items-center gap-4 lg:col-start-1 lg:items-start">
      <Button href={site.demo} variant="dark" class="w-full px-7 sm:w-auto sm:text-lg" data-demo-open aria-haspopup="dialog">
        Book a Demo
        <svg aria-hidden="true" class="size-5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10h12M11 5l5 5-5 5" /></svg>
      </Button>
      {trial && (
        <p class="text-center font-semibold lg:text-left">
          Just one teacher? <a href={site.trial} class="text-brand-700 underline hover:text-brand-800">Start a free 45-day trial →</a>
        </p>
      )}
    </div>
  </div>
</section>

<dialog id="demo-dialog" aria-labelledby="demo-dialog-title" class="m-auto w-[min(560px,calc(100vw-32px))] rounded-[32px] p-0 text-ink shadow-2xl backdrop:bg-ink/50">
  <!-- TODO: point action at the form service (or calendar booking) once the client chooses one. -->
  <form method="post" class="flex flex-col gap-4 p-6 sm:p-10">
    <div class="flex items-start justify-between gap-4">
      <div class="flex flex-col gap-1">
        <h2 id="demo-dialog-title" class="text-display-xs font-bold">Book a Demo</h2>
        <p class="text-sm text-muted">Tell us about your school and we’ll find a time that works. All fields are required.</p>
      </div>
      <button type="button" data-demo-close class="flex size-11 shrink-0 items-center justify-center rounded-full bg-brand-25 text-brand-800 hover:bg-brand-50" aria-label="Close">
        <svg aria-hidden="true" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </button>
    </div>
    <div class="grid gap-4 sm:grid-cols-2">
      <FormField id="demo-first-name" label="First name" autocomplete="given-name" required />
      <FormField id="demo-last-name" label="Last name" autocomplete="family-name" required />
    </div>
    <FormField id="demo-email" label="Work email" type="email" placeholder="you@district.org" autocomplete="email" required />
    <FormField id="demo-organization" label="School or district" autocomplete="organization" required />
    <FormField id="demo-role" label="Your role" options={['Special ed director', 'Transition coordinator', 'Principal', 'Teacher', 'Other']} />
    <Button type="submit" variant="dark" full>Book my demo</Button>
    <p class="text-sm text-muted">See our <a href="/privacy" class="text-brand-700 underline hover:text-brand-800">privacy policy</a>.</p>
  </form>
</dialog>

<script>
  const dialog = document.getElementById('demo-dialog') as HTMLDialogElement | null;
  if (dialog && typeof dialog.showModal === 'function') {
    document.addEventListener('click', (e) => {
      const opener = (e.target as HTMLElement).closest('[data-demo-open], a[href="#demo"]');
      if (!opener) return;
      e.preventDefault();
      dialog.showModal();
      dialog.querySelector<HTMLInputElement>('input')?.focus();
    });
    dialog.querySelector('[data-demo-close]')?.addEventListener('click', () => dialog.close());
    // A click on the backdrop (outside the form card) closes it.
    dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
  }
</script>
