<svg aria-hidden="true" focusable="false" viewBox="0 0 1440 784" preserveAspectRatio="xMidYMin slice" class="pointer-events-none absolute inset-x-0 top-0 h-[784px] w-full">
  <defs>
    <linearGradient id="sky-cloud-soft" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#fff" />
      <stop offset="0.97" stop-color="#fcfeff" stop-opacity="0.08" />
    </linearGradient>
    <linearGradient id="sky-cloud" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#fff" />
      <stop offset="0.55" stop-color="#fff" stop-opacity="0.92" />
      <stop offset="1" stop-color="#fff" stop-opacity="0" />
    </linearGradient>
  </defs>
  <path d={cloudTop} fill="url(#sky-cloud-soft)" transform="translate(76.7 213.6) rotate(12) translate(-237.84 -79)" />
  <path d={cloudTower} fill="url(#sky-cloud)" transform="translate(249 330)" />
  <path d={cloudTower} fill="url(#sky-cloud)" transform="translate(1432 310) scale(-1 1)" />
  <path d={cloudWisp} fill="url(#sky-cloud)" transform="translate(470 30)" />
  <path d={cloudWisp} fill="url(#sky-cloud)" transform="translate(1417.6 20) scale(0.875)" />
