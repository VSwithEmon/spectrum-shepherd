    {Object.entries(soft).map(([id, [x1, y1, x2, y2]]) => (
      <linearGradient id={id} x1={x1} y1={y1} x2={x2} y2={y2} gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color="#fff" />
        <stop offset="0.966" stop-color="#fcfeff" stop-opacity="0.08" />
      </linearGradient>
    ))}
    {Object.entries(fade).map(([id, [x, y1, y2]]) => (
      <linearGradient id={id} x1={x} y1={y1} x2={x} y2={y2} gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color="#fff" />
        <stop offset="0.55" stop-color="#fff" stop-opacity="0.92" />
        <stop offset="1" stop-color="#fff" stop-opacity="0" />
      </linearGradient>
    ))}
  </defs>
  {clouds.map((c) => <path d={c.d} fill={`url(#${c.g})`} transform={`translate(${c.x} ${c.y})`} />)}
  {birds.map(([x, y, s, r]) => <path d={bird} fill="#fdfdfd" transform={`translate(${x} ${y}) rotate(${r}) scale(${s})`} />)}
</svg>
