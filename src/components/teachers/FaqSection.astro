---
// Questions (Figma Teachers and Schools): heading on the left, native <details> accordion on the
// right, no script. `name` groups the items so opening one closes the others in supporting browsers.
// 'lines' (Teachers) separates items with rules; 'cards' (Schools) boxes each item, the open one
// outlined in green. Optional intro line and button sit under the heading.
import Button from '../Button.astro';

interface Props {
  id?: string;
  title: string;
  intro?: string;
  cta?: { label: string; href: string };
  variant?: 'lines' | 'cards';
  bg?: string;
  items: { q: string; a: string[] }[];
}
const { id = 'questions', title, intro, cta, variant = 'lines', bg = 'bg-white', items } = Astro.props;
const cards = variant === 'cards';
---
<section id={id} class={`scroll-mt-4 px-4 py-16 md:px-8 lg:py-24 ${bg}`} aria-labelledby={`${id}-title`}>
  <div class="mx-auto grid max-w-[1200px] gap-8 lg:grid-cols-[340px_1fr] lg:gap-[72px]">
    <div class="flex flex-col items-start gap-4">
      <h2 id={`${id}-title`} class="text-display-sm font-bold md:text-display-md">{title}</h2>
      {intro && <p class="text-lg font-medium text-muted">{intro}</p>}
      {cta && <Button href={cta.href} class="mt-2">{cta.label}</Button>}
    </div>
    <div class={cards ? 'flex flex-col gap-3' : 'border-t border-line'}>
      {items.map((it, i) => (
        <details
          name={id}
          open={i === 0}
          class={cards
            ? 'group rounded-[20px] border border-line bg-white px-5 transition-colors open:border-brand-300 sm:px-6'
            : 'group border-b border-line'}
        >
          <summary class={`flex min-h-16 cursor-pointer list-none items-center justify-between gap-6 py-5 font-semibold [&::-webkit-details-marker]:hidden ${cards ? 'text-lg' : 'text-lg sm:text-xl'}`}>
            {it.q}
            <span aria-hidden="true" class="flex size-8 shrink-0 items-center justify-center rounded-full border border-brand-200 bg-brand-25 text-brand-700 transition-colors group-open:border-brand-700 group-open:bg-brand-700 group-open:text-white">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                <path d="M5 12h14" />
                <path class="group-open:hidden" d="M12 5v14" />
              </svg>
            </span>
          </summary>
          <div class={`flex flex-col gap-4 pb-6 text-muted ${cards ? 'text-md' : 'text-md sm:text-lg'}`}>
            {it.a.map((p) => <p>{p}</p>)}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
