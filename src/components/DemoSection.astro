---
// Inline demo form on the current homepage (#demo).
// Figma: "Book a Demo (#demo) — Invitation", node 38613:3826.
import Button from './Button.astro';
import FormField from './FormField.astro';
import { site } from '../data/site';

interface Props {
  /** Oct 2026 feedback (V3/V4): no eyebrow, human headline, varied-size dotted path. */
  refresh?: boolean;
}
const { refresh = false } = Astro.props;
// Varied dot sizes along the trail, echoing the Shepherd swirl (static).
const bez = (t: number, a: number, b: number, c: number, d: number) => (1 - t) ** 3 * a + 3 * (1 - t) ** 2 * t * b + 3 * (1 - t) * t * t * c + t ** 3 * d;
const trailDots = Array.from({ length: 26 }, (_, k) => {
  const t = k / 25;
  return { x: bez(t, 20, 300, 560, 760), y: bez(t, 380, 400, 300, 40), r: Math.max(1.5, (3 + 8 * Math.sin(Math.PI * t) ** 1.5) / 2) };
});

const steps = [
  'Tell us about your program',
  'We reply within one school day to pick a time',
  'Walk through the evidence report, privacy and funding',
];
---
<section id="demo" class={`scroll-mt-4 px-4 md:px-8 lg:py-24 ${refresh ? 'pt-12 pb-4 sm:py-16' : 'py-16'}`} aria-labelledby="demo-title">
  <div class="mx-auto flex max-w-[1200px] flex-col items-center gap-6">
    <div class="on-dark relative flex w-full flex-col gap-10 overflow-hidden rounded-[40px] bg-brand-700 p-6 text-white sm:p-10 lg:flex-row lg:items-start lg:gap-12 lg:p-12">
      <span aria-hidden="true" class="absolute -top-20 -right-20 size-44 rounded-full bg-yellow-300 lg:-top-[110px] lg:-right-[90px] lg:size-[260px] lavender:bg-lavender-200"></span>
      <svg aria-hidden="true" class="absolute -bottom-10 left-0 hidden h-[400px] w-[780px] md:block" viewBox="0 0 780 400" fill="none">
        {refresh
          ? trailDots.map((d) => <circle cx={d.x} cy={d.y} r={d.r} class="fill-brand-400" />)
          : <path d="M20 380C180 330 300 400 470 300S700 120 760 40" class="stroke-brand-400" stroke-width="5" stroke-linecap="round" stroke-dasharray="0 16" />}
      </svg>

      <div class="relative flex flex-col items-start gap-6 lg:flex-1">
        {!refresh && (
          <p class="flex items-center gap-1.5 rounded-full bg-brand-800 px-3 py-1 text-xs font-bold text-yellow-300 calm:text-brand-100">
            <span aria-hidden="true" class="size-2 rounded-full bg-yellow-300"></span>
            BOOK A DEMO
          </p>
        )}
        <h2 id="demo-title" class="text-display-sm font-bold md:text-display-md lg:text-display-lg">{refresh ? 'Be the reason they’re ready.' : 'See Shepherd with your students in mind.'}</h2>
        <p class="text-lg text-brand-50">A 15-minute walkthrough for special education and transition leaders.</p>

        <div class="relative h-[220px] w-full overflow-hidden rounded-3xl">
          <img
            src="/images/photos/demo-host.jpg"
            width="1100"
            height="733"
            loading="lazy"
            alt="Two educators reviewing student progress data together on a laptop"
            class="size-full object-cover object-[center_35%]"
          />
          <span class="absolute bottom-4 left-4 flex items-center gap-2 rounded-full bg-white px-4 py-2 text-sm font-bold text-ink shadow-lg">
            <span aria-hidden="true" class="size-2 rounded-full bg-brand-600"></span>
            15-minute walkthrough
          </span>
        </div>

        <ol class="flex w-full flex-col gap-3" aria-label="How it works">
          {steps.map((s, i) => (
            <li class="flex items-center gap-3 text-lg font-semibold">
              <span aria-hidden="true" class="flex size-9 shrink-0 items-center justify-center rounded-full bg-yellow-300 font-bold text-ink calm:bg-brand-200 lavender:bg-lavender-200">{i + 1}</span>
              {s}
            </li>
          ))}
        </ol>
      </div>

      <!-- TODO: point action at the form service once the client chooses one. -->
      <form method="post" class="on-light relative flex w-full flex-col gap-4 rounded-[32px] bg-white p-6 text-ink shadow-2xl sm:p-10 lg:w-[540px] lg:shrink-0" aria-labelledby="demo-form-title">
        <div class="flex flex-col gap-1">
          <h3 id="demo-form-title" class="text-display-xs font-bold">Book your 15-minute demo</h3>
          <p class="text-sm text-muted">All fields are required.</p>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          <FormField id="first-name" label="First name" autocomplete="given-name" required />
          <FormField id="last-name" label="Last name" autocomplete="family-name" required />
        </div>
        <FormField id="email" label="Work email" type="email" placeholder="you@district.org" autocomplete="email" required />
        <FormField id="organization" label="School or district" autocomplete="organization" required />
        <FormField id="role" label="Your role" options={['Special ed director', 'Transition coordinator', 'Principal', 'Teacher', 'Other']} />
        <Button type="submit" full>Book my demo</Button>
        <p class="text-sm text-muted">We'll reply within one school day to pick a time. See our <a href="/privacy" class="text-brand-700 underline hover:text-brand-800">privacy policy</a>.</p>
      </form>
    </div>

    <p class="flex flex-wrap items-center justify-center gap-x-3 gap-y-1 rounded-full bg-yellow-200 px-6 py-3 text-center font-bold calm:bg-brand-50 lavender:bg-lavender-100">
      Just one teacher?
      <a href={refresh ? site.trial : '#'} class="text-brand-800 underline hover:text-ink">Start a free 45-day trial →</a>
    </p>
  </div>
</section>
