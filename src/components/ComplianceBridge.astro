---
import CheckItem from './CheckItem.astro';
import ReportMock from './ReportMock.astro';
---
<section class="bg-white px-4 py-16 md:px-8 lg:py-24" aria-labelledby="bridge-title">
  <div class="mx-auto flex max-w-[1200px] flex-col items-center gap-12 lg:flex-row lg:gap-16">
    <div class="flex flex-col items-start gap-6 lg:flex-1">
      <p class="flex items-center gap-2 text-sm font-bold text-brand-700">
        <img src="/images/icons/illustrated/bulb.png" width="150" height="204" alt="" class="h-5 w-auto" />
        A NEW STANDARD FOR SPECIAL EDUCATORS
      </p>
      <h2 id="bridge-title" class="text-display-sm font-bold md:text-display-md lg:text-display-lg">Bridge the gap between compliance and independence.</h2>
      <p class="text-lg text-muted">Shepherd turns daily practice into professional evidence, so students build confidence earlier, and you get your time back.</p>
      <ul class="flex flex-col gap-3">
        <CheckItem>Progress tracked against every IEP goal</CheckItem>
        <CheckItem>Indicator 13 evidence, built automatically</CheckItem>
        <CheckItem>Reports ready for your next IEP meeting</CheckItem>
      </ul>
      <a href="#" class="text-lg font-bold text-brand-700 underline hover:text-brand-800">Learn more for schools →</a>
    </div>
    <div class="relative flex w-full max-w-[580px] items-center justify-center overflow-hidden rounded-4xl bg-brand-50 px-4 py-10 sm:px-8 lg:h-[540px] lg:w-[48%] lg:shrink-0 xl:w-[580px]">
      <img src="/images/icons/sun.svg" width="220" height="220" alt="" class="absolute -top-[70px] -right-[60px] size-[220px]" />
      <span aria-hidden="true" class="absolute -top-[70px] -right-[60px] hidden size-[220px] rounded-full bg-brand-200"></span>
      <div class="relative flex w-full justify-center"><ReportMock /></div>
    </div>
  </div>
</section>
