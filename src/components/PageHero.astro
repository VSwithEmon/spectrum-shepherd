---
// Hero shell shared by the homepage and inner pages (Figma "Hero"): copy on the left, a
// page-specific visual on the right (`visual` slot), cloudy sky and tree-topped hills behind.
// The H1 comes in through the `title` slot; anything under the buttons through `extra`.
import Button from './Button.astro';
import Hills from './Hills.astro';
import HeroSky from './HeroSky.astro';

interface Props {
  lede: string;
  primary: { label: string; href: string };
  secondary?: { label: string; href: string };
  /** Big soft sun behind the visual (yellow; lavender on the lavender palette). */
  sun?: boolean;
  /** Visual stacks in normal flow below lg (no fixed square), for visuals that reflow on phones. */
  fluid?: boolean;
}
const { lede, primary, secondary, sun = true, fluid = false } = Astro.props;
---
<section class="hero relative overflow-hidden" aria-labelledby="hero-title">
  <HeroSky />
  <div class="relative z-10 mx-auto flex max-w-[1200px] flex-col items-center gap-12 px-5 pt-6 pb-12 md:px-8 lg:flex-row lg:pt-12 lg:pb-12 xl:px-0">
    <div class="flex w-full flex-col items-start gap-6 lg:flex-1">
      <h1 id="hero-title" class="text-display-lg font-bold">
        <slot name="title" />
      </h1>
      <p class="text-lg font-medium text-muted sm:text-xl">{lede}</p>
      <div class="flex w-full flex-col gap-3 sm:w-auto sm:flex-row sm:flex-wrap">
        <Button href={primary.href}>{primary.label}</Button>
        {secondary && <Button href={secondary.href} variant="secondary">{secondary.label}</Button>}
      </div>
      <slot name="extra" />
    </div>

    <!-- Visual: positions inside are % of the 600×600 Figma frame. -->
    <div class={`relative w-full max-w-[600px] shrink-0 lg:aspect-square lg:w-[600px] ${fluid ? '' : 'aspect-square'}`}>
      {sun && <div aria-hidden="true" class={`pointer-events-none absolute top-[5%] left-[20%] aspect-square w-[76.67%] rounded-full bg-yellow-300 lavender:bg-lavender-200 ${fluid ? 'max-lg:hidden' : ''}`}></div>}
      <slot name="visual" />
    </div>
  </div>

  <Hills class="relative -mt-6 lg:-mt-16" />
</section>

<style>
  /* Sky: Figma hero fill, cream at the top easing into pale green at the horizon. */
  .hero { background: linear-gradient(180deg, #fefaf5 0%, #f4f4ef 10%, #dcefdd 100%); }
</style>
