---
// "Route through real classrooms" (Figma: Logo Band, node 38613:3707).
// The hero's dotted trail continues across the band; schools are pins along it.
// Monograms stand in for the school logo files until the client supplies them.
// Pin x/y come from a 1200-wide composition; the trail SVG is offset/stretched so
// its viewBox x-units line up with the same percentages.
type School = { name: string; mono: string; x: number; y: number; logo?: string; pad?: string; bg?: string };
const schools: School[] = [
  // Add `logo: '/images/logos/<file>.png'` as each school's file arrives (see public/images/logos/).
  // Round seals fill the pin; wide wordmarks get extra `pad` so they fit inside the circle.
  // White logos need a dark pin (`bg`). Burr & Burton uses its emblem only (wordmark too small at 64px).
  { name: 'Burr & Burton Academy', mono: 'BB', x: 100, y: 40, logo: '/images/logos/burr-burton.png', pad: 'p-1.5', bg: 'bg-brand-800' },
  { name: 'Cotting School', mono: 'CS', x: 300, y: 96, logo: '/images/logos/cotting-school.png' },
  { name: 'North Hunterdon', mono: 'NH', x: 500, y: 40, logo: '/images/logos/north-hunterdon.png', pad: 'p-1' },
  { name: 'Kinnelon Schools', mono: 'KS', x: 700, y: 96, logo: '/images/logos/kinnelon.png' },
  { name: 'Voorhees HS', mono: 'VH', x: 900, y: 40, logo: '/images/logos/voorhees.png', pad: 'p-1' },
  { name: 'Newmark Education', mono: 'NE', x: 1100, y: 96, logo: '/images/logos/newmark.png', pad: 'p-1.5' },
];
interface Props {
  /** 'trail' = schools as pins along the dotted trail (V3).
   *  'row' = one centred row of small pins, no trail (V1, Figma node 38859:3992). */
  layout?: 'trail' | 'row';
}
const { layout = 'trail' } = Astro.props;
const row = layout === 'row';

const beats = [
  { lead: 'Built with', word: 'educators.', tilt: row ? 'rotate-2' : '-rotate-2' },
  { lead: 'Tested with', word: 'students.', tilt: row ? '-rotate-2' : 'rotate-2' },
  { lead: 'Shaped in', word: 'classrooms.', tilt: row ? 'rotate-2' : '-rotate-2' },
];
---
<section class="overflow-hidden bg-brand-700 px-4 pt-4 pb-16 text-white md:px-8" aria-labelledby="schools-title">
  <div class="mx-auto flex max-w-[1200px] flex-col items-center gap-10">
    <h2 id="schools-title" class="flex flex-wrap items-center justify-center gap-x-3 gap-y-3 text-center text-xl font-bold sm:text-display-xs md:text-display-sm lg:text-display-md">
      {beats.map((b) => (
        <span class="flex items-center gap-2 sm:gap-3">
          {b.lead}
          <span class={`inline-block rounded-full bg-yellow-300 px-3 py-0.5 text-ink calm:bg-brand-100 sm:px-4 ${b.tilt}`}>{b.word}</span>
        </span>
      ))}
    </h2>

    {row ? (
      <ul class="flex w-full flex-wrap items-start justify-center gap-x-8 gap-y-6 lg:flex-nowrap lg:gap-12" aria-label="Schools that helped shape Shepherd">
        {schools.map((s, i) => (
          <li class="flex w-[calc(50%-16px)] flex-col items-center gap-2 text-center sm:w-[calc(33.333%-22px)] lg:w-auto">
            <span
              aria-hidden="true"
              class={`flex size-[45px] items-center justify-center overflow-hidden rounded-full border-[3px] shadow-lg ${s.bg ?? 'bg-white'} ${i % 2 ? 'border-orange-400' : 'border-yellow-300 calm:border-brand-200'}`}
            >
              {s.logo
                ? <img src={s.logo} width="256" height="256" loading="lazy" alt="" class={`object-contain ${s.bg ? 'size-[29px]' : i % 2 ? 'size-[35px]' : 'size-8'}`} />
                : <span class="text-sm font-bold text-brand-800">{s.mono}</span>}
            </span>
            <span class="text-sm font-bold text-brand-50 sm:text-md lg:whitespace-nowrap">{s.name}</span>
          </li>
        ))}
      </ul>
    ) : (
    <div class="relative w-full lg:h-[200px]">
      <svg
        aria-hidden="true"
        class="absolute top-0 left-[-3.333%] hidden h-[140px] w-[108.333%] lg:block"
        viewBox="-40 0 1300 140"
        preserveAspectRatio="none"
        fill="none"
      >
        <path
          d="M-40 70C20 40 60 40 100 40S240 96 300 96 440 40 500 40 640 96 700 96 840 40 900 40 1040 96 1100 96 1220 70 1260 60"
          class="stroke-yellow-300 calm:stroke-brand-200"
          stroke-width="5"
          stroke-linecap="round"
          stroke-dasharray="0 16"
          vector-effect="non-scaling-stroke"
        />
      </svg>
      <ul class="grid grid-cols-2 gap-x-4 gap-y-6 sm:grid-cols-3 lg:block" aria-label="Schools that helped shape Shepherd">
        {schools.map((s, i) => (
          <li
            class="flex flex-col items-center gap-2 text-center lg:absolute lg:w-[150px] xl:w-[170px] lg:-translate-x-1/2"
            style={`--x:${(s.x / 1200) * 100}%; --y:${s.y - 32}px`}
          >
            {s.logo ? (
              <img
                src={s.logo}
                width="256"
                height="256"
                loading="lazy"
                alt=""
                class={`size-16 rounded-full object-contain shadow-lg ring-4 ${s.bg ?? 'bg-white'} ${s.pad ?? 'p-0.5'} ${i % 2 ? 'ring-orange-400' : 'ring-yellow-300 calm:ring-brand-200'}`}
              />
            ) : (
              <span
                aria-hidden="true"
                class={`flex size-16 items-center justify-center rounded-full bg-white font-bold text-brand-800 shadow-lg ring-4 ${i % 2 ? 'ring-orange-400' : 'ring-yellow-300 calm:ring-brand-200'}`}
              >{s.mono}</span>
            )}
            <span class="text-sm font-bold">{s.name}</span>
          </li>
        ))}
      </ul>
    </div>
    )}
  </div>
</section>

<style>
  @media (min-width: 1024px) {
    li[style] { left: var(--x); top: var(--y); }
  }
</style>
