---
// "Built with educators. Tested with students. Shaped in classrooms." + school logos
// (Figma "Logo Band, Route through real classrooms", node 38876:3867).
// The logo row drifts slowly right → left, the only animation on the site, per the client.
// It pauses on hover/focus and stops (wrapping into a static grid) for reduced motion.
type School = { name: string; logo: string; size: string; bg?: string };
const schools: School[] = [
  // Round seals fill the pin; wide wordmarks sit smaller. White logos need a dark pin (`bg`).
  { name: 'Burr & Burton Academy', logo: '/images/logos/burr-burton.png', size: 'size-[29px]', bg: 'bg-brand-800' },
  { name: 'Cotting School', logo: '/images/logos/cotting-school.png', size: 'size-[35px]' },
  { name: 'North Hunterdon', logo: '/images/logos/north-hunterdon.png', size: 'size-8' },
  { name: 'Kinnelon Schools', logo: '/images/logos/kinnelon.png', size: 'size-[35px]' },
  { name: 'Voorhees HS', logo: '/images/logos/voorhees.png', size: 'size-8' },
  { name: 'Newmark Education', logo: '/images/logos/newmark.png', size: 'size-[29px]' },
];
interface Props {
  /** School logo strip under the tagline. The Teachers page shows the tagline only. */
  logos?: boolean;
}
const { logos = true } = Astro.props;
const beats = [
  { lead: 'Built with', word: 'educators.', tilt: 'rotate-2' },
  { lead: 'Tested with', word: 'students.', tilt: '-rotate-2' },
  { lead: 'Shaped in', word: 'classrooms.', tilt: 'rotate-2' },
];
---
<section class={`overflow-hidden bg-brand-700 text-white ${logos ? 'pt-4 pb-16' : 'py-12 lg:py-14'}`} aria-labelledby="schools-title">
  <div class="mx-auto flex max-w-[1200px] flex-col items-center gap-10">
    <h2 id="schools-title" class="flex flex-wrap items-center justify-center gap-x-3 gap-y-3 px-4 text-center text-xl font-bold sm:text-display-xs md:px-8 md:text-display-sm lg:text-display-md">
      {beats.map((b) => (
        <span class="flex items-center gap-2 sm:gap-3">
          {b.lead}
          <span class={`inline-block rounded-full bg-yellow-300 px-3 py-0.5 text-ink sm:px-4 lavender:bg-lavender-200 ${b.tilt}`}>{b.word}</span>
        </span>
      ))}
    </h2>
  </div>

  {logos && (
  <div class="marquee relative mt-10" aria-label="Schools that helped shape Shepherd" role="region">
    <div class="track flex w-max">
      {[0, 1].map((copy) => (
        <ul class="flex shrink-0 gap-12 pr-12 sm:gap-[72px] sm:pr-[72px]" aria-hidden={copy === 1 ? 'true' : undefined}>
          {schools.map((s, i) => (
            <li class="flex flex-col items-center gap-2 text-center">
              <span
                aria-hidden="true"
                class={`flex size-[45px] items-center justify-center overflow-hidden rounded-full border-[3px] shadow-lg ${s.bg ?? 'bg-white'} ${i % 2 ? 'border-orange-400' : 'border-yellow-300'}`}
              >
                <img src={s.logo} width="256" height="256" loading="lazy" alt="" class={`object-contain ${s.size}`} />
              </span>
              <span class="text-sm font-bold whitespace-nowrap text-brand-50 sm:text-md">{s.name}</span>
            </li>
          ))}
        </ul>
      ))}
    </div>
  </div>
  )}
</section>

<style>
  /* Edge fades into the band colour so logos glide in and out. */
  .marquee::before,
  .marquee::after {
    content: '';
    position: absolute;
    inset-block: 0;
    z-index: 1;
    width: min(200px, 15vw);
    pointer-events: none;
  }
  .marquee::before { left: 0; background: linear-gradient(90deg, var(--color-brand-700), transparent); }
  .marquee::after { right: 0; background: linear-gradient(270deg, var(--color-brand-700), transparent); }

  /* Two identical lists; moving by -50% lands exactly on the start of the copy, so the loop is seamless. */
  .track { animation: marquee 60s linear infinite; }
  .marquee:hover .track,
  .marquee:focus-within .track { animation-play-state: paused; }
  @keyframes marquee { to { transform: translateX(-50%); } }

  @media (prefers-reduced-motion: reduce) {
    .marquee::before, .marquee::after { display: none; }
    .track { animation: none; width: auto; justify-content: center; }
    .track ul { flex-wrap: wrap; justify-content: center; gap: 24px 32px; padding-inline: 16px; }
    .track ul[aria-hidden] { display: none; }
  }
</style>
