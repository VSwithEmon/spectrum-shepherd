---
import Hills from './Hills.astro';

// Footer (Figma "Site / Footer"): tree-topped hills with a setting sun, company logo, link columns, social and legal links.
interface Props {
  /** Draw the hill edge above the footer. Off when the page's last section already ends in hills. */
  hills?: boolean;
  /** Background behind the hills; match the section above. */
  hillsBg?: string;
}
const { hills = true, hillsBg = '' } = Astro.props;

const columns = [
  { title: 'Product', links: [{ label: 'Teachers', href: '/teachers' }, { label: 'Schools', href: '#' }, { label: 'The App', href: '#' }] },
  { title: 'Company', links: [{ label: 'About', href: '#' }, { label: 'Resources', href: '#' }, { label: 'Log in', href: '#' }] },
];
// Social profile URLs still to be supplied by the client.
const social = [
  { label: 'Instagram', icon: '/images/icons/instagram.svg', href: '#' },
  { label: 'Facebook', icon: '/images/icons/facebook.svg', href: '#' },
  { label: 'LinkedIn', icon: '/images/icons/linkedin.svg', href: '#' },
];
---
{hills && <Hills variant="footer" class={hillsBg} />}
<footer class="on-dark relative overflow-hidden bg-brand-800 px-4 pt-12 md:px-8">
  <div class="relative mx-auto max-w-[1200px]">
    <!-- Phones: two columns (brand + Product, Company + community), as in the Figma mobile frame. -->
    <div class="grid grid-cols-2 gap-x-5 gap-y-10 pb-10 lg:grid-cols-[1fr_160px_160px_auto] lg:gap-12 lg:pb-12">
      <div class="flex flex-col gap-3">
        <img src="/images/brand/spectrum-shepherd-white.png" width="174" height="49" alt="Spectrum Shepherd" class="h-10 w-auto self-start sm:h-[49px]" />
        <p class="font-semibold text-brand-50">6 Liberty Square, Boston, MA 02109</p>
        <p class="max-w-[420px] text-brand-50">Proprietary platform designed for IDEA Part B and Title IV-A compliance.</p>
      </div>
      {columns.map((c, i) => (
        <nav aria-labelledby={`footer-${c.title}`} class={i === 1 ? 'max-lg:order-3' : ''}>
          <h2 id={`footer-${c.title}`} class="mb-2 font-bold text-white">{c.title}</h2>
          <ul class="flex flex-col gap-2">
            {c.links.map((l) => <li><a href={l.href} class="text-brand-50 hover:text-white hover:underline">{l.label}</a></li>)}
          </ul>
        </nav>
      ))}
      <div class="flex flex-col gap-4 max-lg:order-4">
        <h2 class="font-bold text-white">Join our community</h2>
        <ul class="flex flex-wrap gap-3">
          {social.map((s) => (
            <li>
              <a href={s.href} aria-label={`Spectrum Shepherd on ${s.label}`} class="flex size-11 items-center justify-center rounded-full bg-white hover:bg-brand-50">
                <img src={s.icon} width="24" height="24" alt="" />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="flex flex-col items-center gap-2 border-t border-brand-600 pt-5 pb-8 text-center text-sm text-brand-50 sm:flex-row sm:justify-between sm:text-left">
      <p>© 2026 Spectrum Shepherd</p>
      <ul class="flex flex-wrap justify-center gap-5">
        <li><a href="/privacy" class="underline hover:text-white">Privacy policy</a></li>
        <li><a href="/terms" class="underline hover:text-white">Terms</a></li>
        <li><a href="/accessibility" class="underline hover:text-white">Accessibility</a></li>
      </ul>
    </div>
  </div>
</footer>
