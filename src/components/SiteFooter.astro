---
// Site footer (Figma component "Site / Footer"): hills with tree silhouettes and a big setting sun,
// then the dark-green footer — logo, address, Product / Company links, social links, legal row.
// Links follow the page set (V3 → v1 pages, V4 → v2 pages).
import HeroHills from './v3/HeroHills.astro';
import { site, type PageSet, pagesV1 } from '../data/site';

interface Props {
  /** Draw the hill edge above the footer. Off when the page's last section already ends in hills. */
  hills?: boolean;
  /** Background behind the hills; match the section above. */
  hillsBg?: string;
  /** Destination set for the Product / Company links. */
  pages?: PageSet;
}
const { hills = true, hillsBg = '', pages = pagesV1 } = Astro.props;

const columns = [
  { title: 'Product', links: [{ label: 'Teachers', href: pages.teachers }, { label: 'Schools', href: pages.schools }, { label: 'The App', href: pages.app }] },
  { title: 'Company', links: [{ label: 'About', href: pages.about }, { label: 'Resources', href: pages.blog }, { label: 'Log in', href: site.login }] },
];
// Social profile URLs still to be supplied by the client.
const social = [
  { label: 'Instagram', icon: '/images/icons/instagram.svg', href: '#' },
  { label: 'Facebook', icon: '/images/icons/facebook.svg', href: '#' },
  { label: 'LinkedIn', icon: '/images/icons/linkedin.svg', href: '#' },
];
---
{hills && <HeroHills sun="setting" class={`h-[100px] sm:h-[140px] lg:h-auto ${hillsBg}`} />}
<footer class="on-dark relative overflow-hidden bg-brand-800 px-4 pt-12 md:px-8">
  <div class="relative mx-auto max-w-[1200px]">
    <div class="flex flex-col gap-12 pb-12 lg:flex-row">
      <div class="flex flex-col gap-3 lg:flex-1">
        <img src="/images/logo-white.png" width="140" height="49" alt="Spectrum Shepherd" class="h-[49px] w-auto self-start" />
        <p class="font-semibold text-brand-50">6 Liberty Square, Boston, MA 02109</p>
        <p class="text-brand-50">Proprietary platform designed for IDEA Part B and Title IV-A compliance.</p>
      </div>
      <div class="flex flex-wrap gap-12">
        {columns.map((c) => (
          <nav aria-labelledby={`footer-${c.title}`} class="w-[160px]">
            <h2 id={`footer-${c.title}`} class="mb-2 font-bold text-white">{c.title}</h2>
            <ul class="flex flex-col gap-2">
              {c.links.map((l) => <li><a href={l.href} class="text-brand-50 hover:text-white hover:underline">{l.label}</a></li>)}
            </ul>
          </nav>
        ))}
        <div class="flex flex-col gap-4">
          <h2 class="font-bold text-white">Join our community</h2>
          <ul class="flex gap-3">
            {social.map((s) => (
              <li>
                <a href={s.href} aria-label={`Spectrum Shepherd on ${s.label}`} class="flex size-11 items-center justify-center rounded-full bg-white hover:bg-brand-50">
                  <img src={s.icon} width="24" height="24" alt="" />
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <div class="flex flex-col gap-3 border-t border-brand-600 pt-5 pb-8 text-sm text-brand-50 sm:flex-row sm:items-center sm:justify-between">
      <p>© 2026 Spectrum Shepherd</p>
      <ul class="flex flex-wrap gap-5">
        <li><a href="/privacy" class="underline hover:text-white">Privacy policy</a></li>
        <li><a href="/terms" class="underline hover:text-white">Terms</a></li>
        <li><a href="/accessibility" class="underline hover:text-white">Accessibility</a></li>
      </ul>
    </div>
  </div>
</footer>
