---
// Schools page — client feedback, Oct 26, 2026 (Figma "Schools — Desktop 1440 (v3) — client feedback
// Oct 26", node 38958:67668), linked from homepage V1. A new page for special education directors,
// built from the homepage and Teachers V3 visual system. Approved copy from the client's document.
// Product visuals are sample data (the client asked us not to imply every feature shown is live);
// the hero is the administrator "Transition program overview" (Figma node 38972:67669).
import Base from '../layouts/Base.astro';
import PageHero from '../components/v3/PageHero.astro';
import LogoMarquee from '../components/v3/LogoMarquee.astro';
import BrandIcon from '../components/v3/BrandIcon.astro';
import EvidenceReport from '../components/v3/EvidenceReport.astro';
import StatPanel from '../components/v3/StatPanel.astro';
import LessonLibrary from '../components/v3/LessonLibrary.astro';
import DemoInvite from '../components/v3/DemoInvite.astro';
import StatusChip from '../components/StatusChip.astro';
import ProgramDashboard from '../components/v3/ProgramDashboard.astro';
import { site } from '../data/site';

const values = [
  { title: 'Consistent transition instruction across classrooms', body: 'Give teachers ready-to-use life skills lessons personalized to each student’s goals, abilities and interests.' },
  { title: 'See progress. Make informed decisions.', body: 'Track student performance and skill development with clear reports that support IEP reviews and transition planning.' },
  { title: 'Give teachers time back', body: 'Reduce lesson preparation and manual documentation so teachers can focus more on students.' },
];
// Product snippets on the value cards (decorative; the card text carries the meaning).
const rooms = ['Room 104', 'Room 112', 'Room 207'];
const barHeights = ['h-[40%]', 'h-[55%]', 'h-[65%]', 'h-[75%]', 'h-[85%]'];
const doneFor = ['Lesson prep', 'Progress notes', 'IEP evidence'];
// "Progress by Skill Area" (client: dashboard from Jess's brochure, progress against targets). Sample data.
const status = {
  on: { label: 'On track', chip: 'bg-success-25 text-brand-700', bar: 'bg-brand-700' },
  ahead: { label: 'Ahead', chip: 'bg-success-25 text-brand-700', bar: 'bg-brand-700' },
  watch: { label: 'Watch', chip: 'bg-warning-25 text-warning-700', bar: 'bg-warning-700' },
  support: { label: 'Needs support', chip: 'bg-error-25 text-error-700', bar: 'bg-error-700' },
};
const skillAreas: { name: string; value: number; target: number; status: keyof typeof status }[] = [
  { name: 'Daily Living & Self-Care', value: 78, target: 80, status: 'on' },
  { name: 'Home Management', value: 64, target: 70, status: 'on' },
  { name: 'Safety & Independence', value: 41, target: 65, status: 'support' },
  { name: 'Civic & Community', value: 72, target: 60, status: 'ahead' },
  { name: 'Social, Digital & Exec Skills', value: 55, target: 70, status: 'watch' },
];
const plans = [
  { initial: 'M', name: 'Maya', goal: 'Budgeting', interest: 'Music', dot: 'bg-yellow-400', level: 'Level 2', tone: 'bg-yellow-100' },
  { initial: 'D', name: 'Devon', goal: 'Self-advocacy', interest: 'Basketball', dot: 'bg-orange-400', level: 'Level 1', tone: 'bg-orange-100' },
  { initial: 'S', name: 'Sam', goal: 'Personal safety', interest: 'Cooking', dot: 'bg-lavender-700', level: 'Level 3', tone: 'bg-periwinkle-100' },
];
const proof = [
  { icon: 'people' as const, value: 'Up to 10', label: 'hours back each week' },
  { icon: 'spark' as const, value: '82%', label: 'found learning more engaging' },
  { icon: 'progress' as const, value: '100%', label: 'of lesson performance tracked' },
];
const points = {
  curriculum: [
    ['Ready-to-use curriculum', 'Age-appropriate life skills lessons teachers don’t have to create from scratch.'],
    ['Individualized learning', 'Lessons personalized to each student’s goals, abilities and interests.'],
    ['Consistent progress tracking', 'Student performance documented automatically as lessons are completed.'],
  ],
  teachers: [
    ['Less preparation', 'Ready-to-use lessons tailored to student needs.'],
    ['Less paperwork', 'Student performance and progress documented automatically.'],
    ['More time for students', 'Teachers can focus on instruction and individual support.'],
  ],
  iep: [
    ['Documented performance', 'Track accuracy, prompting and independent responses.'],
    ['Progress over time', 'See how students are developing skills and where they need additional support.'],
    ['Evidence for decisions', 'Use progress reports to inform IEP discussions and transition planning.'],
  ],
};
const h2 = 'text-display-sm font-bold md:text-display-md lg:text-[44px]/[54px]';
---
<Base
  title="Life skills curriculum and transition progress tracking for schools | Spectrum Shepherd"
  description="Spectrum Shepherd helps schools deliver consistent, personalized life skills instruction, reduce teacher workload and track student progress toward IEP goals."
  demoHref="#demo"
  navUpdated
>
  <PageHero
    title="Empower your teachers."
    accent="Strengthen your transition program."
    lede="Spectrum Shepherd helps schools deliver consistent, personalized life skills instruction, reduce teacher workload and track student progress toward IEP goals."
    primary={{ label: 'Book a Demo', href: site.demo }}
    primaryVariant="dark"
    primaryAttrs={{ 'data-demo-open': '' }}
    secondary={{ label: 'See How It Works', href: '#value' }}
    scene="sky"
    visualClass="lg:h-[484px]"
  >
    <Fragment slot="visual">
      <ProgramDashboard class="relative lg:absolute lg:top-[80px] lg:left-0 lg:w-full" />
      <div class="hidden lg:block">
        <StatusChip title="Progress report ready" caption="For Thursday’s IEP review" class="top-[24px] right-[-4%] z-10" />
      </div>
    </Fragment>
  </PageHero>

  <!-- 2. The value for schools -->
  <section id="value" class="scroll-mt-4 bg-white px-4 py-16 md:px-8 lg:py-[104px]" aria-labelledby="value-title">
    <div class="mx-auto flex max-w-[1200px] flex-col gap-12">
      <h2 id="value-title" class={`text-center ${h2}`}>The value for schools</h2>
      <ul class="grid gap-6 lg:grid-cols-3">
        {values.map((v, i) => (
          <li class="flex flex-col gap-6 rounded-[28px] border border-line bg-white p-7 shadow-md">
            <div aria-hidden="true" class="flex h-[132px] flex-col justify-center gap-2 rounded-2xl bg-white p-4 shadow-md">
              {i === 0 && rooms.map((r) => (
                <p class="flex items-center justify-between gap-3 rounded-lg bg-brand-25 px-2.5 py-1.5 text-[13px] font-semibold">
                  <span>{r}</span>
                  <span class="flex items-center gap-1.5 font-medium"><BrandIcon name="check" class="size-4" />Same lesson, own level</span>
                </p>
              ))}
              {i === 1 && (
                <div class="flex h-full items-end gap-3 px-2.5 pt-2">
                  {barHeights.map((h, k) => <span class={`flex-1 rounded-t-md ${h} ${k === barHeights.length - 1 ? 'bg-brand-600' : 'bg-brand-200'}`}></span>)}
                </div>
              )}
              {i === 2 && doneFor.map((t) => (
                <p class="flex items-center justify-between gap-3 rounded-lg bg-yellow-50 px-2.5 py-1.5 text-[13px] font-semibold">
                  <span>{t}</span>
                  <span class="rounded-full bg-brand-50 px-2 py-0.5 text-xs font-semibold text-brand-800">Done for you</span>
                </p>
              ))}
            </div>
            <div class="flex flex-col gap-3">
              <h3 class="text-xl/[30px] font-bold">{v.title}</h3>
              <p class="text-md text-muted">{v.body}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 3. Student progress and reporting -->
  <section class="bg-brand-25 px-4 py-16 md:px-8 lg:py-[104px]" aria-labelledby="progress-title">
    <div class="mx-auto grid max-w-[1200px] items-center gap-12 lg:grid-cols-[1fr_560px] lg:gap-[72px]">
      <div class="flex flex-col gap-5">
        <h2 id="progress-title" class={h2}>See where students are. Know what comes next.</h2>
        <p class="text-lg/[29px] text-muted">Track student performance and progress toward learning goals. See which skills students are developing, where they need more support and how they’re progressing over time.</p>
      </div>
      <!-- Figma "Visual" is a 470px-tall slot with the card at its top. -->
      <div class="lg:h-[470px]">
      <figure class="flex flex-col gap-4 rounded-3xl border border-line bg-white p-5 shadow-[0_20px_48px_rgb(10_13_18/0.12)] sm:p-6">
        <div class="flex items-center justify-between gap-3">
          <p class="flex flex-col gap-0.5">
            <span class="text-lg/[26px] font-bold">Progress by Skill Area</span>
            <span class="text-xs font-medium text-muted">Lantern Hill School · all classrooms · this term</span>
          </p>
          <span class="rounded-md bg-yellow-300 px-2 py-[3px] text-[10px] font-bold">SAMPLE</span>
        </div>
        <ul class="flex flex-col gap-4">
          {skillAreas.map((s) => (
            <li class="grid grid-cols-[1fr_40px_112px] items-center gap-x-3 gap-y-1.5 sm:grid-cols-[196px_1fr_40px_112px] sm:gap-x-3.5">
              <p class="col-span-3 flex flex-col gap-px sm:col-span-1">
                <span class="block text-[13px]/[18px] font-semibold sm:whitespace-nowrap">{s.name}</span>
                <span class="block text-[11px]/4 text-muted">Target {s.target}%</span>
              </p>
              <span aria-hidden="true" class="relative h-2.5 rounded-[5px] bg-track">
                <span class={`absolute inset-y-0 left-0 rounded-[5px] ${status[s.status].bar}`} style={`width:${s.value}%`}></span>
                <span class="absolute -top-1 h-[18px] w-0.5 bg-ink" style={`left:${s.target}%`}></span>
              </span>
              <span class="text-right text-[13px] font-bold">{s.value}%</span>
              <span class={`rounded-full px-2 py-[3px] text-center text-[10px] font-bold whitespace-nowrap uppercase ${status[s.status].chip}`}>{status[s.status].label}</span>
            </li>
          ))}
        </ul>
        <figcaption class="flex flex-wrap gap-x-4 gap-y-1 text-[11px]/4 text-muted">
          <span class="flex items-center gap-1.5"><span aria-hidden="true" class="h-2 w-5 rounded-full bg-brand-700"></span>Current progress</span>
          <span class="flex items-center gap-1.5"><span aria-hidden="true" class="h-3.5 w-0.5 bg-ink"></span>Target</span>
          <span>Sample data for illustration.</span>
        </figcaption>
      </figure>
      </div>
    </div>
  </section>

  <!-- 4. Consistent instruction across classrooms -->
  <section class="bg-white px-4 py-16 md:px-8 lg:py-[104px]" aria-labelledby="curriculum-title">
    <div class="mx-auto grid max-w-[1200px] items-center gap-12 lg:grid-cols-[600px_1fr] lg:gap-16">
      <div class="flex flex-col gap-5 lg:order-2">
        <h2 id="curriculum-title" class={h2}>One curriculum. Personalized for every student.</h2>
        <p class="text-lg/[29px] text-muted">Give teachers a shared foundation of ready-to-use life skills lessons while allowing instruction to adapt to each student’s goals, abilities and interests.</p>
        <ul class="flex flex-col gap-4 pt-2">
          {points.curriculum.map(([t, b]) => (
            <li class="flex gap-3.5"><BrandIcon name="check" class="mt-0.5 size-7" /><span class="flex flex-col"><span class="text-lg font-bold">{t}</span><span class="text-muted">{b}</span></span></li>
          ))}
        </ul>
      </div>
      <!-- One curriculum feeding three individual plans. The plans are text; the dotted lines are decorative. -->
      <figure class="relative flex flex-col items-center gap-6 lg:order-1 lg:h-[400px] lg:block" aria-label="One shared curriculum, three individual learning plans (sample)">
        <svg aria-hidden="true" class="absolute inset-x-0 top-0 hidden h-[300px] w-full lg:block" viewBox="0 0 600 300" fill="none">
          <path d="M300 92C300 170 98 170 98 250M300 92V250M300 92C300 170 502 170 502 250" class="stroke-brand-600" stroke-width="2" stroke-dasharray="2 6" stroke-linecap="round" />
        </svg>
        <p class="relative flex items-center gap-3 rounded-[18px] bg-brand-800 py-4 pr-6 pl-4 text-white shadow-xl lg:absolute lg:top-5 lg:left-1/2 lg:-translate-x-1/2">
          <BrandIcon name="lesson" class="size-9" />
          <span class="flex flex-col whitespace-nowrap"><span class="font-bold">Life skills curriculum</span><span class="text-xs font-medium text-brand-100">Shared across every classroom</span></span>
        </p>
        <ul class="relative grid w-full gap-3 sm:grid-cols-3 lg:absolute lg:top-[250px] lg:left-0 lg:gap-3">
          {plans.map((p) => (
            <li class={`flex flex-col gap-3 rounded-2xl p-4 shadow-md ${p.tone}`}>
              <p class="flex items-center gap-2.5">
                <span aria-hidden="true" class="flex size-8 shrink-0 items-center justify-center rounded-full bg-white text-sm font-bold">{p.initial}</span>
                <span class="font-bold whitespace-nowrap">{p.name}’s plan</span>
              </p>
              <dl class="grid grid-cols-[auto_1fr] gap-x-3 gap-y-1.5 text-[13px]">
                <dt class="text-muted">Goal</dt><dd class="font-semibold whitespace-nowrap">{p.goal}</dd>
                <dt class="text-muted">Interest</dt><dd class="flex items-center gap-1.5 font-semibold"><span aria-hidden="true" class={`size-2 rounded-full ${p.dot}`}></span>{p.interest}</dd>
                <dt class="text-muted">Level</dt><dd class="font-semibold">{p.level}</dd>
              </dl>
            </li>
          ))}
        </ul>
      </figure>
    </div>
  </section>

  <!-- 5. Supporting teachers -->
  <section class="bg-cream px-4 py-16 md:px-8 lg:py-[104px]" aria-labelledby="teachers-title">
    <div class="mx-auto grid max-w-[1200px] items-center gap-12 lg:grid-cols-[1fr_540px] lg:gap-[72px]">
      <div class="flex flex-col gap-5">
        <h2 id="teachers-title" class={h2}>Give teachers more time to teach.</h2>
        <p class="text-lg/[29px] text-muted">Shepherd reduces the time teachers spend preparing lessons, adapting materials and documenting progress. With personalized lessons and automatic performance tracking, teachers can spend more time working directly with students.</p>
        <ul class="flex flex-col gap-4 pt-2">
          {points.teachers.map(([t, b]) => (
            <li class="flex gap-3.5"><BrandIcon name="check" class="mt-0.5 size-7" /><span class="flex flex-col"><span class="text-lg font-bold">{t}</span><span class="text-muted">{b}</span></span></li>
          ))}
        </ul>
      </div>
      <LessonLibrary />
    </div>
  </section>

  <!-- 6. IEP documentation and transition planning -->
  <section class="bg-brand-25 px-4 py-16 md:px-8 lg:py-[104px]" aria-labelledby="iep-title">
    <div class="mx-auto grid max-w-[1200px] items-center gap-12 lg:grid-cols-[648px_1fr] lg:gap-[72px]">
      <div class="flex flex-col gap-5 lg:order-2">
        <h2 id="iep-title" class={h2}>Walk into every IEP meeting with clearer evidence.</h2>
        <p class="text-lg/[29px] text-muted">Shepherd automatically captures student performance as lessons are completed, giving teachers and administrators documented progress to support IEP reviews, transition planning and instructional decisions.</p>
        <ul class="flex flex-col gap-4 pt-2">
          {points.iep.map(([t, b]) => (
            <li class="flex gap-3.5"><BrandIcon name="check" class="mt-0.5 size-7" /><span class="flex flex-col"><span class="text-lg font-bold">{t}</span><span class="text-muted">{b}</span></span></li>
          ))}
        </ul>
      </div>
      <div class="lg:order-1"><EvidenceReport /></div>
    </div>
  </section>

  <!-- 7. Proof and credibility statistics -->
  <section class="bg-white px-4 pt-16 pb-16 md:px-8 lg:pt-6 lg:pb-[104px]" aria-label="Proof and credibility statistics">
    <div class="mx-auto max-w-[1200px]">
      <StatPanel items={proof} compactMobile />
    </div>
  </section>

  <!-- 8. Educator credibility -->
  <LogoMarquee />

  <!-- 9. Final call to action -->
  <DemoInvite
    heading="See what Shepherd can do for"
    accent="your school."
    lede="See how personalized life skills instruction, automatic progress tracking and clear reporting can support your teachers, students and transition program."
    trial={false}
    chip={{ title: 'Report ready', caption: 'Transition progress, all classrooms' }}
  />
</Base>

