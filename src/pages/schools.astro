---
// Schools page for special education directors: the client's approved V2 brief (26 Oct 2026), built
// in the Homepage and Teachers V2 visual system. Product visuals are illustrative samples and do not
// imply that every feature shown is available or that compliance is guaranteed.
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import StatusChip from '../components/StatusChip.astro';
import LogoBand from '../components/LogoBand.astro';
import StatPanel from '../components/StatPanel.astro';
import DemoSection from '../components/DemoSection.astro';
import AdminDashboard from '../components/schools/AdminDashboard.astro';
import SkillProgress from '../components/schools/SkillProgress.astro';
import CurriculumMap from '../components/schools/CurriculumMap.astro';
import LessonLibrary from '../components/teachers/LessonLibrary.astro';
import EvidenceReport from '../components/teachers/EvidenceReport.astro';

const values = [
  { title: 'Consistent transition instruction across classrooms', body: 'Give teachers ready-to-use life skills lessons personalized to each student’s goals, abilities and interests.', graphic: 'rooms' },
  { title: 'See progress. Make informed decisions.', body: 'Track student performance and skill development with clear reports that support IEP reviews and transition planning.', graphic: 'chart' },
  { title: 'Give teachers time back', body: 'Reduce lesson preparation and manual documentation so teachers can focus more on students.', graphic: 'time' },
];
const curriculum = [
  { icon: 'lesson', title: 'Ready-to-use curriculum', body: 'Age-appropriate life skills lessons teachers don’t have to create from scratch.' },
  { icon: 'target', title: 'Individualized learning', body: 'Lessons personalized to each student’s goals, abilities and interests.' },
  { icon: 'progress', title: 'Consistent progress tracking', body: 'Student performance documented automatically as lessons are completed.' },
];
const teacherTime = [
  { icon: 'lesson', title: 'Less preparation', body: 'Ready-to-use lessons tailored to student needs.' },
  { icon: 'report', title: 'Less paperwork', body: 'Student performance and progress documented automatically.' },
  { icon: 'people', title: 'More time for students', body: 'Teachers can focus on instruction and individual support.' },
];
const iep = [
  { icon: 'prompt', title: 'Documented performance', body: 'Track accuracy, prompting and independent responses.' },
  { icon: 'growth', title: 'Progress over time', body: 'See how students are developing skills and where they need additional support.' },
  { icon: 'milestone', title: 'Evidence for decisions', body: 'Use progress reports to inform IEP discussions and transition planning.' },
];
const stats = [
  { icon: 'people', prefix: 'Up to', value: '10 hrs', label: 'back each week' },
  { icon: 'spark', value: '82%', label: 'found learning more engaging' },
  { icon: 'progress', value: '100%', label: 'of lesson performance tracked' },
];
const rooms = ['Room 104', 'Room 112', 'Room 207'];
const bars = [38, 52, 61, 70, 78];
---
<Base
  title="Life skills curriculum and transition progress for schools | Spectrum Shepherd"
  description="Spectrum Shepherd helps schools deliver consistent, personalized life skills instruction, reduce teacher workload and track student progress toward IEP goals."
>
  <PageHero
    lede="Spectrum Shepherd helps schools deliver consistent, personalized life skills instruction, reduce teacher workload and track student progress toward IEP goals."
    primary={{ label: 'Book a Demo', demo: true }}
    secondary={{ label: 'See How It Works', href: '#how-it-works' }}
    fluid
  >
    <Fragment slot="title">Empower your teachers. <span class="text-brand-600">Strengthen your transition program.</span></Fragment>
    <Fragment slot="visual">
      <AdminDashboard class="relative lg:absolute lg:top-[18%] lg:left-0 lg:w-full" />
      <div class="hidden lg:block">
        <StatusChip title="Progress report ready" caption="For Thursday’s IEP review" class="top-[6%] right-[-2%] z-10" />
      </div>
    </Fragment>
  </PageHero>

  <!-- The value for schools -->
  <section id="how-it-works" class="scroll-mt-4 bg-white px-5 py-16 md:px-8 lg:py-24" aria-labelledby="value-title">
    <div class="mx-auto flex max-w-[1200px] flex-col gap-10 lg:gap-12">
      <h2 id="value-title" class="text-center text-display-sm font-bold md:text-display-md lg:text-display-lg">The value for schools</h2>
      <ul class="grid gap-6 md:grid-cols-3">
        {values.map((v) => (
          <li class="flex flex-col gap-4 rounded-[28px] border border-line bg-cream p-6 sm:p-7">
            <div aria-hidden="true" class="flex h-[132px] flex-col justify-center gap-2 rounded-2xl bg-white p-4 shadow-md">
              {v.graphic === 'rooms' && rooms.map((r) => (
                <p class="flex items-center justify-between gap-2 rounded-lg bg-brand-25 px-2.5 py-1.5 text-xs font-semibold">
                  <span>{r}</span><span class="flex items-center gap-1.5 text-brand-800"><img src="/images/icons/v2/check.svg" width="16" height="16" alt="" class="size-4" />Same lesson, own level</span>
                </p>
              ))}
              {v.graphic === 'chart' && (
                <div class="flex h-full items-end gap-2.5 px-2">
                  {bars.map((b, i) => <span class={`flex-1 rounded-t-md ${i === bars.length - 1 ? 'bg-brand-600' : 'bg-brand-200'}`} style={`height:${b}%`}></span>)}
                </div>
              )}
              {v.graphic === 'time' && ['Lesson prep', 'Progress notes', 'IEP evidence'].map((t) => (
                <p class="flex items-center justify-between rounded-lg bg-yellow-50 px-2.5 py-1.5 text-xs font-semibold">
                  <span>{t}</span><span class="rounded-full bg-brand-50 px-2 text-[11px] text-brand-800">Done for you</span>
                </p>
              ))}
            </div>
            <h3 class="text-xl font-bold">{v.title}</h3>
            <p class="text-muted">{v.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Student progress and reporting -->
  <section class="bg-brand-25 px-5 py-16 md:px-8 lg:py-24" aria-labelledby="progress-title">
    <div class="mx-auto grid max-w-[1200px] items-center gap-12 lg:grid-cols-[460px_1fr] lg:gap-[72px]">
      <div class="flex flex-col gap-5">
        <h2 id="progress-title" class="text-display-sm font-bold md:text-display-md lg:text-display-lg">See where students are. Know what comes next.</h2>
        <p class="text-lg text-muted">Track student performance and progress toward learning goals. See which skills students are developing, where they need more support and how they’re progressing over time.</p>
      </div>
      <SkillProgress />
    </div>
  </section>

  <!-- Consistent instruction across classrooms -->
  <section class="bg-cream px-5 py-16 md:px-8 lg:py-24" aria-labelledby="curriculum-title">
    <div class="mx-auto grid max-w-[1200px] items-center gap-12 lg:grid-cols-[1fr_520px] lg:gap-[72px]">
      <div class="flex flex-col gap-5 lg:order-2">
        <h2 id="curriculum-title" class="text-display-sm font-bold md:text-display-md lg:text-display-lg">One curriculum. Personalized for every student.</h2>
        <p class="text-lg text-muted">Give teachers a shared foundation of ready-to-use life skills lessons while allowing instruction to adapt to each student’s goals, abilities and interests.</p>
        <ul class="flex flex-col gap-4 pt-2">
          {curriculum.map((c) => (
            <li class="flex gap-4">
              <img src={`/images/icons/v2/${c.icon}.svg`} width="48" height="48" alt="" class="size-12 shrink-0" />
              <span class="flex flex-col gap-1"><span class="text-lg font-bold">{c.title}</span><span class="text-muted">{c.body}</span></span>
            </li>
          ))}
        </ul>
      </div>
      <CurriculumMap />
    </div>
  </section>

  <!-- Supporting teachers -->
  <section class="bg-white px-5 py-16 md:px-8 lg:py-24" aria-labelledby="teachers-title">
    <div class="mx-auto grid max-w-[1200px] items-center gap-12 lg:grid-cols-[480px_1fr] lg:gap-[72px]">
      <div class="flex flex-col gap-5">
        <h2 id="teachers-title" class="text-display-sm font-bold md:text-display-md lg:text-display-lg">Give teachers more time to teach.</h2>
        <p class="text-lg text-muted">Shepherd reduces the time teachers spend preparing lessons, adapting materials and documenting progress. With personalized lessons and automatic performance tracking, teachers can spend more time working directly with students.</p>
        <ul class="flex flex-col gap-4 pt-2">
          {teacherTime.map((c) => (
            <li class="flex gap-4">
              <img src={`/images/icons/v2/${c.icon}.svg`} width="48" height="48" alt="" class="size-12 shrink-0" />
              <span class="flex flex-col gap-1"><span class="text-lg font-bold">{c.title}</span><span class="text-muted">{c.body}</span></span>
            </li>
          ))}
        </ul>
      </div>
      <LessonLibrary />
    </div>
  </section>

  <!-- IEP documentation and transition planning -->
  <section class="bg-brand-25 px-5 py-16 md:px-8 lg:py-24" aria-labelledby="iep-title">
    <div class="mx-auto grid max-w-[1200px] items-center gap-12 lg:grid-cols-[480px_1fr] lg:gap-[72px]">
      <div class="flex flex-col gap-5">
        <h2 id="iep-title" class="text-display-sm font-bold md:text-display-md lg:text-display-lg">Walk into every IEP meeting with clearer evidence.</h2>
        <p class="text-lg text-muted">Shepherd automatically captures student performance as lessons are completed, giving teachers and administrators documented progress to support IEP reviews, transition planning and instructional decisions.</p>
        <ul class="flex flex-col gap-4 pt-2">
          {iep.map((c) => (
            <li class="flex gap-4">
              <img src={`/images/icons/v2/${c.icon}.svg`} width="48" height="48" alt="" class="size-12 shrink-0" />
              <span class="flex flex-col gap-1"><span class="text-lg font-bold">{c.title}</span><span class="text-muted">{c.body}</span></span>
            </li>
          ))}
        </ul>
      </div>
      <EvidenceReport />
    </div>
  </section>

  <!-- Proof and credibility statistics -->
  <section class="bg-white px-5 py-12 md:px-8 lg:py-24" aria-label="Results">
    <div class="mx-auto max-w-[1200px]">
      <StatPanel items={stats} />
    </div>
  </section>

  <LogoBand />

  <DemoSection
    title="See what Shepherd can do for your school."
    lede="See how personalized life skills instruction, automatic progress tracking and clear reporting can support your teachers, students and transition program."
    trialLink={false}
  />
</Base>
