---
// Schools page V3 — client feedback, Oct 26, 2026 (Figma "Schools — Desktop 1440 (v3) — client feedback
// Oct 26", node 38958:67668), linked from homepage V3. A new page for special education directors,
// built from the homepage and Teachers V3 visual system. Approved copy from the client's document.
// Product visuals are sample data (the client asked us not to imply every feature shown is live);
// the hero dashboard stands in for the administrator dashboard in Jess's brochure until we have it.
import Base from '../layouts/Base.astro';
import PageHero from '../components/v3/PageHero.astro';
import LogoMarquee from '../components/v3/LogoMarquee.astro';
import BrandIcon from '../components/v3/BrandIcon.astro';
import EvidenceReport from '../components/v3/EvidenceReport.astro';
import StatPanel from '../components/v3/StatPanel.astro';
import LessonLibrary from '../components/v3/LessonLibrary.astro';
import DemoInvite from '../components/v3/DemoInvite.astro';
import StatusChip from '../components/StatusChip.astro';
import { site } from '../data/site';

const values = [
  { title: 'Consistent transition instruction across classrooms', body: 'Give teachers ready-to-use life skills lessons personalized to each student’s goals, abilities and interests.', tint: 'bg-brand-25' },
  { title: 'See progress. Make informed decisions.', body: 'Track student performance and skill development with clear reports that support IEP reviews and transition planning.', tint: 'bg-yellow-50' },
  { title: 'Give teachers time back', body: 'Reduce lesson preparation and manual documentation so teachers can focus more on students.', tint: 'bg-brand-25' },
];
const miniLessons = ['Budgeting for a concert ticket', 'Washing hands', 'Identifying and naming emotions'];
const miniBars = [
  { name: 'Daily living', value: 83, tone: 'bg-brand-700' },
  { name: 'Communication', value: 65, tone: 'bg-brand-700' },
  { name: 'Personal safety', value: 22, tone: 'bg-red-600' },
];
// "Progress by Skill Area" (client: dashboard from Jess's brochure, progress against targets). Sample data.
const status = {
  on: { label: 'On track', chip: 'bg-brand-50 text-brand-800', bar: 'bg-brand-700' },
  ahead: { label: 'Ahead', chip: 'bg-brand-50 text-brand-800', bar: 'bg-brand-700' },
  watch: { label: 'Watch', chip: 'bg-yellow-100 text-yellow-800', bar: 'bg-yellow-400' },
  support: { label: 'Needs support', chip: 'bg-orange-50 text-orange-700', bar: 'bg-orange-700' },
};
const skillAreas: { name: string; value: number; target: number; status: keyof typeof status }[] = [
  { name: 'Daily Living & Self-Care', value: 78, target: 80, status: 'on' },
  { name: 'Home Management', value: 64, target: 70, status: 'on' },
  { name: 'Safety & Independence', value: 41, target: 65, status: 'support' },
  { name: 'Civic & Community', value: 72, target: 60, status: 'ahead' },
  { name: 'Social, Digital & Exec Skills', value: 55, target: 70, status: 'watch' },
];
const plans = [
  { initials: 'BC', name: 'Ben', plan: 'Self-advocacy · Level 2', interests: 'Interests: basketball' },
  { initials: 'JP', name: 'Jordan', plan: 'Emotions · Level 1', interests: 'Interests: music' },
  { initials: 'TM', name: 'Tessa', plan: 'Money skills · Level 3', interests: 'Interests: cooking' },
];
const proof = [
  { icon: 'people' as const, value: 'Up to 10', label: 'hours back each week' },
  { icon: 'spark' as const, value: '82%', label: 'found learning more engaging' },
  { icon: 'progress' as const, value: '100%', label: 'of lesson performance tracked' },
];
const points = {
  curriculum: [
    ['Ready-to-use curriculum', 'Age-appropriate life skills lessons teachers don’t have to create from scratch.'],
    ['Individualized learning', 'Lessons personalized to each student’s goals, abilities and interests.'],
    ['Consistent progress tracking', 'Student performance documented automatically as lessons are completed.'],
  ],
  teachers: [
    ['Less preparation', 'Ready-to-use lessons tailored to student needs.'],
    ['Less paperwork', 'Student performance and progress documented automatically.'],
    ['More time for students', 'Teachers can focus on instruction and individual support.'],
  ],
  iep: [
    ['Documented performance', 'Track accuracy, prompting and independent responses.'],
    ['Progress over time', 'See how students are developing skills and where they need additional support.'],
    ['Evidence for decisions', 'Use progress reports to inform IEP discussions and transition planning.'],
  ],
};
const h2 = 'text-display-sm font-bold md:text-display-md lg:text-[44px]/[54px]';
const accentBar = 'h-1.5 w-14 rounded-full bg-yellow-300';
---
<Base
  title="Life skills curriculum and transition progress tracking for schools — Spectrum Shepherd"
  description="Spectrum Shepherd helps schools deliver consistent, personalized life skills instruction, reduce teacher workload and track student progress toward IEP goals."
  demoHref="#demo"
  navV3
>
  <PageHero
    title="Empower your teachers."
    accent="Strengthen your transition program."
    lede="Spectrum Shepherd helps schools deliver consistent, personalized life skills instruction, reduce teacher workload and track student progress toward IEP goals."
    primary={{ label: 'Book a Demo', href: site.demo }}
    primaryVariant="dark"
    primaryAttrs={{ 'data-demo-open': '' }}
    secondary={{ label: 'See How It Works', href: '#value' }}
    scene="sky"
  >
    <Fragment slot="visual">
      <img
        src="/images/teacher-dashboard-v3.webp"
        width="2080"
        height="1320"
        alt="Shepherd dashboard (sample data) for Lantern Hill School: Classroom Pulse stats, a roster of five students with their latest lessons, and an action queue"
        class="device-shot w-full lg:absolute lg:top-[24%] lg:left-0 lg:w-[92%]"
        fetchpriority="high"
      />
      <div class="hidden lg:block">
        <StatusChip title="Report ready" caption="Transition progress, all classrooms" class="top-[12%] left-[-4%] z-10" />
        <StatusChip title="Needs attention" caption="1 student flagged this week" class="top-[84%] left-[42%] z-10" />
      </div>
    </Fragment>
  </PageHero>

  <!-- 2. The value for schools -->
  <section id="value" class="scroll-mt-4 bg-white px-4 py-16 md:px-8 lg:py-[104px]" aria-labelledby="value-title">
    <div class="mx-auto flex max-w-[1200px] flex-col gap-12">
      <h2 id="value-title" class={`text-center ${h2}`}>The value for schools</h2>
      <ul class="grid gap-6 lg:grid-cols-3">
        {values.map((v, i) => (
          <li class="flex flex-col overflow-hidden rounded-[28px] border border-line bg-white shadow-md">
            <div aria-hidden="true" class={`flex h-[230px] flex-col justify-center gap-2.5 p-7 ${v.tint}`}>
              {i === 0 && miniLessons.map((l) => (
                <p class="flex items-center gap-2.5 rounded-xl border border-line bg-white px-3 py-2">
                  <span class="size-[22px] shrink-0 rounded-full bg-brand-100"></span>
                  <span class="flex flex-col gap-0.5">
                    <span class="text-[13px]/[18px] font-semibold">{l}</span>
                    <span class="w-fit rounded-md bg-brand-50 px-1.5 py-px text-[10px] font-semibold text-brand-800">Linked to IEP goal</span>
                  </span>
                </p>
              ))}
              {i === 1 && (
                <div class="flex flex-col gap-3 rounded-2xl border border-line bg-white p-4">
                  <p class="text-[13px] font-bold">Progress by skill area</p>
                  {miniBars.map((b) => (
                    <div class="flex flex-col gap-1.5">
                      <p class="flex justify-between text-xs"><span class="font-medium text-muted">{b.name}</span><span class="font-bold">{b.value}%</span></p>
                      <span class="h-2 rounded-full bg-line"><span class={`block h-2 rounded-full ${b.tone}`} style={`width:${b.value}%`}></span></span>
                    </div>
                  ))}
                </div>
              )}
              {i === 2 && (
                <div class="flex flex-col items-center gap-3.5">
                  <StatusChip title="Next week is ready" caption="Lessons queued for every student" inline />
                  <StatusChip title="Progress note saved" caption="Linked to IEP goal" inline />
                </div>
              )}
            </div>
            <div class="flex flex-col gap-2.5 p-7 pb-8">
              <span aria-hidden="true" class="h-1 w-10 rounded-full bg-yellow-300"></span>
              <h3 class="text-[22px]/[30px] font-bold">{v.title}</h3>
              <p class="text-md text-muted">{v.body}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 3. Student progress and reporting -->
  <section class="bg-brand-25 px-4 py-16 md:px-8 lg:py-[104px]" aria-labelledby="progress-title">
    <div class="mx-auto grid max-w-[1200px] items-center gap-12 lg:grid-cols-[1fr_560px] lg:gap-[72px]">
      <div class="flex flex-col gap-5">
        <span aria-hidden="true" class={accentBar}></span>
        <h2 id="progress-title" class={h2}>See where students are. Know what comes next.</h2>
        <p class="text-lg text-muted">Track student performance and progress toward learning goals. See which skills students are developing, where they need more support and how they’re progressing over time.</p>
      </div>
      <figure class="flex flex-col gap-4 rounded-3xl border border-line bg-white p-5 shadow-2xl sm:p-6">
        <div class="flex items-start justify-between gap-3">
          <p class="flex flex-col">
            <span class="text-lg font-bold">Progress by Skill Area</span>
            <span class="text-xs font-medium text-muted">Lantern Hill School · all classrooms · this term</span>
          </p>
          <span class="rounded-md bg-yellow-300 px-2 py-0.5 text-xs font-bold">SAMPLE</span>
        </div>
        <ul class="flex flex-col gap-3.5">
          {skillAreas.map((s) => (
            <li class="grid grid-cols-[1fr_40px_auto] items-center gap-x-3 gap-y-1.5 sm:grid-cols-[170px_1fr_40px_auto] sm:gap-x-3.5">
              <p class="col-span-3 sm:col-span-1">
                <span class="block text-sm font-semibold">{s.name}</span>
                <span class="block text-xs text-muted">Target {s.target}%</span>
              </p>
              <span aria-hidden="true" class="relative h-2.5 rounded-full bg-line">
                <span class={`absolute inset-y-0 left-0 rounded-full ${status[s.status].bar}`} style={`width:${s.value}%`}></span>
                <span class="absolute -top-1 h-[18px] w-0.5 bg-ink" style={`left:${s.target}%`}></span>
              </span>
              <span class="text-right text-sm font-bold">{s.value}%</span>
              <span class={`rounded-full px-2 py-0.5 text-center text-[11px] font-bold whitespace-nowrap uppercase ${status[s.status].chip}`}>{status[s.status].label}</span>
            </li>
          ))}
        </ul>
        <figcaption class="flex flex-wrap gap-x-4 gap-y-1 text-xs text-muted">
          <span class="flex items-center gap-1.5"><span aria-hidden="true" class="h-2 w-5 rounded-full bg-brand-700"></span>Current progress</span>
          <span class="flex items-center gap-1.5"><span aria-hidden="true" class="h-3.5 w-0.5 bg-ink"></span>Target</span>
          <span>Sample data for illustration.</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- 4. Consistent instruction across classrooms -->
  <section class="bg-white px-4 py-16 md:px-8 lg:py-[104px]" aria-labelledby="curriculum-title">
    <div class="mx-auto grid max-w-[1200px] items-center gap-12 lg:grid-cols-[540px_1fr] lg:gap-[72px]">
      <div class="flex flex-col gap-5 lg:order-2">
        <span aria-hidden="true" class={accentBar}></span>
        <h2 id="curriculum-title" class={h2}>One curriculum. Personalized for every student.</h2>
        <p class="text-lg text-muted">Give teachers a shared foundation of ready-to-use life skills lessons while allowing instruction to adapt to each student’s goals, abilities and interests.</p>
        <ul class="flex flex-col gap-4 pt-2">
          {points.curriculum.map(([t, b]) => (
            <li class="flex gap-3.5"><BrandIcon name="check" class="mt-0.5 size-7" /><span class="flex flex-col"><span class="text-lg font-bold">{t}</span><span class="text-muted">{b}</span></span></li>
          ))}
        </ul>
      </div>
      <!-- One curriculum feeding three individual plans. The plans are text; lines and sun are decorative. -->
      <figure class="relative flex flex-col items-center gap-6 lg:order-1 lg:h-[470px] lg:block" aria-label="One shared curriculum, three individual learning plans (sample)">
        <span aria-hidden="true" class="absolute top-[120px] left-1/2 hidden size-[220px] -translate-x-1/2 rounded-full bg-yellow-300/60 lg:block"></span>
        <svg aria-hidden="true" class="absolute inset-x-0 top-0 hidden h-[300px] w-full lg:block" viewBox="0 0 540 300" fill="none">
          <path d="M270 92C270 160 80 180 80 250M270 92V300M270 92C270 160 460 180 460 250" class="stroke-brand-600" stroke-width="2" stroke-dasharray="2 6" stroke-linecap="round" />
        </svg>
        <p class="relative flex items-center gap-3 rounded-[18px] bg-brand-800 py-4 pr-6 pl-4 text-white shadow-xl lg:absolute lg:top-5 lg:left-1/2 lg:-translate-x-1/2">
          <BrandIcon name="lesson" class="size-9" />
          <span class="flex flex-col"><span class="font-bold">Life skills curriculum</span><span class="text-xs font-medium text-brand-100">Shared across every classroom</span></span>
        </p>
        <ul class="relative grid w-full gap-3 sm:grid-cols-3 lg:block">
          {plans.map((p, i) => (
            <li class={`flex flex-col gap-1.5 rounded-2xl border border-line bg-white p-3.5 shadow-md lg:absolute lg:w-[160px] ${['lg:top-[250px] lg:left-0', 'lg:top-[300px] lg:left-[190px]', 'lg:top-[250px] lg:left-[380px]'][i]}`}>
              <span class="flex items-center gap-2">
                <span aria-hidden="true" class="flex size-7 items-center justify-center rounded-full bg-brand-50 text-[10px] font-bold text-brand-700">{p.initials}</span>
                <span class="font-bold">{p.name}</span>
              </span>
              <span class="text-[11px] font-bold text-brand-700">Learning plan</span>
              <span class="text-sm font-semibold">{p.plan}</span>
              <span class="text-xs text-muted">{p.interests}</span>
            </li>
          ))}
        </ul>
      </figure>
    </div>
  </section>

  <!-- 5. Supporting teachers -->
  <section class="bg-cream px-4 py-16 md:px-8 lg:py-[104px]" aria-labelledby="teachers-title">
    <div class="mx-auto grid max-w-[1200px] items-center gap-12 lg:grid-cols-[1fr_540px] lg:gap-[72px]">
      <div class="flex flex-col gap-5">
        <span aria-hidden="true" class={accentBar}></span>
        <h2 id="teachers-title" class={h2}>Give teachers more time to teach.</h2>
        <p class="text-lg text-muted">Shepherd reduces the time teachers spend preparing lessons, adapting materials and documenting progress. With personalized lessons and automatic performance tracking, teachers can spend more time working directly with students.</p>
        <ul class="flex flex-col gap-4 pt-2">
          {points.teachers.map(([t, b]) => (
            <li class="flex gap-3.5"><BrandIcon name="check" class="mt-0.5 size-7" /><span class="flex flex-col"><span class="text-lg font-bold">{t}</span><span class="text-muted">{b}</span></span></li>
          ))}
        </ul>
      </div>
      <LessonLibrary />
    </div>
  </section>

  <!-- 6. IEP documentation and transition planning -->
  <section class="bg-brand-25 px-4 py-16 md:px-8 lg:py-[104px]" aria-labelledby="iep-title">
    <div class="mx-auto grid max-w-[1200px] items-center gap-12 lg:grid-cols-[600px_1fr] lg:gap-[72px]">
      <div class="flex flex-col gap-5 lg:order-2">
        <span aria-hidden="true" class={accentBar}></span>
        <h2 id="iep-title" class={h2}>Walk into every IEP meeting with clearer evidence.</h2>
        <p class="text-lg text-muted">Shepherd automatically captures student performance as lessons are completed, giving teachers and administrators documented progress to support IEP reviews, transition planning and instructional decisions.</p>
        <ul class="flex flex-col gap-4 pt-2">
          {points.iep.map(([t, b]) => (
            <li class="flex gap-3.5"><BrandIcon name="check" class="mt-0.5 size-7" /><span class="flex flex-col"><span class="text-lg font-bold">{t}</span><span class="text-muted">{b}</span></span></li>
          ))}
        </ul>
      </div>
      <div class="lg:order-1"><EvidenceReport /></div>
    </div>
  </section>

  <!-- 7. Proof and credibility statistics -->
  <section class="bg-white px-4 pt-16 pb-16 md:px-8 lg:pb-[104px]" aria-label="Proof and credibility statistics">
    <div class="mx-auto max-w-[1200px]">
      <StatPanel items={proof} compactMobile />
    </div>
  </section>

  <!-- 8. Educator credibility -->
  <LogoMarquee />

  <!-- 9. Final call to action -->
  <DemoInvite
    heading="See what Shepherd can do for"
    accent="your school."
    lede="See how personalized life skills instruction, automatic progress tracking and clear reporting can support your teachers, students and transition program."
    trial={false}
  />
</Base>

<style>
  .device-shot { filter: drop-shadow(0 24px 24px rgb(10 13 18 / 0.16)) drop-shadow(0 4px 4px rgb(10 13 18 / 0.04)); }
</style>
