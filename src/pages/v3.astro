---
// Homepage V3 — V1 with the Oct 20, 2026 client feedback applied (Figma "Homepage Design (v1) —
// main direction (yellow accents)" in "Homepage Design( update here)", file kf6bETSiXfVOzzNbTlCFA7).
// Green core, yellow main accent, peach secondary, orange as a small touch.
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import LogoMarquee from '../components/v3/LogoMarquee.astro';
import Results from '../components/v3/Results.astro';
import DownloadBanner from '../components/v3/DownloadBanner.astro';
import AudienceGrid from '../components/v3/AudienceGrid.astro';
import Testimonial from '../components/v3/Testimonial.astro';
import DemoSection from '../components/DemoSection.astro';
---
<Base title="Spectrum Shepherd — AI life-skills coach for students 14–22" demoHref="#demo" designToggle="v3" refresh>
  <Hero
    refresh
    lede="Short, personalized lessons students actually want to do and IEP-ready progress reports their teachers don't have to write."
    ledeWeight="medium"
    trail={false}
  />
  <LogoMarquee />
  <Results />
  <DownloadBanner />
  <AudienceGrid />
  <Testimonial />
  <DemoSection refresh />
</Base>
