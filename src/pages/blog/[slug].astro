---
// Blog article, one static page per published Sanity post.
import { PortableText } from 'astro-portabletext';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/blog/PostCard.astro';
import PtImage from '../../components/blog/PtImage.astro';
import PtLink from '../../components/blog/PtLink.astro';
import DownloadBanner from '../../components/DownloadBanner.astro';
import { getPostsWithBody, imageUrl, categoryTitle, readTime, formatDate, type Post } from '../../lib/blog';

export async function getStaticPaths() {
  const posts = await getPostsWithBody();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post, related: posts.filter((p) => p._id !== post._id && p.category === post.category).concat(posts.filter((p) => p._id !== post._id && p.category !== post.category)).slice(0, 3) },
  }));
}

interface Props { post: Post; related: Post[] }
const { post, related } = Astro.props;
const cover = imageUrl(post.coverImage, 2200, 1238);
---
<Base
  title={`${post.title} | Spectrum Shepherd`}
  description={post.seoDescription || post.excerpt}
  image={imageUrl(post.coverImage, 1200, 630)}
  footerHillsBg={related.length ? 'bg-white' : ''}
>
  <article>
    <header class="bg-cream px-5 pt-8 md:px-8 lg:pt-14">
      <div class="mx-auto flex max-w-[800px] flex-col items-start gap-5">
        <a href="/blog" class="inline-flex min-h-11 items-center gap-2 font-semibold text-brand-700 hover:underline">
          <span aria-hidden="true">←</span> All articles
        </a>
        <p class="rounded-full bg-yellow-100 px-3 py-1 text-xs font-bold text-yellow-800">{categoryTitle(post.category)}</p>
        <h1 class="text-display-sm font-bold text-balance md:text-display-md lg:text-display-lg">{post.title}</h1>
        <p class="text-lg text-muted sm:text-xl">{post.excerpt}</p>
        <div class="flex items-center gap-3 border-t border-line pt-5 text-sm">
          <span aria-hidden="true" class="flex size-11 items-center justify-center rounded-full bg-brand-50 font-bold text-brand-800">{post.authorName?.charAt(0)}</span>
          <p class="flex flex-col">
            <span class="font-semibold">{post.authorName}{post.authorRole && <span class="font-normal text-muted">, {post.authorRole}</span>}</span>
            <span class="text-muted"><time datetime={post.publishedAt}>{formatDate(post.publishedAt)}</time> · {readTime(post.words)}</span>
          </p>
        </div>
      </div>
      <div class="mx-auto mt-10 max-w-[1100px]">
        <img src={cover} width="2200" height="1238" alt={post.coverImage?.alt ?? ''} fetchpriority="high" class="aspect-video h-auto w-full rounded-[28px] object-cover lg:rounded-[40px]" />
      </div>
    </header>

    <div class="bg-cream px-5 pt-12 pb-16 md:px-8 lg:pt-16 lg:pb-24">
      <div class="prose-blog mx-auto max-w-[720px]">
        <PortableText value={post.body} components={{ type: { image: PtImage }, mark: { link: PtLink } }} />
      </div>
    </div>
  </article>

  {related.length > 0 && (
    <section class="bg-white px-5 py-16 md:px-8 lg:py-24" aria-labelledby="more-title">
      <div class="mx-auto flex max-w-[1200px] flex-col gap-8">
        <h2 id="more-title" class="text-display-xs font-bold sm:text-display-sm">More from the blog</h2>
        <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {related.map((p) => <li><PostCard post={p} /></li>)}
        </ul>
      </div>
    </section>
  )}

  <DownloadBanner bg={related.length ? 'bg-white' : 'bg-cream'} />
</Base>
