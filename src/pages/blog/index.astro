---
// Blog index. Posts come from Sanity at build time (edited at /studio); a published post triggers
// a rebuild. Category chips filter the grid in the page; without JavaScript every post still shows.
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/blog/PostCard.astro';
import DownloadBanner from '../../components/DownloadBanner.astro';
import { getPosts } from '../../lib/blog';
import { categories } from '../../sanity/schemaTypes/post';

const posts = await getPosts();
const lead = posts.find((p) => p.featured) ?? posts[0];
const rest = posts.filter((p) => p !== lead);
const used = categories.filter((c) => rest.some((p) => p.category === c.value));
---
<Base
  title="Blog — Spectrum Shepherd"
  description="Ideas, research and classroom stories for special educators building real-world independence with students aged 14–22."
>
  <section class="blog-sky relative overflow-hidden px-5 pt-10 pb-12 md:px-8 lg:pt-16 lg:pb-16" aria-labelledby="blog-title">
    <div class="mx-auto flex max-w-[1200px] flex-col gap-4">
      <h1 id="blog-title" class="text-display-md font-bold lg:text-display-lg">
        The Shepherd blog
      </h1>
      <p class="max-w-[640px] text-lg font-medium text-muted sm:text-xl">Ideas, research and classroom stories for special educators building real-world independence.</p>
    </div>
  </section>

  <section class="bg-cream px-5 pb-16 md:px-8 lg:pb-24" aria-label="Articles">
    <div class="mx-auto flex max-w-[1200px] flex-col gap-10">
      {posts.length === 0 && (
        <div class="flex flex-col items-center gap-3 rounded-[28px] border border-line bg-white px-6 py-16 text-center">
          <img src="/images/icons/v2/lesson.svg" width="48" height="48" alt="" />
          <h2 class="text-display-xs font-bold">New articles are on the way.</h2>
          <p class="max-w-[440px] text-muted">We're writing about transition planning, IEP evidence and teaching life skills. Check back soon.</p>
        </div>
      )}

      {lead && (
        <div>
          <h2 class="sr-only">Featured article</h2>
          <PostCard post={lead} featured headingLevel="h3" />
        </div>
      )}

      {rest.length > 0 && (
        <div class="flex flex-col gap-6">
          <div class="flex flex-wrap items-center justify-between gap-4">
            <h2 class="text-display-xs font-bold">Latest articles</h2>
            {used.length > 1 && (
              <div class="flex flex-wrap gap-2" role="group" aria-label="Filter by category" data-filters hidden>
                <button type="button" data-filter="all" aria-pressed="true" class="chip">All</button>
                {used.map((c) => <button type="button" data-filter={c.value} aria-pressed="false" class="chip">{c.title}</button>)}
              </div>
            )}
          </div>
          <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3" data-posts>
            {rest.map((p) => (
              <li data-category={p.category}><PostCard post={p} /></li>
            ))}
          </ul>
          <p class="sr-only" aria-live="polite" data-filter-status></p>
        </div>
      )}
    </div>
  </section>

  <DownloadBanner bg="bg-cream" />
</Base>

<style>
  .blog-sky { background: linear-gradient(180deg, #fefaf5 0%, #f4f4ef 40%, #fefaf5 100%); }
  .chip {
    min-height: 2.5rem;
    border-radius: 9999px;
    border: 1px solid var(--color-line);
    background: var(--color-white);
    padding: 0.375rem 1rem;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
  }
  .chip:hover { border-color: var(--color-brand-300); }
  .chip[aria-pressed='true'] { border-color: var(--color-brand-700); background: var(--color-brand-700); color: var(--color-white); }
</style>

<script>
  // Category filter: shows the chips only when JS runs, so the full list is always reachable.
  const group = document.querySelector<HTMLElement>('[data-filters]');
  const items = [...document.querySelectorAll<HTMLElement>('[data-posts] > li')];
  const status = document.querySelector<HTMLElement>('[data-filter-status]');
  if (group) {
    group.hidden = false;
    group.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-filter]');
      if (!btn) return;
      const f = btn.dataset.filter;
      group.querySelectorAll('[data-filter]').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      let shown = 0;
      items.forEach((li) => {
        const on = f === 'all' || li.dataset.category === f;
        li.hidden = !on;
        if (on) shown++;
      });
      if (status) status.textContent = `${shown} article${shown === 1 ? '' : 's'} shown`;
    });
  }
</script>
