---
// Beyond the Transition Plan v1 — Figma "Beyond the Transition Plan (research) — v1" (Oct 2026; node 38894:83179),
// linked from homepage V1. Wording and study figures from
// spectrumshepherd.com/beyond-the-transition-plan. Yellow accents.
import Base from '../layouts/Base.astro';
import HeroHills from '../components/v3/HeroHills.astro';
import SkyDecor from '../components/v3/SkyDecor.astro';
import { site } from '../data/site';

const questions = [
  'Do assessments shape meaningful goals?',
  'Do those goals drive instruction?',
  'Do students practice relevant skills in authentic settings?',
  'Can teams see progress?',
  'Are adult systems connected early enough?',
];
const studies = [
  { source: 'Tennessee Educator Study | 2026', value: '12.9%', label: 'of surveyed educators reported planning work-based activities at job sites.', body: 'The study included 185 special education teachers across 57 Tennessee districts. While 93% reported writing IEPs and transition plans, reported job-site work experiences were much less common.', caveat: 'One-state evidence, not a national prevalence estimate.' },
  { source: 'Findley, Ruble & McGrew | 2022', value: '< 25%', label: 'of IEPs included an annual goal addressing a documented social-skill or behavior need.', body: 'In a study of 20 autistic students across two states, more than two thirds of IEPs documented a need, but fewer than one quarter included a corresponding annual goal.', caveat: 'Small sample, not a national prevalence estimate.' },
];
const ladder = [
  { text: 'Plan presence', box: 'bg-brand-50 text-brand-800' },
  { text: 'plan quality', box: 'bg-brand-200 text-brand-900' },
  { text: 'plan execution', box: 'bg-yellow-300 text-ink lavender:bg-lavender-200' },
];
---
<Base
  title="Beyond the Transition Plan — special education transition research — Spectrum Shepherd"
  description="What the evidence says about moving from compliant planning to coherent preparation for adult life."
>
  <section class="relative overflow-hidden bg-linear-to-b from-cream via-haze via-10% to-mist" aria-labelledby="page-title">
    <SkyDecor />
    <HeroHills class="absolute inset-x-0 bottom-0 h-[81px] sm:h-[140px] lg:h-auto" />
    <div class="relative z-10 mx-auto flex max-w-[1200px] flex-col items-center gap-12 px-4 pt-10 pb-28 sm:pb-32 md:px-8 lg:flex-row lg:gap-20 lg:pt-16 lg:pb-[190px] xl:px-0">
      <div class="flex w-full flex-col items-start gap-5 lg:flex-1">
        <p class="text-sm font-bold tracking-wide text-brand-700">SPECTRUM SHEPHERD RESEARCH</p>
        <h1 id="page-title" class="text-display-md font-bold sm:text-display-lg lg:text-display-xl">Beyond the <span class="text-brand-600">Transition Plan</span></h1>
        <p class="text-lg font-semibold sm:text-xl">What the evidence says about moving from compliant planning to coherent preparation for adult life.</p>
        <p class="text-lg text-muted">A research synthesis on transition-plan quality, implementation capacity, functional readiness, and the systems that shape life after school.</p>
        <a href={site.whitePaper} class="mt-2 inline-flex min-h-12 items-center gap-3 rounded-full bg-brand-700 py-2 pr-6 pl-2 font-semibold text-white shadow-button hover:bg-brand-800">
          <span aria-hidden="true" class="flex size-10 items-center justify-center rounded-full bg-white text-brand-700">
            <svg class="size-5" viewBox="0 0 16 17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 0v12M3 7l5 5 5-5M1 16h14" /></svg>
          </span>
          Download the full white paper (PDF)
        </a>
      </div>
      <div class="relative flex h-[480px] w-full max-w-[420px] shrink-0 items-start justify-center lg:w-[420px]">
        <span aria-hidden="true" class="absolute top-10 left-[80px] hidden size-[360px] rounded-full sm:block bg-yellow-300/90 lavender:bg-lavender-200/90"></span>
        <span aria-hidden="true" class="absolute top-[50px] left-[90px] hidden h-[404px] w-[300px] -rotate-[8deg] rounded-lg bg-brand-50 shadow-xl sm:block"></span>
        <img src="/images/photos/whitepaper-cover.jpg" width="720" height="960" alt="Cover of the Spectrum Shepherd research white paper “Beyond the Transition Plan”, August 2026" class="relative mt-10 ml-[40px] h-[404px] w-[300px] rotate-3 self-start rounded-lg object-cover shadow-2xl" />
        <span class="absolute bottom-6 left-0 rounded-full bg-white px-3.5 py-2 text-sm font-semibold text-brand-800 shadow-lg">August 2026 · PDF</span>
      </div>
    </div>
  </section>

  <section class="on-dark bg-brand-700 px-4 py-16 text-white md:px-8 lg:py-[88px]" aria-label="Key quote">
    <figure class="mx-auto flex max-w-[960px] flex-col items-center gap-6 text-center">
      <blockquote class="text-display-xs font-bold sm:text-display-sm lg:text-display-md">“Indicator 13 was originally designed to address compliance, not quality… a compliant IEP may not be high quality.”</blockquote>
      <figcaption class="text-sm text-brand-50 sm:text-md">Findley, Ruble &amp; McGrew (2022), study of transition-age autistic students — <i>Research in Autism Spectrum Disorders</i></figcaption>
    </figure>
  </section>

  <section class="bg-haze px-4 py-16 md:px-8 lg:py-[104px]" aria-labelledby="execution-title">
    <div class="mx-auto grid max-w-[1200px] items-start gap-12 lg:grid-cols-[1fr_440px] lg:gap-16">
      <div class="flex flex-col gap-5">
        <h2 id="execution-title" class="text-display-sm font-bold md:text-display-md lg:text-display-lg">The next challenge in transition is execution.</h2>
        <p class="text-lg text-muted">Transition planning is now broadly established in special education. <strong class="font-semibold text-ink">The harder question is what happens after the plan is written.</strong></p>
        <ol class="flex flex-col gap-3 pt-2">
          {questions.map((q, i) => (
            <li class="flex items-center gap-4 rounded-2xl bg-white py-3.5 pr-5 pl-4">
              <span aria-hidden="true" class="flex size-9 shrink-0 items-center justify-center rounded-full bg-brand-50 text-sm font-semibold text-brand-800">{String(i + 1).padStart(2, '0')}</span>
              <span class="text-lg font-semibold">{q}</span>
            </li>
          ))}
        </ol>
      </div>
      <div class="on-dark flex flex-col items-center gap-3.5 rounded-[32px] bg-brand-800 px-9 py-10 text-center text-white">
        <h3 class="text-sm font-bold tracking-wide text-yellow-300 lavender:text-lavender-200">A USEFUL DISTINCTION</h3>
        <ul class="flex w-full flex-col items-center gap-3.5">
          {ladder.map((s, i) => (
            <Fragment>
              <li class={`w-full rounded-2xl py-4 text-display-xs font-bold ${s.box}`}>{s.text}</li>
              {i < ladder.length - 1 && <li aria-hidden="true" class="flex size-10 items-center justify-center rounded-full bg-white/12 text-xl font-semibold">≠</li>}
            </Fragment>
          ))}
        </ul>
        <p class="text-brand-50">Compliance is necessary, but compliance and quality are not the same construct.</p>
      </div>
    </div>
  </section>

  <section class="px-4 py-16 md:px-8 lg:pt-[104px] lg:pb-16" aria-labelledby="research-title">
    <div class="mx-auto flex max-w-[1200px] flex-col items-center gap-10">
      <h2 id="research-title" class="text-center text-display-sm font-bold md:text-display-md lg:text-display-lg">What the research shows</h2>
      <ul class="grid w-full gap-6 lg:grid-cols-2">
        {studies.map((s) => (
          <li class="flex min-w-0 flex-col gap-4 rounded-[32px] border border-line bg-white p-6 shadow-lg sm:p-9">
            <p class="self-start rounded-full bg-brand-50 px-3 py-1 text-sm font-semibold text-brand-800">{s.source}</p>
            <p class="flex flex-col items-start gap-2 sm:flex-row sm:items-center sm:gap-5">
              <span class="text-[56px]/none font-bold whitespace-nowrap text-brand-700 lg:text-[64px]">{s.value}</span>
              <span class="text-lg font-semibold">{s.label}</span>
            </p>
            <hr class="border-line" />
            <p class="text-muted">{s.body} <span class="text-sm">{s.caveat}</span></p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="px-4 pt-6 pb-16 md:px-8 lg:pb-28" aria-labelledby="download-title">
    <div class="mx-auto flex max-w-[1200px] flex-col items-center gap-8 rounded-[40px] bg-brand-50 p-8 sm:p-14 md:flex-row md:gap-14">
      <img src="/images/photos/whitepaper-cover.jpg" width="720" height="960" loading="lazy" alt="" class="h-[229px] w-[170px] shrink-0 -rotate-3 rounded-md object-cover shadow-lg" />
      <div class="flex flex-col items-start gap-3.5">
        <h2 id="download-title" class="text-display-xs font-bold md:text-display-md">Beyond the Transition Plan</h2>
        <p class="text-lg text-muted">A research synthesis on plan quality, implementation, and systems for successful futures.</p>
        <a href={site.whitePaper} class="mt-2 inline-flex min-h-12 items-center gap-3 rounded-full bg-brand-700 py-2 pr-6 pl-2 font-semibold text-white shadow-button hover:bg-brand-800">
          <span aria-hidden="true" class="flex size-10 items-center justify-center rounded-full bg-white text-brand-700">
            <svg class="size-5" viewBox="0 0 16 17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 0v12M3 7l5 5 5-5M1 16h14" /></svg>
          </span>
          Download the full white paper (PDF)
        </a>
      </div>
    </div>
  </section>
</Base>
