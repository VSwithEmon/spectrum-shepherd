---
// Schools page v2 — Figma "Schools — v2" (Oct 2026; node 38854:81539), linked from the lavender homepage (V2).
// Wording from spectrumshepherd.com/forschools. Every yellow accent is lavender here (`palette="lavender"`).
import Base from '../layouts/Base.astro';
import BrandIcon from '../components/v3/BrandIcon.astro';
import CtaPanel from '../components/v3/CtaPanel.astro';
import FaqSection from '../components/v3/FaqSection.astro';
import SchoolsHero from '../components/v3/SchoolsHero.astro';
import { schoolsFaqs } from '../data/faqs';
import { site } from '../data/site';

const benefits = [
  { icon: 'report' as const, title: 'Simplify IEP transitions', body: 'Turn daily student app usage into professional, auditable progress notes. Our system generates One-Click Reports tied directly to transition goals, capturing objective data on Prompt Levels, Accuracy, and Self-Initiation.' },
  { icon: 'growth' as const, title: 'Less admin. More teaching.', body: 'Reduce administrative burnout by allowing our platform to handle differentiation and immediate feedback. This allows your teachers to reclaim their instructional bandwidth and focus on their students rather than manual data entry.' },
  { icon: 'milestone' as const, title: 'Built for the world after school', body: 'Move students from prompt-dependency toward durable self-initiation. Our platform uses a Special Interests Engine to make life-skill tasks intrinsically rewarding, ensuring skills generalize into adult life.' },
];
const reach = [
  { icon: 'route' as const, title: 'The path to employment', body: 'Our architecture allows employer training content to be translated through our platform, creating a seamless transition from the classroom to the workforce.' },
  { icon: 'briefcase' as const, title: 'Strategic workforce integration', body: 'Embedding Spectrum Shepherd into transitional programs today facilitates future hiring and training with our B2B employer partners.' },
];
const markers = [
  { icon: 'target' as const, title: 'Accuracy', body: 'Success rates on specific life-skill task steps.' },
  { icon: 'prompt' as const, title: 'Prompt level', body: 'The degree of support required — visual, verbal or physical.' },
  { icon: 'steps' as const, title: 'Self-initiation', body: 'The frequency of task starts without external prompting.' },
];
---
<Base
  palette="lavender"
  title="Transition and functional skills platform for schools — Spectrum Shepherd"
  description="Empower your teachers and automate your compliance: personalized transition lessons and audit-ready evidence for special education programs."
>
  <SchoolsHero />

  <section class="px-4 py-16 md:px-8 lg:py-24" aria-labelledby="values-title">
    <div class="mx-auto flex max-w-[1200px] flex-col items-center gap-12 lg:gap-14">
      <h2 id="values-title" class="max-w-[900px] text-center text-display-sm font-bold md:text-display-md lg:text-display-lg">Skills that stick. Paperwork that writes itself.</h2>
      <div class="grid w-full items-center gap-10 lg:grid-cols-[560px_1fr] lg:gap-16">
        <!-- Photo + video collage (large screens); stacked on phones. -->
        <div class="relative flex flex-col gap-5 lg:block lg:h-[540px]">
          <span aria-hidden="true" class="absolute top-[60px] left-[140px] hidden size-[380px] rounded-full bg-yellow-300/55 lg:block lavender:bg-lavender-200/55"></span>
          <img src="/images/photos/schools-overview.jpg" width="1100" height="614" loading="lazy" alt="A teacher and a student working through a Shepherd lesson together at a laptop" class="relative aspect-[500/330] w-full rounded-[28px] border-8 border-brand-600 object-cover shadow-xl lg:absolute lg:top-[10px] lg:left-0 lg:w-[500px] lg:rotate-2" />
          <!-- TODO: swap the still for the real 0:57 Schools overview video once the client supplies it. -->
          <figure class="relative aspect-[400/250] w-full overflow-hidden rounded-3xl border-[6px] border-white shadow-xl lg:absolute lg:top-[280px] lg:left-[150px] lg:w-[400px] lg:-rotate-2">
            <img src="/images/photos/audience-schools.jpg" width="1100" height="826" loading="lazy" alt="Teacher with a group of young students around a classroom table, from the Schools overview video" class="size-full object-cover" />
            <span aria-hidden="true" class="absolute inset-0 bg-linear-to-t from-ink/65 via-transparent to-transparent"></span>
            <span aria-hidden="true" class="absolute top-1/2 left-1/2 flex size-[72px] -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-white shadow-xl">
              <svg class="ml-1 size-7 text-brand-700" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13l11-6.5z" /></svg>
            </span>
            <figcaption class="absolute bottom-3 left-4 rounded-full bg-ink/75 px-3 py-1 text-sm font-semibold text-white">Watch · 0:57</figcaption>
          </figure>
        </div>
        <ul>
          {benefits.map((b) => (
            <li class="flex gap-5 border-b border-line py-6 first:pt-0 last:border-b-0 last:pb-0">
              <BrandIcon name={b.icon} />
              <div class="flex flex-col gap-1.5">
                <h3 class="text-xl font-bold">{b.title}</h3>
                <p class="text-muted">{b.body}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <CtaPanel
    id="briefing"
    variant="clouds"
    title="Request a 15-minute briefing"
    body="See how a growing group of prestigious programs are using Shepherd to exceed family expectations and lead the transition conversation."
    primary={{ label: 'Book a 15-min briefing', href: site.demo }}
  />

  <section class="bg-haze px-4 py-16 md:px-8 lg:py-24" aria-labelledby="journey-title">
    <div class="mx-auto flex max-w-[1200px] flex-col items-center gap-12">
      <h2 id="journey-title" class="max-w-[840px] text-center text-display-sm font-bold md:text-display-md lg:text-display-lg">Beyond the classroom: lifelong readiness</h2>
      <div class="grid w-full gap-6 lg:grid-cols-[588px_1fr]">
        <div class="on-dark relative flex flex-col gap-4 overflow-hidden rounded-[32px] bg-brand-800 p-8 text-white lg:p-11">
          <span aria-hidden="true" class="absolute top-[180px] left-[330px] hidden size-[360px] rounded-full border-[48px] border-white/8 lg:block"></span>
          <BrandIcon name="heart" class="relative" />
          <p class="relative flex flex-wrap items-baseline gap-x-3">
            <span class="text-[72px]/none font-bold text-yellow-300 lg:text-[96px] lavender:text-lavender-200">14</span>
            <span class="text-lg text-brand-50">years old — where we start</span>
          </p>
          <h3 class="relative text-display-sm font-bold">The lifelong companion</h3>
          <p class="relative max-w-[480px] text-lg text-brand-50">We enter the picture at age 14 to build momentum long before school support ends, remaining as a lifelong digital lifeline after the school system steps away.</p>
        </div>
        <ul class="flex flex-col gap-6">
          {reach.map((r) => (
            <li class="flex flex-1 gap-5 rounded-[32px] border border-line bg-white p-8 lg:p-9">
              <BrandIcon name={r.icon} />
              <div class="flex flex-col gap-2">
                <h3 class="text-display-xs font-bold">{r.title}</h3>
                <p class="text-muted">{r.body}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section id="outcomes" class="scroll-mt-4 bg-white px-4 py-16 md:px-8 lg:py-24" aria-labelledby="outcomes-title">
    <div class="on-dark relative mx-auto flex max-w-[1200px] flex-col gap-10 overflow-hidden rounded-3xl bg-brand-800 p-6 text-white sm:p-10 md:rounded-[32px] lg:p-16">
      <span aria-hidden="true" class="swirl pointer-events-none absolute -top-20 -right-16 size-[320px] bg-white opacity-[0.07] lg:-top-36 lg:right-[-40px] lg:size-[520px]"></span>
      <div class="relative flex flex-col gap-3">
        <h2 id="outcomes-title" class="text-display-sm font-bold md:text-display-md lg:text-display-lg">Measurable outcomes for every student</h2>
        <p class="text-lg text-brand-50 sm:text-xl">We don’t just track participation; we measure the independence markers.</p>
      </div>
      <ul class="relative grid md:grid-cols-[345fr_382fr_346fr]">
        {markers.map((m, i) => (
          <li class={`flex flex-col gap-3.5 py-6 md:py-0 ${i ? 'border-t border-brand-700 md:border-t-0 md:border-l md:pl-9' : ''} ${i < markers.length - 1 ? 'md:pr-9' : ''}`}>
            <BrandIcon name={m.icon} />
            <h3 class="text-display-xs font-bold">{m.title}</h3>
            <span aria-hidden="true" class="h-1 w-12 rounded-full bg-yellow-300 lavender:bg-lavender-200"></span>
            <p class="text-lg font-medium text-brand-50">{m.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <FaqSection
    title="Questions schools ask"
    intro="Transition curriculum, IEP evidence and teacher workload — answered."
    cta={{ label: 'Book a 15-min briefing', href: site.demo }}
    items={schoolsFaqs}
  />
</Base>

<style>
  .swirl {
    mask: url('/images/logo-mark.png') center / contain no-repeat;
    -webkit-mask: url('/images/logo-mark.png') center / contain no-repeat;
  }
</style>
