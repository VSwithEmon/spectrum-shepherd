---
// Webinars v2 — Figma "Webinars — v2" (Oct 2026; node 38883:82960), linked from the lavender homepage (V4).
// The four on-demand sessions listed on spectrumshepherd.com/webinars; the videos still live there.
import Base from '../layouts/Base.astro';
import CtaPanel from '../components/v3/CtaPanel.astro';
import { webinars } from '../data/webinars';
import { site } from '../data/site';

// Live thumbnails, in the same order as the webinars. The first two are infographics (shown whole).
const thumbs = [
  { src: '/images/webinars/paraprofessionals.jpg', fit: 'object-contain bg-haze' },
  { src: '/images/webinars/esy.jpg', fit: 'object-contain bg-haze' },
  { src: '/images/webinars/speaker.jpg', fit: 'object-cover object-top' },
  { src: '/images/webinars/speaker.jpg', fit: 'object-cover object-top' },
];
---
<Base
  palette="lavender"
  title="Webinars for special education and transition teams — Spectrum Shepherd"
  description="Short, practical on-demand sessions for special education and transition teams — most are “5 in 25”: five strategies you can use tomorrow, in 25 minutes."
>
  <section class="bg-cream px-4 pt-12 pb-8 md:px-8 lg:pt-14" aria-labelledby="webinars-title">
    <div class="mx-auto flex max-w-[1200px] flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div class="flex flex-col items-start gap-3">
        <p class="flex items-center gap-2 rounded-full border border-brand-200 bg-brand-50 px-3.5 py-1.5 text-sm font-semibold text-brand-800">
          <span aria-hidden="true" class="size-2 rounded-full bg-brand-600"></span>Webinars
        </p>
        <h1 id="webinars-title" class="text-display-md font-bold sm:text-display-lg">Watch <span class="text-brand-600">on demand</span></h1>
      </div>
      <p class="font-semibold text-muted">{webinars.length} sessions</p>
    </div>
  </section>

  <section class="bg-cream px-4 pb-16 md:px-8 lg:pb-24" aria-label="On-demand webinars">
    <ul class="mx-auto grid max-w-[1200px] gap-6 lg:grid-cols-2">
      {webinars.map((w, i) => (
        <li class="relative flex flex-col overflow-hidden rounded-[28px] border border-line bg-white shadow-lg sm:flex-row">
          <div class="relative aspect-[4/3] shrink-0 sm:aspect-auto sm:w-[232px]">
            <img src={thumbs[i].src} width="900" height="900" loading="lazy" alt="" class={`size-full ${thumbs[i].fit}`} />
            <span aria-hidden="true" class="absolute bottom-4 left-4 flex size-14 items-center justify-center rounded-full bg-white shadow-xl">
              <svg class="ml-0.5 size-6 text-brand-700" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13l11-6.5z" /></svg>
            </span>
          </div>
          <div class="flex flex-1 flex-col items-start gap-3 p-6 sm:p-7">
            <p class="flex items-center gap-1.5 text-sm font-semibold text-brand-700">
              <svg aria-hidden="true" class="size-2.5" viewBox="0 0 10 10" fill="currentColor"><path d="M0 0l9 5-9 5z" /></svg>Watch on demand
            </p>
            <ul class="flex flex-wrap gap-1.5" aria-label="Topics">
              {w.tags.map((t) => <li class="rounded-full bg-haze px-2.5 py-1 text-xs font-bold text-brand-700">{t}</li>)}
            </ul>
            <h2 class="text-xl font-semibold">{w.title}</h2>
            <p class="text-sm text-muted">{w.description}</p>
            <a href={w.url} class="mt-auto inline-flex min-h-12 items-center rounded-lg bg-linear-to-b from-brand-700 to-brand-800 px-5 py-3 font-semibold text-white shadow-button after:absolute after:inset-0 hover:from-brand-800">Watch webinar<span class="sr-only">: {w.title}</span></a>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <CtaPanel
    id="briefing"
    variant="clouds"
    title="Request a 15-minute briefing"
    body="See how a growing group of prestigious programs are using Shepherd to exceed family expectations and lead the transition conversation."
    primary={{ label: 'Book a 15-min briefing', href: site.demo }}
  />
</Base>
