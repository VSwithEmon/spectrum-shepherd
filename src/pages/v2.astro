---
// Homepage V2 — the same updated homepage as V1 (client feedback, Oct 26, 2026), linking the V2 page set:
// the updated Teachers and Schools pages, and the v2 version of every other page (v1 where none exists).
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import LogoMarquee from '../components/v3/LogoMarquee.astro';
import Results from '../components/v3/Results.astro';
import AudienceRows from '../components/v3/AudienceRows.astro';
import Testimonial from '../components/v3/Testimonial.astro';
import DemoInvite from '../components/v3/DemoInvite.astro';
import { pagesV2 } from '../data/site';

// Approved proof points; no supporting sentences (client feedback).
const proof = [
  { icon: 'people' as const, value: 'Up to 10', label: 'hours back each week' },
  { icon: 'spark' as const, value: '82%', label: 'found learning more engaging' },
  { icon: 'progress' as const, value: '100%', label: 'of lesson performance tracked' },
];
---
<Base
  title="Spectrum Shepherd — personalized life skills curriculum for transition-age students"
  description="Spectrum Shepherd is a personalized life skills curriculum platform that helps transition-age neurodivergent students build real-world skills and independence, saves teachers time, and gives schools clear evidence of transition progress."
  demoHref="#demo"
  designToggle="v2"
  navUpdated
  pageSet="v2"
>
  <Hero v3 />
  <LogoMarquee />
  <Results items={proof} compactMobile />
  <AudienceRows v3 pages={pagesV2} />
  <Testimonial v3 />
  <DemoInvite />
</Base>
