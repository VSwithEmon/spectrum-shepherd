---
// Blog ("Perspectives") — Figma "Blog (Perspectives) — v2 · tabs" (Oct 27, 2026; nodes 39004:81809 /
// 39004:82055): sky hero with search, then "For educators" / "For families" tabs, each a grid of the
// shared PostCard (newest first; the separate "Latest" card was removed in Figma). Every card opens
// the post page (/blog/<slug>).
// Tabs: WAI-ARIA tabs (arrow keys, Home/End); the open tab is kept in the URL hash (#families). Without
// JavaScript both groups simply show one after the other. Search filters the open tab.
import Base from '../layouts/Base.astro';
import HeroHills from '../components/v3/HeroHills.astro';
import SkyDecor from '../components/v3/SkyDecor.astro';
import PostCard from '../components/v3/PostCard.astro';
import { getAllPosts } from '../lib/blog';

const posts = await getAllPosts();

const groups = [
  { id: 'educators', label: 'For educators', lede: 'Transition planning, IEP goals and measuring progress in the classroom.', posts: posts.filter((p) => p.group === 'educators') },
  { id: 'families', label: 'For families', lede: 'Stories and guides for parents navigating life after high school.', posts: posts.filter((p) => p.group === 'families') },
];
---
<Base
  title="Perspectives: special education transition resources | Spectrum Shepherd"
  description="Practical advice, heartfelt stories, and expert viewpoints on navigating the journey to independence for autistic young adults."
>
  <section class="relative overflow-hidden bg-linear-to-b from-cream via-haze via-10% to-mist" aria-labelledby="blog-title">
    <SkyDecor />
    <HeroHills class="absolute inset-x-0 bottom-0 h-[81px] sm:h-[140px] lg:h-auto" />
    <div class="relative z-10 mx-auto flex max-w-[900px] flex-col items-center gap-5 px-4 pt-12 pb-32 text-center md:px-8 lg:pt-[72px] lg:pb-[200px]">
      <p class="flex items-center gap-2 rounded-full border border-brand-200 bg-brand-50 px-3.5 py-1.5 text-sm font-semibold text-brand-800">
        <span aria-hidden="true" class="size-2 rounded-full bg-brand-600"></span>The Shepherd blog
      </p>
      <h1 id="blog-title" class="text-display-md font-bold sm:text-display-lg lg:text-display-xl">Welcome to <span class="text-brand-600">Perspectives</span></h1>
      <p class="max-w-[760px] text-lg font-medium text-muted sm:text-xl">Practical advice, heartfelt stories, and expert viewpoints on navigating the journey to independence for autistic young adults.</p>
      <div class="flex w-full flex-col items-center justify-center gap-3 pt-3 sm:flex-row">
        <p class="rounded-full bg-brand-700 px-[18px] py-2.5 text-sm font-semibold text-white">All posts</p>
        <form role="search" class="relative w-full sm:w-[320px]" id="blog-form">
          <label for="blog-search" class="sr-only">Search articles</label>
          <svg aria-hidden="true" class="absolute top-1/2 left-[18px] size-4 -translate-y-1/2 text-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><path d="M20 20l-3.5-3.5" /></svg>
          <input id="blog-search" type="search" placeholder="Search articles" autocomplete="off" class="min-h-11 w-full rounded-full border border-line bg-white pr-4 pl-11 text-sm placeholder:text-muted" />
        </form>
      </div>
      <p id="blog-status" class="sr-only" role="status"></p>
    </div>
  </section>

  <section class="bg-cream px-4 pt-12 pb-16 md:px-8 lg:pt-16 lg:pb-[96px]" aria-label="Articles">
    <div class="mx-auto flex max-w-[1200px] flex-col gap-10">
      <div role="tablist" aria-label="Who the articles are for" hidden data-tabs class="mx-auto flex gap-1.5 rounded-full border border-brand-50 bg-brand-25 p-1.5">
        {groups.map((g, i) => (
          <button
            type="button"
            role="tab"
            id={`tab-${g.id}`}
            aria-controls={`panel-${g.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            data-tab={g.id}
            class="min-h-12 rounded-full px-5 font-semibold text-ink transition-colors hover:text-brand-800 aria-selected:bg-white aria-selected:font-bold aria-selected:text-brand-800 aria-selected:shadow-md sm:px-8 sm:text-lg"
          >{g.label}</button>
        ))}
      </div>

      {groups.map((g) => (
        <div id={`panel-${g.id}`} role="tabpanel" aria-labelledby={`tab-${g.id}`} data-panel={g.id} class="flex flex-col gap-8 scroll-mt-28">
          <div class="flex flex-col gap-2">
            <h2 class="text-display-xs font-bold md:text-display-md">{g.label}</h2>
            <p class="text-lg text-muted">{g.lede}</p>
          </div>
          <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {g.posts.map((p) => <li class="flex"><PostCard post={p} class="w-full" /></li>)}
          </ul>
          <p data-empty hidden class="py-8 text-center text-lg font-medium text-muted">No articles match your search. Try a different word.</p>
        </div>
      ))}
    </div>
  </section>

</Base>

<script>
  const tablist = document.querySelector<HTMLElement>('[data-tabs]')!;
  const tabs = [...tablist.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
  const panels = [...document.querySelectorAll<HTMLElement>('[data-panel]')];
  const input = document.getElementById('blog-search') as HTMLInputElement;
  const status = document.getElementById('blog-status')!;

  const filter = () => {
    const q = input.value.trim().toLowerCase();
    const panel = panels.find((p) => !p.hidden)!;
    let shown = 0;
    panel.querySelectorAll<HTMLElement>('[data-post]').forEach((card) => {
      const hit = !q || (card.dataset.text ?? '').includes(q);
      card.parentElement!.hidden = !hit;
      if (hit) shown++;
    });
    panel.querySelector<HTMLElement>('[data-empty]')!.hidden = shown > 0;
    status.textContent = q ? `${shown} article${shown === 1 ? '' : 's'} found` : '';
  };

  const select = (id: string, focus = false) => {
    tabs.forEach((t) => {
      const on = t.dataset.tab === id;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      if (on && focus) t.focus();
    });
    panels.forEach((p) => { p.hidden = p.dataset.panel !== id; });
    history.replaceState(null, '', id === tabs[0].dataset.tab ? location.pathname : `#${id}`);
    filter();
  };

  tablist.hidden = false;
  const fromHash = tabs.find((t) => `#${t.dataset.tab}` === location.hash)?.dataset.tab;
  select(fromHash ?? tabs[0].dataset.tab!);

  tabs.forEach((t, i) => {
    t.addEventListener('click', () => select(t.dataset.tab!));
    t.addEventListener('keydown', (e) => {
      const next = { ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: tabs.length - 1 }[e.key];
      if (next === undefined) return;
      e.preventDefault();
      select(tabs[(next + tabs.length) % tabs.length].dataset.tab!, true);
    });
  });

  document.getElementById('blog-form')!.addEventListener('submit', (e) => e.preventDefault());
  input.addEventListener('input', filter);
</script>
