---
// Blog ("Perspectives") — Figma "Blog (Perspectives) — v2 · tabs (For educators selected)" (node 38892:15284,
// final design Oct 27, 2026): sky header with clouds and hills, "For educators" / "For families" tabs, card grid.
// Posts written in the Sanity Studio (/studio) come first and open on this site (/blog/<slug>); the articles
// that still live on spectrumshepherd.com follow (src/data/posts.ts). The search box filters the cards.
import Base from '../layouts/Base.astro';
import HeroHills from '../components/v3/HeroHills.astro';
import SkyDecor from '../components/v3/SkyDecor.astro';
import { posts as livePosts } from '../data/posts';
import { getPosts, imageUrl, shortDate, readTime } from '../lib/blog';

type Card = { key: string; title: string; excerpt: string; meta: string; url: string; thumb: string; alt: string; group: 'educators' | 'families' };

const cms = await getPosts();
const cmsCards: Card[] = cms.map((p) => ({
  key: p.slug, title: p.title, excerpt: p.excerpt, meta: `${shortDate(p.publishedAt)} · ${readTime(p.words)}`,
  url: `/blog/${p.slug}`, thumb: imageUrl(p.coverImage, 768, 572), alt: p.coverImage?.alt ?? '', group: p.audience ?? 'educators',
}));
const taken = new Set(cmsCards.map((c) => c.key));
const liveCards: Card[] = livePosts.filter((p) => !taken.has(p.slug)).map((p) => ({
  key: p.slug, title: p.title, excerpt: p.excerpt, meta: `${p.date} · ${p.read} read`, url: p.url, thumb: p.thumb, alt: '', group: p.group,
}));
const all = [...cmsCards, ...liveCards];
const tabs = [
  { id: 'educators', label: 'For educators', intro: 'Transition planning, IEP goals and measuring progress in the classroom.' },
  { id: 'families', label: 'For families', intro: 'Stories and guides for parents navigating life after high school.' },
] as const;
const text = (c: Card) => `${c.title} ${c.excerpt}`.toLowerCase();
---
<Base
  title="Perspectives: special education transition resources | Spectrum Shepherd"
  description="Practical advice, heartfelt stories, and expert viewpoints on navigating the journey to independence for autistic young adults."
>
  <section class="relative overflow-hidden bg-linear-to-b from-cream via-haze via-10% to-mist" aria-labelledby="blog-title">
    <SkyDecor />
    <HeroHills class="absolute inset-x-0 bottom-0 z-[1] h-[81px] sm:h-[140px] lg:h-[180px]" />
    <div class="relative z-10 mx-auto flex max-w-[900px] flex-col items-center gap-5 px-4 pt-12 pb-32 text-center md:px-8 lg:pt-[72px] lg:pb-[200px]">
      <p class="flex items-center gap-2 rounded-full border border-brand-200 bg-brand-50 px-3.5 py-1.5 text-sm font-semibold text-brand-800">
        <span aria-hidden="true" class="size-2 rounded-full bg-brand-600"></span>The Shepherd blog
      </p>
      <h1 id="blog-title" class="text-display-md font-bold sm:text-display-lg lg:text-display-xl">Welcome to <span class="text-brand-600">Perspectives</span></h1>
      <p class="max-w-[760px] text-lg font-medium text-muted sm:text-xl">Practical advice, heartfelt stories, and expert viewpoints on navigating the journey to independence for autistic young adults.</p>
      <div class="flex w-full flex-col items-center justify-center gap-3 pt-3 sm:flex-row">
        <p class="rounded-full bg-brand-700 px-[18px] py-2.5 text-sm font-semibold text-white">All posts</p>
        <form role="search" class="relative w-full sm:w-[320px]" id="blog-form">
          <label for="blog-search" class="sr-only">Search articles</label>
          <svg aria-hidden="true" class="absolute top-1/2 left-[18px] size-4 -translate-y-1/2 text-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><path d="M20 20l-3.5-3.5" /></svg>
          <input id="blog-search" type="search" placeholder="Search articles" autocomplete="off" class="min-h-11 w-full rounded-full border border-line bg-white pr-4 pl-11 text-sm placeholder:text-muted" />
        </form>
      </div>
      <p id="blog-status" class="sr-only" role="status"></p>
    </div>
  </section>

  <section class="bg-cream px-4 pt-12 pb-16 md:px-8 lg:pt-[72px] lg:pb-24" aria-label="Articles">
    <div class="mx-auto flex max-w-[1200px] flex-col gap-10">
      <div class="flex justify-center">
        <div role="tablist" aria-label="Articles for" class="flex gap-1.5 rounded-full border border-brand-50 bg-brand-25 p-1.5">
          {tabs.map((t, i) => (
            <button type="button" role="tab" id={`tab-${t.id}`} aria-controls={`panel-${t.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}
              class="min-h-11 rounded-full px-5 py-3 text-md font-semibold text-ink aria-selected:bg-white aria-selected:font-bold aria-selected:text-brand-800 aria-selected:shadow-[0_1px_2px_rgb(26_51_26/0.06),0_2px_8px_rgb(26_51_26/0.12)] sm:px-8 sm:py-3.5 sm:text-lg">
              {t.label}
            </button>
          ))}
        </div>
      </div>

      {tabs.map((t, i) => (
        <div role="tabpanel" id={`panel-${t.id}`} aria-labelledby={`tab-${t.id}`} data-panel class="flex flex-col gap-10" data-initial-hidden={i > 0 ? '' : undefined}>
          <div class="flex flex-col gap-2">
            <h2 class="text-display-sm font-bold md:text-display-md">{t.label}</h2>
            <p class="text-lg text-muted">{t.intro}</p>
          </div>
          <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {all.filter((c) => c.group === t.id).map((c) => (
              <li data-post data-text={text(c)} class="relative flex flex-col overflow-hidden rounded-[28px] border border-line bg-white focus-within:shadow-xl hover:shadow-xl lg:h-[560px]">
                <img src={c.thumb} width="768" height="572" loading="lazy" alt={c.alt} class="aspect-[384/286] w-full shrink-0 object-cover" />
                <div class="flex flex-1 flex-col gap-2.5 px-7 pt-6 pb-7">
                  <p class="text-sm font-medium text-muted">{c.meta}</p>
                  <h3 class="text-xl font-semibold"><a href={c.url} class="after:absolute after:inset-0 after:content-[''] focus-visible:outline-none">{c.title}</a></h3>
                  <p class="text-muted">{c.excerpt}</p>
                  <p aria-hidden="true" class="mt-auto pt-2 text-sm font-semibold text-brand-700">Read article →</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      ))}
      <p id="blog-empty" hidden class="py-8 text-center text-lg font-medium text-muted">No articles match your search. Try a different word.</p>
    </div>
  </section>
</Base>

<script>
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[role=tab]')];
  const panels = [...document.querySelectorAll<HTMLElement>('[data-panel]')];
  const items = [...document.querySelectorAll<HTMLElement>('[data-post]')];
  const input = document.getElementById('blog-search') as HTMLInputElement;
  const status = document.getElementById('blog-status')!;
  const empty = document.getElementById('blog-empty')!;
  let current = 0;
  // Without JavaScript both lists show; with it, the tabs switch between them.
  const show = (i: number) => {
    current = i;
    tabs.forEach((t, k) => { t.setAttribute('aria-selected', String(k === i)); t.tabIndex = k === i ? 0 : -1; });
    filter();
  };
  const filter = () => {
    const q = input.value.trim().toLowerCase();
    let shown = 0;
    items.forEach((el) => { const hit = !q || (el.dataset.text ?? '').includes(q); el.hidden = !hit; });
    panels.forEach((p, k) => {
      const hits = p.querySelectorAll('[data-post]:not([hidden])').length;
      // While searching, every list with a match shows; otherwise only the selected tab.
      p.hidden = q ? hits === 0 : k !== current;
      if (!p.hidden) shown += hits;
    });
    empty.hidden = shown > 0;
    status.textContent = q ? `${shown} article${shown === 1 ? '' : 's'} found` : '';
  };
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => { input.value = ''; show(i); });
    t.addEventListener('keydown', (e) => {
      const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (!d) return;
      const n = (i + d + tabs.length) % tabs.length;
      tabs[n].focus(); tabs[n].click();
    });
  });
  document.getElementById('blog-form')!.addEventListener('submit', (e) => e.preventDefault());
  input.addEventListener('input', filter);
  show(0);
</script>
