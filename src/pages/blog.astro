---
// Blog ("Perspectives") v1 — Figma "Blog (Perspectives) — v3 (short header)" (Oct 2026; node 38880:82869),
// linked from the lavender homepage (V2). Posts as listed on spectrumshepherd.com/blog; the articles still
// live there. The search box filters the list in the browser (small vanilla script).
import Base from '../layouts/Base.astro';
import DownloadBanner from '../components/v3/DownloadBanner.astro';
import { posts } from '../data/posts';

const [featured, ...rest] = posts;
const educators = rest.filter((p) => p.group === 'educators');
const families = rest.filter((p) => p.group === 'families');
const text = (p: (typeof posts)[number]) => `${p.title} ${p.excerpt}`.toLowerCase();
---
<Base
  title="Perspectives — special education transition resources — Spectrum Shepherd"
  description="Practical advice, heartfelt stories, and expert viewpoints on navigating the journey to independence for autistic young adults."
>
  <section class="bg-cream px-4 pt-12 pb-8 md:px-8 lg:pt-14" aria-labelledby="blog-title">
    <div class="mx-auto flex max-w-[1200px] flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
      <div class="flex max-w-[680px] flex-col items-start gap-3">
        <p class="flex items-center gap-2 rounded-full border border-brand-200 bg-brand-50 px-3.5 py-1.5 text-sm font-semibold text-brand-800">
          <span aria-hidden="true" class="size-2 rounded-full bg-brand-600"></span>The Shepherd blog
        </p>
        <h1 id="blog-title" class="text-display-md font-bold sm:text-display-lg">Welcome to <span class="text-brand-600">Perspectives</span></h1>
        <p class="text-lg text-muted sm:text-xl">Practical advice, heartfelt stories, and expert viewpoints on navigating the journey to independence for autistic young adults.</p>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
        <p class="self-start rounded-full bg-brand-700 px-[18px] py-2.5 font-semibold text-white">All posts</p>
        <form role="search" class="relative w-full sm:w-[320px]" id="blog-form">
          <label for="blog-search" class="sr-only">Search articles</label>
          <svg aria-hidden="true" class="absolute top-1/2 left-4 size-5 -translate-y-1/2 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><path d="M20 20l-3.5-3.5" /></svg>
          <input id="blog-search" type="search" placeholder="Search articles" autocomplete="off" class="min-h-12 w-full rounded-full border-[1.5px] border-line-strong bg-white pr-4 pl-11 text-md placeholder:text-muted" />
        </form>
      </div>
    </div>
    <p id="blog-status" class="sr-only" role="status"></p>
  </section>

  <section class="bg-cream px-4 pb-6 md:px-8" aria-label="Latest article">
    <article data-post data-text={text(featured)} class="relative mx-auto grid max-w-[1200px] items-center overflow-hidden rounded-[32px] border border-line bg-white shadow-xl lg:grid-cols-[600px_1fr] lg:gap-14 lg:pr-14">
      <img src={featured.thumb} width="800" height="600" alt="" class="aspect-[4/3] w-full object-cover lg:h-[446px] lg:aspect-auto" />
      <div class="flex flex-col items-start gap-4 p-6 sm:p-10 lg:p-0">
        <span class="rounded-full bg-yellow-300 px-3 py-1 text-sm font-bold lavender:bg-lavender-200">Latest</span>
        <p class="text-sm font-medium text-muted">{featured.date} · {featured.read} read</p>
        <h2 class="text-display-xs font-bold sm:text-display-sm"><a href={featured.url} class="after:absolute after:inset-0">{featured.title}</a></h2>
        <p class="text-lg text-muted">{featured.excerpt}</p>
        <p class="font-semibold text-brand-700">Read article →</p>
      </div>
    </article>
  </section>

  <section data-group class="bg-cream px-4 py-16 md:px-8 lg:py-[72px]" aria-labelledby="educators-title">
    <div class="mx-auto flex max-w-[1200px] flex-col gap-8">
      <div class="flex flex-col gap-2">
        <h2 id="educators-title" class="text-display-xs font-bold md:text-display-md">For educators</h2>
        <p class="text-lg text-muted">Transition planning, IEP goals and measuring progress in the classroom.</p>
      </div>
      <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {educators.map((p) => (
          <li data-post data-text={text(p)} class="relative flex flex-col overflow-hidden rounded-[28px] border border-line bg-white">
            <img src={p.thumb} width="800" height="600" loading="lazy" alt="" class="aspect-[384/286] w-full object-cover" />
            <div class="flex flex-1 flex-col gap-2.5 p-6 pb-7">
              <p class="text-sm font-medium text-muted">{p.date} · {p.read} read</p>
              <h3 class="text-xl font-semibold"><a href={p.url} class="after:absolute after:inset-0">{p.title}</a></h3>
              <p class="text-muted">{p.excerpt}</p>
              <p class="mt-auto pt-2 font-semibold text-brand-700">Read article →</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section data-group class="bg-haze px-4 py-16 md:px-8 lg:py-[72px]" aria-labelledby="families-title">
    <div class="mx-auto flex max-w-[1200px] flex-col gap-8">
      <div class="flex flex-col gap-2">
        <h2 id="families-title" class="text-display-xs font-bold md:text-display-md">For families</h2>
        <p class="text-lg text-muted">Stories and guides for parents navigating life after high school.</p>
      </div>
      <ul class="grid gap-6 lg:grid-cols-2">
        {families.map((p) => (
          <li data-post data-text={text(p)} class="relative flex flex-col items-center gap-5 rounded-3xl bg-white p-4 sm:flex-row sm:pr-6">
            <img src={p.thumb} width="580" height="432" loading="lazy" alt="" class="aspect-[4/3] w-full shrink-0 rounded-2xl object-cover sm:w-[200px]" />
            <div class="flex flex-col gap-2">
              <p class="text-sm font-medium text-muted">{p.date} · {p.read} read</p>
              <h3 class="text-lg font-semibold"><a href={p.url} class="after:absolute after:inset-0">{p.title}</a></h3>
              <p class="text-sm text-muted">{p.excerpt}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <p id="blog-empty" hidden class="bg-cream px-4 py-16 text-center text-lg font-medium text-muted">No articles match your search. Try a different word.</p>

  <DownloadBanner />
</Base>

<script>
  const input = document.getElementById('blog-search') as HTMLInputElement;
  const items = [...document.querySelectorAll<HTMLElement>('[data-post]')];
  const groups = [...document.querySelectorAll<HTMLElement>('[data-group]')];
  const status = document.getElementById('blog-status')!;
  const empty = document.getElementById('blog-empty')!;
  document.getElementById('blog-form')!.addEventListener('submit', (e) => e.preventDefault());
  input.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    let shown = 0;
    items.forEach((el) => {
      const hit = !q || (el.dataset.text ?? '').includes(q);
      el.hidden = !hit;
      if (hit) shown++;
    });
    groups.forEach((g) => { g.hidden = !g.querySelector('[data-post]:not([hidden])'); });
    empty.hidden = shown > 0;
    status.textContent = q ? `${shown} article${shown === 1 ? '' : 's'} found` : '';
  });
</script>
